def nearest_airport(db, lat, lon, max_km):
    """Code de l'aéroport le plus proche à moins de max_km (ou None)."""
    import math
    best, best_d = None, max_km
    dlat = max_km / 111.0
    coslat = max(0.05, math.cos(math.radians(lat)))
    for code, rec in db.items():
        if abs(rec["lat"] - lat) > dlat or len(code) not in (3, 4):
            continue
        dx = (rec["lon"] - lon) * 111.0 * coslat
        if abs(dx) > max_km:
            continue
        d = math.hypot((rec["lat"] - lat) * 111.0, dx)
        if d < best_d and rec.get("type") in ("large_airport", "medium_airport", "small_airport", "heliport",
                                                "seaplane_base"):
            best, best_d = code, d
    return best


def split_procs(text):
    """« A.exe; B.exe » -> ["A.exe", "B.exe"]"""
    return [x.strip() for x in re.split(r"[;,]", text or "") if x.strip()]


def is_admin():
    try:
        return bool(ctypes.windll.shell32.IsUserAnAdmin())
    except Exception:  # noqa
        return False


def shell_runas_code(program, params="", cwd=None, show=1):
    """Lance un programme en administrateur (confirmation Windows UAC). Code Windows : > 32 = lancé."""
    try:
        ctypes.windll.ole32.CoInitializeEx(None, 0x2)  # recommandé par Windows avant ShellExecute
    except Exception:  # noqa
        pass
    try:
        return int(ctypes.windll.shell32.ShellExecuteW(None, "runas", program, params, cwd, show))
    except Exception:  # noqa
        return 0


def shell_runas(program, params="", cwd=None, show=1):
    return shell_runas_code(program, params, cwd, show) > 32


def runas_error(code):
    if code == 5:
        return "confirmation Windows refusée ou restée sans réponse"
    if code in (2, 3):
        return "programme introuvable"
    return "erreur Windows (code %d)" % code


