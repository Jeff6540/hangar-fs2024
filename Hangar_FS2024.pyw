    # ---- verrouillage quand le simulateur tourne
    def _lk(self, w):
        self._lock_widgets.append(w)
        if self.sim_on:
            w.state(["disabled"])
        return w

    def _apply_lock(self, on):
        on = bool(on)
        if on == self.sim_on:
            return
        self.sim_on = on
        for w in list(self._lock_widgets):
            try:
                w.state(["disabled"] if on else ["!disabled"])
            except tk.TclError:  # fenêtre fermée
                self._lock_widgets.remove(w)
        self._update_undo_btn()
        if on:
            self.lock_banner.pack(fill="x", before=self.nb)
            self.set_status("Simulateur ouvert : actions verrouillées.")
        else:
            self.lock_banner.pack_forget()
            self.set_status("Simulateur fermé : l'appli est de nouveau utilisable.")

    def _sim_locked(self):
        """Vérification en direct avant toute modification."""
        if sim_running(self.cfg["sim_exe"]):
            self._apply_lock(True)
            messagebox.showwarning(APP, "Flight Simulator est ouvert.\n\nFerme-le avant de modifier tes "
                                        "add-ons : il ne lit le dossier Community qu'au démarrage, et changer "
                                        "les liens pendant qu'il tourne peut le perturber.")
            return True
        return False

