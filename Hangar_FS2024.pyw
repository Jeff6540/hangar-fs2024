def pid_on_port(port):
    """PID du programme qui écoute sur ce port local (Windows), ou None."""
    if not IS_WIN:
        return None
    try:
        r = subprocess.run(["netstat", "-ano", "-p", "TCP"], capture_output=True, encoding=CON_ENC,
                           errors="replace", creationflags=NO_WINDOW, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    for line in (r.stdout or "").splitlines():
        parts = line.split()
        if len(parts) >= 5 and parts[1].endswith(":%d" % port) and parts[2] in ("0.0.0.0:0", "[::]:0"):
            try:
                return int(parts[-1])
            except ValueError:
                continue
    return None


def process_name(pid):
    try:
        r = subprocess.run(["tasklist", "/FI", "PID eq %d" % pid, "/FO", "CSV", "/NH"], capture_output=True,
                           encoding=CON_ENC, errors="replace", creationflags=NO_WINDOW, timeout=10)
        line = (r.stdout or "").strip().splitlines()
        return line[0].split('","')[0].strip('"') if line and line[0].startswith('"') else "programme inconnu"
    except (OSError, subprocess.SubprocessError):
        return "programme inconnu"


def find_dispatch_file(saved="", extra_dirs=()):
    """Fichier Avionics Dispatch : celui des réglages, sinon le plus récent à côté de l'appli, sur le Bureau,
    dans Documents ou Téléchargements."""
    if saved and os.path.isfile(saved):
        return saved
    home = os.path.expanduser("~")
    dirs = [APP_DIR, BASE_DIR] + [d for d in extra_dirs if d] + [
            os.path.join(home, "OneDrive", "Desktop"), os.path.join(home, "Desktop"),
            os.path.join(home, "OneDrive", "Bureau"), os.path.join(home, "Bureau"),
            os.path.join(home, "OneDrive", "Documents"), os.path.join(home, "Documents"),
            os.path.join(home, "Downloads"), os.path.join(home, "Téléchargements")]
    found = []
    for d in dirs:
        try:
            for name in os.listdir(d):
                if name.lower().startswith("avionics_dispatch") and name.lower().endswith(".html"):
                    full = os.path.join(d, name)
                    found.append((os.path.getmtime(full), full))
        except OSError:
            continue
    return max(found)[1] if found else ""


