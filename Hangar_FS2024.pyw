}
html,body{font-family:var(--al-ui)!important}
body{background:radial-gradient(1400px 600px at 50% -200px,#1b2a44 0%,transparent 65%),var(--al-bg)!important;color:var(--al-text)!important}

/* En-tête : ciel de nuit de Hangar FS 2024 */
html body header.avionics-panel{
  background:#0f1724 url(/bg_dispatch.svg) center bottom/cover no-repeat!important;
