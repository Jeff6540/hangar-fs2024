:focus-visible{outline:2px solid var(--al-blue-hi)!important;outline-offset:2px!important;box-shadow:none!important}

/* Alertes : bandeau doux au lieu des pointillés */
html body #mainFeasibilityAlert,html body #feasibilityBanner,html body .bg-cockpit-amber\/10,html body .bg-cockpit-amber\/20{
