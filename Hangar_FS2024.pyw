</style>"""


# Suivi du vol (phase, OUT/OFF/ON/IN, instruments) et carte « Plan & suivi de vol » de la page principale
DISPATCH_FLIGHT_JS = r"""<script>
/* Hangar FS 2024 : suivi du vol (phase, OUT/OFF/ON/IN, instruments) dans Plan & suivi de vol,
   carte « Plan & suivi de vol » sur la page principale. Ajouté par-dessus la page sans toucher à sa logique. */
(function () {
  var RELAY = 'http://localhost:8765';
  var KEY = 'al_flight_v1', KEY_FOLD = 'al_flight_fold';
  var PH = ['', 'Embarquement', 'Démarrage moteurs', 'Repoussage', 'Roulage départ', 'Décollage', 'Montée',
            'Croisière', 'Descente', 'Approche', 'Finale', 'Atterrissage', 'Roulage arrivée', 'Au parking', 'Débarquement'];
  var st = load(), live = { relay: false, connected: false, user: null, flight: null }, plan = null, lastSave = 0;

  function load() { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; } }
  function save(force) { var n = Date.now(); if (!force && n - lastSave < 5000) return; lastSave = n; try { localStorage.setItem(KEY, JSON.stringify(st)); } catch (e) {} }
  function reset(phase) { st = { phase: phase || 0, maxAlt: 0 }; save(true); }
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function nm(a, b, c, d) {
    var r = Math.PI / 180, x = Math.sin((c - a) * r / 2), y = Math.sin((d - b) * r / 2);
    var h = x * x + Math.cos(a * r) * Math.cos(c * r) * y * y; return 3440.065 * 2 * Math.asin(Math.min(1, Math.sqrt(h)));
  }
  function zt(ms) { if (!ms) return '--:--'; var d = new Date(ms); return String(d.getUTCHours()).padStart(2, '0') + ':' + String(d.getUTCMinutes()).padStart(2, '0') + 'Z'; }
  function fmt(n) { return Number.isFinite(n) ? Math.round(n).toLocaleString('fr-FR') : '—'; }

  /* ---------- plan de vol : SimBrief (importé dans la page ou récupéré via le relais) ---------- */
  function takePlan(data) {
    try {
      var o = data.origin || {}, d = data.destination || {}, g = data.general || {}, ac = data.aircraft || {}, atc = data.atc || {};
      var p = { dep: (o.icao_code || '').toUpperCase(), arr: (d.icao_code || '').toUpperCase(),
        depLat: parseFloat(o.pos_lat), depLon: parseFloat(o.pos_long), arrLat: parseFloat(d.pos_lat), arrLon: parseFloat(d.pos_long),
        type: ac.icaocode || '', callsign: atc.callsign || [g.icao_airline, g.flight_number].filter(Boolean).join(''),
        cruise: parseInt(g.initial_altitude, 10) || 0 };
      if (p.dep && p.arr && Number.isFinite(p.arrLat)) {
        plan = p;
        window.alPlanData = { tlr: data.tlr || null, origin: o, destination: d, aircraft: ac };
        /* aéroports du vol (départ, arrivée, dégagements) : servent au chargement anticipé des plans d'aéroport */
        var apts = [[p.depLat, p.depLon], [p.arrLat, p.arrLon]];
        [].concat(data.alternate || []).forEach(function (a) { if (a) apts.push([parseFloat(a.pos_lat), parseFloat(a.pos_long)]); });
        window.alFlightAirports = apts.filter(function (x) { return Number.isFinite(x[0]) && Number.isFinite(x[1]); });
        try { window.dispatchEvent(new Event('al-plan')); } catch (e) {}
      }
    } catch (e) {}
  }
  var wrapTries = 0, wrapTimer = setInterval(function () {
    if (typeof window.drawSimbriefPlan === 'function' && !window.drawSimbriefPlan.__al) {
      var orig = window.drawSimbriefPlan;
      window.drawSimbriefPlan = function (data) { takePlan(data); return orig.apply(this, arguments); };
      window.drawSimbriefPlan.__al = true; clearInterval(wrapTimer);
