def _com_shell_link():
    """IShellLinkW + IPersistFile par COM (ctypes) : créer ou lire un raccourci .lnk sans PowerShell."""
    ole32 = ctypes.windll.ole32
    ole32.CoInitialize(None)

    class GUID(ctypes.Structure):
        _fields_ = [("d1", ctypes.c_ulong), ("d2", ctypes.c_ushort), ("d3", ctypes.c_ushort),
                    ("d4", ctypes.c_ubyte * 8)]

    def guid(txt):
        g = GUID()
        if ole32.CLSIDFromString(ctypes.c_wchar_p(txt), ctypes.byref(g)) != 0:
            raise OSError("GUID")
        return g
    link = ctypes.c_void_p()
    hr = ole32.CoCreateInstance(ctypes.byref(guid("{00021401-0000-0000-C000-000000000046}")), None, 1,
                                ctypes.byref(guid("{000214F9-0000-0000-C000-000000000046}")), ctypes.byref(link))
    if hr != 0 or not link:
        raise OSError("ShellLink indisponible (0x%08X)" % (hr & 0xFFFFFFFF))

    def method(obj, idx, *argtypes):
        vtbl = ctypes.cast(obj, ctypes.POINTER(ctypes.POINTER(ctypes.c_void_p))).contents
        fn = ctypes.WINFUNCTYPE(ctypes.c_long, ctypes.c_void_p, *argtypes)(vtbl[idx])
        return lambda *a: fn(obj, *a)
    pf = ctypes.c_void_p()
    if method(link, 0, ctypes.POINTER(GUID), ctypes.POINTER(ctypes.c_void_p))(
            ctypes.byref(guid("{0000010B-0000-0000-C000-000000000046}")), ctypes.byref(pf)) != 0 or not pf:
        method(link, 2)()
        raise OSError("IPersistFile indisponible")
    return link, pf, method


def write_shortcut(lnk, target, args, workdir, icon, description):
    link, pf, m = _com_shell_link()
    try:
        m(link, 20, ctypes.c_wchar_p)(target)                    # SetPath
        m(link, 11, ctypes.c_wchar_p)(args)                      # SetArguments
        m(link, 9, ctypes.c_wchar_p)(workdir)                    # SetWorkingDirectory
        m(link, 7, ctypes.c_wchar_p)(description)                # SetDescription
        if icon:
            m(link, 17, ctypes.c_wchar_p, ctypes.c_int)(icon, 0)  # SetIconLocation
        hr = m(pf, 6, ctypes.c_wchar_p, ctypes.c_int)(lnk, 1)    # IPersistFile::Save
        if hr != 0:
            raise OSError("enregistrement du raccourci impossible (0x%08X)" % (hr & 0xFFFFFFFF))
    finally:
        m(pf, 2)()
        m(link, 2)()


def read_shortcut(lnk):
    link, pf, m = _com_shell_link()
    try:
        if m(pf, 5, ctypes.c_wchar_p, ctypes.c_ulong)(lnk, 0) != 0:   # IPersistFile::Load
            return "", "", ""
        out = []
        for idx, extra in ((3, True), (10, False), (8, False)):       # GetPath, GetArguments, GetWorkingDirectory
            buf = ctypes.create_unicode_buffer(2048)
            if extra:
                m(link, idx, ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_ulong)(
                    ctypes.cast(buf, ctypes.c_void_p), 2048, None, 0)
            else:
                m(link, idx, ctypes.c_void_p, ctypes.c_int)(ctypes.cast(buf, ctypes.c_void_p), 2048)
            out.append(buf.value.strip())
        return tuple(out)
    finally:
        m(pf, 2)()
        m(link, 2)()


def set_start_with_windows(on):
    """Ajoute ou retire le raccourci de Hangar FS 2024 dans le dossier Démarrage de Windows."""
    lnk = startup_shortcut()
    if not on:
        try:
            os.remove(lnk)
        except FileNotFoundError:
            pass
        except OSError:
            return False
        return True
    if not IS_WIN:
        return False
    exe, args, wd = launch_command()
    try:
        os.makedirs(os.path.dirname(lnk), exist_ok=True)
        write_shortcut(lnk, exe, args.strip(), wd, ensure_icon_file(), "Hangar FS 2024")
    except (OSError, AttributeError, ValueError):
        return False
    return os.path.isfile(lnk)


