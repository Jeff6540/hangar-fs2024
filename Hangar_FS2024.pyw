  function windRows(icao, mt) {
    return runwaysOf(icao).map(function (r) { var c = comps(r.hdg, mt); return c ? { name: r.name, len: r.len, c: c } : null; })
      .filter(Boolean).sort(function (a, b) { return (b.c.head - a.c.head) || (b.len - a.len); });
  }
  function windTxt(c) {
    if (!c) return '';
