    def open_map(self):
        if self.airports is None:
            self._load_airports(then=self.open_map)
            return
        if self._dup_streamed is None:
            folder = self.cfg.get("streamed") or ""
            if not os.path.isdir(folder):
                folder = detect_streamed(self.cfg["community"])
            if folder:
                def done(res, err):
                    if not err:
                        self._dup_streamed = res
                        self._dup_time = time.strftime("%d/%m/%Y %H:%M:%S")
                        self._push_map()
                self.run_bg(lambda: scan_streamed(folder), done)
        self._push_map(force=True)
        port = self._start_map_server()
        hwnd = find_window(MAP_TITLE)
        if hwnd and port in MAP_PORTS and focus_window(hwnd):
            self.set_status("Carte ramenée au premier plan.")
            return
        if open_app_window("http://127.0.0.1:%d/" % port, monitor=self.screen_for("map")):
            self.set_status("Carte ouverte dans sa propre fenêtre.")
            self._place_web_later(MAP_WINDOW_TITLE, "map", 15)
        else:
            self.set_status("Carte ouverte dans ton navigateur.")

    # ---- doublons ICAO et scènes par défaut de MSFS 2024
    def _default_off(self):
        return self.st.setdefault("default_off", {})

    def _prune_default_off(self):
        comm = self.cfg["community"]
        d = self._default_off()
        for name in list(d):
            if not comm or not os.path.isdir(os.path.join(comm, name)):
                d.pop(name, None)

    def airport_icaos(self, p):
        """Codes OACI d'un add-on s'il s'agit bien d'une scène d'aéroport (pas un pack saisons, maillage…)."""
        if p.get("type") not in ("SCENERY", ""):
            return []
        manual = "icao" in self.cfg["overrides"].get(p["path"], {})
        if manual:
            return list(p["icao"])
        text = (p["name"] + " " + p.get("title", "")).lower()
        if len(p["icao"]) > 6 and not any(w in text for w in AIRPORT_WORDS):
            return []
        if is_decor_pack(text):        # POI, lifts, pylônes, saisons… : pas une scène d'aéroport
            return []
        if not self.airports or not p["icao"]:
            return list(p["icao"])
        key = (p["path"], tuple(p["icao"]))
        if key not in self._icao_cache:
            self._icao_cache[key] = resolve_codes(p["icao"], p["name"] + " " + p.get("title", ""),
                                                  self.airports, self._city_idx)
        return list(self._icao_cache[key])

    def disable_defaults(self, names):
        if self._sim_locked():
            return False
        if not self._check_comm():
            return False
        already = [n for n in names if n in self._default_off()]
        names = [n for n in names if n not in self._default_off()]
        if not names:
            # déjà désactivée(s) dans Community : on peut encore la/les désactiver dans My Library
            if already and self._confirm_content_xml():
                self._library_state(already, True)
                self.set_status("Scène(s) déjà désactivée(s) : My Library de MSFS mis à jour.")
            return False
        if not messagebox.askyesno(
                APP, "Désactiver %d scène(s) par défaut de MSFS 2024 ?\n\n%s\n\nUn dossier vide portant le nom "
                     "du paquet est créé dans Community : le simulateur considère alors la scène par défaut comme "
                     "remplacée. C'est réversible à tout moment avec « Réactiver la scène par défaut »."
                     % (len(names), "\n".join("• " + n for n in names[:8]) + ("\n…" if len(names) > 8 else ""))):
            return False
        if not self._confirm_content_xml():
            return False
        comm = self.cfg["community"]
        done = 0
        for n in names:
            path = os.path.join(comm, n)
            if os.path.lexists(path):
                self.log("Impossible de désactiver %s : un dossier ou lien du même nom existe déjà dans Community." % n)
                continue
            try:
                os.mkdir(path)
            except OSError as e:
                self.log("Impossible de désactiver %s : %s" % (n, e))
                continue
            self._default_off()[n] = {"date": time.strftime("%d/%m/%Y %H:%M"), "icao": streamed_icao(n)}
            done += 1
            self.log("Scène par défaut désactivée : %s" % n)
        self._library_state([n for n in names if n in self._default_off()], True)
        self.save_st()
        self.refresh_library()
        self.set_status("%d scène(s) par défaut désactivée(s)." % done)
        return True

    def _content_backup_folder(self):
        return self.cfg.get("content_backup_dir") or default_content_backup_dir()

    def _confirm_content_xml(self):
        """Avant de modifier Content.xml : si la sauvegarde initiale existe déjà, on continue sans rien demander.
        Sinon (première fois), on explique ce qui va être fait et on propose de la créer."""
        path = find_content_xml(self.cfg.get("community", ""))
        if not path:
            return True     # pas de fichier : seul le dossier vide dans Community sera utilisé
        folder = {"v": self._content_backup_folder()}
        if os.path.isfile(content_initial_backup(folder["v"])) or self.cfg.get("content_ok"):
            self.cfg["content_used"] = True
            return True
        win = tk.Toplevel(self)
        win.title("Avant de continuer — fichier Content.xml de MSFS 2024")
        win.configure(bg=C["bg"])
        win.transient(self)
        win.resizable(False, False)
        fr = ttk.Frame(win, padding=18)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text="Avant de continuer", style="Head.TLabel").pack(anchor="w")

        def para(title, text):
            ttk.Label(fr, text=title, font=(UI_FONT, 10, "bold")).pack(anchor="w", pady=(12, 2))
            lab = ttk.Label(fr, text=text, wraplength=660, justify="left")
            lab.pack(anchor="w")
            return lab
        para("Ce que fait Hangar FS 2024",
             "Pour que la scène soit aussi désactivée dans My Library de MSFS, l'appli modifie le fichier "
             "Content.xml de MSFS 2024. Elle change uniquement la ligne de la scène choisie, de « activée » à "
             "« désactivée » : exactement comme décocher la case dans My Library.")
        para("Ce qu'elle ne fait pas",
             "Elle ne supprime aucun fichier, ne touche à aucun autre contenu et n'envoie rien sur internet. "
             "Elle ne fait rien pendant que MSFS tourne.")
        para("Où se trouve le fichier", path)
        lab_dest = para("Sauvegarde initiale (conseillée, faite une seule fois)",
                        content_initial_backup(folder["v"]))
        ttk.Label(fr, text="Elle n'est jamais écrasée. En cas de souci, le bouton « Restaurer Content.xml… » de la "
                           "fenêtre Doublons ICAO la remet en place.", style="Muted.TLabel",
                  wraplength=660, justify="left").pack(anchor="w", pady=(4, 0))
        info = ttk.Label(fr, text="", style="Muted.TLabel", wraplength=660, justify="left")
        info.pack(anchor="w", pady=(6, 0))
        var_hide = tk.BooleanVar(value=False)
        ttk.Checkbutton(fr, text="Ne plus proposer de sauvegarde", variable=var_hide).pack(anchor="w", pady=(10, 0))
        result = {"ok": False}

        def change():
            d = filedialog.askdirectory(parent=win, title=T("Où ranger la sauvegarde de Content.xml ?"),
                                        initialdir=os.path.dirname(folder["v"]) if os.path.isdir(
                                            os.path.dirname(folder["v"])) else desktop_dir())
            if d:
                folder["v"] = os.path.normpath(d)
                lab_dest.config(text=content_initial_backup(folder["v"]))
                if os.path.isfile(content_initial_backup(folder["v"])):
                    info.config(text=T("Une sauvegarde existe déjà à cet endroit : elle sera gardée telle quelle."))
                else:
                    info.config(text="")

        def finish(with_backup):
            if with_backup:
                try:
                    dest = content_make_initial(path, folder["v"])
                except OSError as e:
                    info.config(text=T("Sauvegarde impossible : %s") % e)
                    return
                self.log("Sauvegarde initiale de Content.xml : %s" % dest)
            self.cfg["content_backup_dir"] = folder["v"]
            self.cfg["content_used"] = True
            if var_hide.get():
                self.cfg["content_ok"] = True
            self.save_cfg()
            result["ok"] = True
            win.destroy()

        btns = ttk.Frame(fr)
        btns.pack(fill="x", pady=(16, 0))
        ttk.Button(btns, text="📁  Changer l'emplacement…", command=change).pack(side="left")
        ttk.Button(btns, text="Annuler", command=win.destroy).pack(side="right")
        ttk.Button(btns, text="Continuer sans sauvegarde", command=lambda: finish(False)).pack(side="right", padx=6)
        ttk.Button(btns, text="💾  Sauvegarder et continuer", style="Accent.TButton",
                   command=lambda: finish(True)).pack(side="right")
        make_flow_rows(btns)
        self._place_win(win)
        win.grab_set()
        self.wait_window(win)
        if not result["ok"]:
            self.set_status("Désactivation annulée : rien n'a été modifié.")
        return result["ok"]

    def restore_content_xml(self, parent=None):
        """Remet une sauvegarde de Content.xml (simulateur fermé, après confirmation), en gardant d'abord
        une copie du fichier actuel. Jamais automatique."""
        parent = parent or self
        path = find_content_xml(self.cfg.get("community", ""))
        if not path:
            messagebox.showinfo(APP, "Fichier Content.xml de MSFS 2024 introuvable.", parent=parent)
            return
        if self._sim_locked():
            return
        folder = self._content_backup_folder()
        backs = content_backups(path, folder)
        if not backs:
            messagebox.showinfo(APP, "Aucune sauvegarde de Content.xml n'a été trouvée.", parent=parent)
            return
        win = tk.Toplevel(parent)
        win.title("Restaurer Content.xml")
        win.configure(bg=C["bg"])
        win.transient(parent)
        fr = ttk.Frame(win, padding=16)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text="Choisis la sauvegarde à remettre en place :", style="Head.TLabel").pack(anchor="w")
        ttk.Label(fr, text=T("Fichier de MSFS : %s") % path, style="Muted.TLabel",
                  wraplength=720, justify="left").pack(anchor="w", pady=(4, 8))
        tv = ttk.Treeview(fr, columns=("date", "type", "file"), show="headings", height=8, selectmode="browse")
        for c, t, w in (("date", "Date", 140), ("type", "Sauvegarde", 140), ("file", "Fichier", 460)):
            tv.heading(c, text=t, anchor="w")
            tv.column(c, width=w, anchor="w", stretch=(c == "file"))
        for i, (mt, fp, kind) in enumerate(backs):
            tv.insert("", "end", iid=str(i), values=(time.strftime("%d/%m/%Y %H:%M", time.localtime(mt)),
                                                     T(kind), fp))
        tv.selection_set("0")
        tv.pack(fill="both", expand=True)
        ttk.Label(fr, text=T("Le fichier actuel est d'abord copié dans %s : tu peux revenir en arrière.") % folder,
                  style="Muted.TLabel", wraplength=720, justify="left").pack(anchor="w", pady=(8, 0))

        def do():
            sel = tv.selection()
            if not sel or self._sim_locked():
                return
            src = backs[int(sel[0])][1]
            if not messagebox.askyesno(APP, T("Remettre cette sauvegarde à la place du fichier de MSFS ?\n\n%s") % src,
                                       parent=win):
                return
            try:
                os.makedirs(folder, exist_ok=True)
                keep = os.path.join(folder, "Content_avant_restauration_%s.xml" % time.strftime("%Y%m%d_%H%M%S"))
                shutil.copy2(path, keep)
                tmp = path + ".hangar_tmp"
                shutil.copy2(src, tmp)
                os.replace(tmp, path)
            except OSError as e:
                messagebox.showerror(APP, T("Restauration impossible : %s") % e, parent=win)
                return
            # la sauvegarde remise fait foi : l'appli ne redésactive plus rien toute seule au démarrage
            self.cfg["content_used"] = False
            self.save_cfg()
            self.log("Content.xml restauré depuis %s (ancien fichier gardé : %s)" % (src, keep))
            win.destroy()
            messagebox.showinfo(APP, "Content.xml a été remis en place. Les changements seront pris en compte "
                                     "au prochain démarrage de MSFS.", parent=parent)

        btns = ttk.Frame(fr)
        btns.pack(fill="x", pady=(12, 0))
        ttk.Button(btns, text="📂  Ouvrir le dossier des sauvegardes",
                   command=lambda: (os.makedirs(folder, exist_ok=True), open_folder(folder))).pack(side="left")
        ttk.Button(btns, text="Annuler", command=win.destroy).pack(side="right")
        ttk.Button(btns, text="Restaurer", style="Accent.TButton", command=do).pack(side="right", padx=6)
        make_flow_rows(btns)
        self._place_win(win, parent)
        win.grab_set()

    def _sync_library_state(self):
        if (self.st.get("default_off") and self.cfg.get("content_used")
                and not sim_running(self.cfg["sim_exe"])):
            self._library_state(list(self._default_off()), True)

    def _library_state(self, names, disabled):
        """Reporte la désactivation / réactivation dans My Library de MSFS 2024 (Content.xml), simulateur fermé.
        Le dossier vide dans Community reste la vraie protection si MSFS remet le contenu en « Activated »."""
        if not names:
            return
        path = find_content_xml(self.cfg.get("community", ""))
        if not path:
            self.log("My Library de MSFS : fichier Content.xml introuvable, seul le dossier vide de Community est utilisé.")
            return
        try:
            changed = content_xml_set(path, names, disabled)
        except (OSError, UnicodeDecodeError) as e:
            self.log("My Library de MSFS : modification impossible (%s)." % e)
            return
        for n in changed:
            self.log(("Désactivée aussi dans My Library de MSFS : %s" if disabled else
                      "Réactivée aussi dans My Library de MSFS : %s") % n)

    def enable_defaults(self, names):
        if self._sim_locked():
            return False
        comm = self.cfg["community"]
        done = 0
        for n in names:
            if n not in self._default_off():
                continue
            path = os.path.join(comm, n) if comm else ""
            if path and os.path.isdir(path) and not is_link(path):
                try:
                    os.rmdir(path)  # ne supprime qu'un dossier vide : aucun risque pour un vrai add-on
                except OSError as e:
                    self.log("Impossible de réactiver %s : le dossier n'est pas vide (%s)." % (n, e))
                    continue
            self._default_off().pop(n, None)
            done += 1
            self.log("Scène par défaut réactivée : %s" % n)
        self._library_state([n for n in names if n not in self._default_off()], False)
        self.save_st()
        self.refresh_library()
        self.set_status("%d scène(s) par défaut réactivée(s)." % done)
        return True

    def show_duplicates(self):
        win = tk.Toplevel(self)
        win.title("Doublons ICAO — add-ons et scènes par défaut MSFS 2024")
        win.configure(bg=C["bg"])
        win.geometry("1060x600")
        self._place_win(win)
        win.transient(self)
        fr = ttk.Frame(win, padding=12)
        fr.pack(fill="both", expand=True)

        top = ttk.Frame(fr)
        top.pack(fill="x")
        btn_run = ttk.Button(top, text="🔍  Scanner les doublons", style="Accent.TButton")
        btn_run.pack(side="left")
        lbl = ttk.Label(top, text="", style="Muted.TLabel")
        lbl.pack(side="left", padx=10)

        bar = ttk.Frame(fr)
        bar.pack(fill="x", pady=8)
        var_q = tk.StringVar()
        var_q.trace_add("write", lambda *a: fill())
        ent_q = ttk.Entry(bar, textvariable=var_q)
        ent_q.pack(side="left", fill="x", expand=True)
        self._add_placeholder(ent_q, var_q, "Rechercher un code OACI ou une scène…")
