        tf = ttk.Frame(fr)
        tf.pack(fill="both", expand=True)
        tv = ttk.Treeview(tf, columns=("source", "titre", "etat"), show="tree headings", selectmode="extended")
        tv.heading("#0", text="ICAO / paquet", anchor="w")
        tv.column("#0", width=380, stretch=True)
        for c, t, w in (("source", "Source", 150), ("titre", "Titre", 330), ("etat", "État", 130)):
            tv.heading(c, text=t, anchor="w")
            tv.column(c, width=w, anchor="w", stretch=(c == "titre"))
        tv.tag_configure("grp", font=(UI_FONT, 10, "bold"))
        tv.tag_configure("conflict", foreground=C["warn"], font=(UI_FONT, 10, "bold"))
        tv.tag_configure("on", background=C["cat_ours"])
        tv.tag_configure("off", foreground=C["off"])
        sb = ttk.Scrollbar(tf, orient="vertical", command=tv.yview)
        tv.configure(yscrollcommand=sb.set)
        tv.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")

        row = ttk.Frame(fr)
        row.pack(fill="x", pady=(10, 0))
        row2 = ttk.Frame(fr)
        row2.pack(fill="x", pady=(6, 0))
        ttk.Label(row2, text="Orange = au moins deux scènes actives pour le même aéroport. Une scène add-on "
                             "bien faite masque déjà l'aéroport par défaut : ne désactive le défaut qu'en cas "
                             "de bâtiments en double ou d'artefacts.", style="Muted.TLabel",
                  wraplength=1000, justify="left").pack(anchor="w")

        def entries_for(icao_filter=None):
            groups = {}
            for p in self.packages:
                for i in self.airport_icaos(p):
                    groups.setdefault(i, []).append(("addon", p))
            known = set()
            for d in (self._dup_streamed or []):
                known.add(d["name"])
                for i in d["icao"]:
                    groups.setdefault(i, []).append(("default", d))
            for n, info in self._default_off().items():
                if n in known:
                    continue
                d = {"name": n, "title": "", "icao": info.get("icao") or streamed_icao(n)}
                for i in d["icao"]:
                    groups.setdefault(i, []).append(("default", d))
            # seuls comptent les add-ons présents dans Community ; une scène par défaut désactivée reste
            # toujours listée (avec ses add-ons) pour pouvoir la réactiver
            out = {}
            for k, v in groups.items():
                off = any(kd == "default" and o["name"] in self._default_off() for kd, o in v)
                act = [(kd, o) for kd, o in v if is_on(kd, o)]
                if off:
                    out[k] = v
                elif len(act) >= 2:
                    out[k] = act
            return out

        def is_on(kind, obj):
            if kind == "addon":
                return self.comm_status(obj) != "—"
            return obj["name"] not in self._default_off()

        def fill():
            try:
                tv.delete(*tv.get_children())
            except tk.TclError:
                return
            self._prune_default_off()
            q = var_q.get().strip().lower()
            groups = entries_for()
            n_conf = 0
            n_addons = sum(1 for p in self.packages if self.airport_icaos(p) and is_on("addon", p))
            for icao in sorted(groups):
                items = groups[icao]
                active = sum(1 for k, o in items if is_on(k, o))
                if q and q not in icao.lower() and not any(
                        q in (o["name"] + " " + o.get("title", "")).lower() for _k, o in items):
                    continue
                conflict = active >= 2
                n_conf += conflict
                gid = "icao:" + icao
                if len(items) == 1:
                    head = "%s — scène par défaut désactivée, plus aucun add-on" % icao
                else:
                    head = ("%s — doublon : %d scènes actives" % (icao, active) if active >= 2 else
                            "%s — scène par défaut désactivée" % icao)
                tv.insert("", "end", iid=gid, open=True, tags=("conflict" if conflict or len(items) == 1 else "grp",),
                          text=head)
                for kind, o in items:
                    on = is_on(kind, o)
                    if kind == "addon":
                        iid = "addon|" + icao + "|" + o["path"]
                        src, etat = ("Add-on (Community)", "Actif") if on else ("Add-on (bibliothèque)", "Inactif")
                    else:
                        iid = "default|" + icao + "|" + o["name"]
                        src, etat = "Par défaut MSFS", "Active" if on else "Désactivée"
                    tv.insert(gid, "end", iid=iid, text=" " + o["name"], tags=("on" if on else "off",),
                              values=(src, o.get("title", ""), etat))
            if not tv.get_children():
                tv.insert("", "end", iid="empty", tags=("off",),
                          text=("  ✓ Aucun doublon : aucun add-on actif dans Community ne recouvre une scène par défaut."
                                if self._dup_streamed is not None else
                                "  Clique sur « Scanner les doublons » pour comparer tes add-ons actifs aux scènes par défaut."))
            if self._dup_streamed is None:
                lbl.config(text="Scan pas encore lancé : seuls les doublons entre tes add-ons actifs sont affichés.")
            else:
                lbl.config(text="Dernier scan : %s · %d add-on%s d'aéroport actif%s · %d scènes par défaut · %d doublon%s"
                                % (self._dup_time, n_addons, "s" if n_addons > 1 else "", "s" if n_addons > 1 else "",
                                   len(self._dup_streamed), n_conf, "s" if n_conf > 1 else ""))

        def selected(kind):
            out = []
            for iid in tv.selection():
                if iid.startswith("icao:"):
                    kids = tv.get_children(iid)
                else:
                    kids = [iid]
                for k in kids:
                    if k.startswith(kind + "|") and k not in out:
                        out.append(k)
            return [k.split("|", 2)[2] for k in out]

        def act_default(enable):
            names = list(dict.fromkeys(selected("default")))
            if not names:
                messagebox.showinfo(APP, "Sélectionne une scène « Par défaut MSFS » (ou la ligne de l'aéroport).",
                                    parent=win)
                return
            (self.enable_defaults if enable else self.disable_defaults)(names)
            fill()

        def act_addon(enable):
            paths = set(selected("addon"))
            pk = [p for p in self.packages if p["path"] in paths]
            if not pk:
                messagebox.showinfo(APP, "Sélectionne un add-on (ou la ligne de l'aéroport).", parent=win)
                return
            if enable:
                self.activate_checked([p for p in pk if self.comm_status(p) == "—"])
            else:
                self.remove_checked([p for p in pk if self.comm_status(p) != "—"])
            fill()

        def run():
            folder = self.cfg.get("streamed") or ""
            if not os.path.isdir(folder):
                folder = detect_streamed(self.cfg["community"])
            if not folder:
                if messagebox.askyesno(APP, "Dossier StreamedPackages de MSFS 2024 introuvable automatiquement.\n\n"
                                            "Veux-tu l'indiquer maintenant ? Il se trouve en général à côté de ton "
                                            "dossier Community.\n\n(Non = afficher seulement les doublons entre tes "
                                            "add-ons.)", parent=win):
                    start = os.path.dirname(self.cfg["community"]) if self.cfg["community"] else None
                    folder = filedialog.askdirectory(title="Dossier StreamedPackages de MSFS 2024",
                                                     initialdir=start, parent=win) or ""
                    folder = os.path.normpath(folder) if folder else ""
                if not folder or not os.path.isdir(folder):
                    fill()
                    return
            if folder != self.cfg.get("streamed"):
                self.cfg["streamed"] = folder
                self.save_cfg()
                try:
                    self.var_streamed.set(folder)
                except tk.TclError:
                    pass
            btn_run.state(["disabled"])
            lbl.config(text="Analyse des scènes par défaut…")

            def done(res, err):
                try:
                    btn_run.state(["!disabled"])
                except tk.TclError:
                    return
                if err:
                    lbl.config(text="Erreur : %s" % err)
                    return
                self._dup_streamed = res
                self._dup_time = time.strftime("%d/%m/%Y %H:%M:%S")
                fill()
                if not res:
                    messagebox.showinfo(APP, "Aucun paquet d'aéroport trouvé dans :\n%s\n\nMSFS 2024 garde la "
                                             "plupart des scènes diffusées dans son cache interne : seules celles "
                                             "stockées en dossiers peuvent être comparées." % folder, parent=win)

            self.run_bg(lambda: scan_streamed(folder), done)

        btn_run.config(command=run)
        self._lk(ttk.Button(row, text="⛔  Désactiver la scène par défaut", style="Warn.TButton",
                            command=lambda: act_default(False))).pack(side="left")
        self._lk(ttk.Button(row, text="↩  Réactiver la scène par défaut",
                            command=lambda: act_default(True))).pack(side="left", padx=6)
        self._lk(ttk.Button(row, text="✖  Désactiver l'add-on", style="Danger.TButton",
                            command=lambda: act_addon(False))).pack(side="left", padx=(18, 0))
        self._lk(ttk.Button(row, text="▶  Activer l'add-on", style="Accent.TButton",
                            command=lambda: act_addon(True))).pack(side="left", padx=6)
        ttk.Button(row, text="Fermer", command=win.destroy).pack(side="right")
        ttk.Button(row, text="🗂  Restaurer Content.xml…",
                   command=lambda: self.restore_content_xml(win)).pack(side="right", padx=6)
        make_flow_rows(row)

        def menu(e):
            iid = tv.identify_row(e.y)
            if iid and iid not in tv.selection():
                tv.selection_set(iid)
            free = not self.sim_on
            m = self._menu()
            m.add_command(label="⛔  Désactiver la scène par défaut", state=self._st(free and selected("default")),
