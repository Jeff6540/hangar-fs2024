    def _place_win(self, win, parent=None):
        """Petite fenêtre : se rouvre là où on l'a laissée (même écran) ; la première fois, ou si cet écran
        n'est plus branché, elle s'ouvre centrée sur l'appli, donc sur l'écran où se trouve Hangar FS 2024."""
        parent = parent or self
        key = (win.title() or "fenetre").split(" — ")[0].strip()
        store = self.cfg.setdefault("win_pos", {})
        try:
            win.update_idletasks()
            m = re.match(r"(\d+)x(\d+)", win.geometry())
            w, h = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
            if w <= 1 or h <= 1:
                w, h = win.winfo_reqwidth(), win.winfo_reqheight()
            sv = store.get(key)
            if sv and point_on_screen(sv["x"] + 60, sv["y"] + 15):
                if sv.get("w") and win.resizable()[0]:
                    w, h = sv["w"], sv["h"]
                win.geometry("%dx%d+%d+%d" % (w, h, sv["x"], sv["y"]))
            else:
                px, py = parent.winfo_rootx(), parent.winfo_rooty()
                pw, ph = parent.winfo_width(), parent.winfo_height()
                x = px + max(0, (pw - w) // 2)
                y = py + max(0, (ph - h) // 3)
                win.geometry("+%d+%d" % (x, y))
        except (tk.TclError, KeyError, TypeError, ValueError):
            return

        def remember(_e=None):
            try:
                g = re.match(r"(\d+)x(\d+)\+(-?\d+)\+(-?\d+)", win.geometry())
                if g and win.state() == "normal":
                    store[key] = {"w": int(g.group(1)), "h": int(g.group(2)),
                                  "x": int(g.group(3)), "y": int(g.group(4))}
            except tk.TclError:
                pass

        def closed(e):
            if e.widget is win:
                self.save_cfg()
        win.bind("<Configure>", lambda e: remember() if e.widget is win else None, add="+")
        win.bind("<Destroy>", closed, add="+")

    def _add_placeholder(self, entry, var, text):
        """Texte grisé dans un champ vide (ex. « Rechercher… ») ; disparaît dès qu'on tape."""
        lab = tk.Label(entry, text=T(text), bg=C["field"] if "field" in C else C["panel"], fg=C["muted"],
                       font=(UI_FONT, 10), cursor="xterm")

        def show(*_a):
            if var.get():
                lab.place_forget()
            else:
                lab.place(x=6, rely=0.5, anchor="w")
        lab.bind("<Button-1>", lambda _e: entry.focus_set())
        var.trace_add("write", show)
        show()

    def _add_clear_button(self, entry, var):
        """Petite croix au bout d'un champ de recherche : vide le champ d'un clic (visible seulement s'il y a du texte)."""
        b = tk.Label(entry, text="✕", bg=C["field"] if "field" in C else C["panel"], fg=C["muted"], cursor="hand2",
                     font=(UI_FONT, 10, "bold"), padx=6)

        def show(*_a):
            if var.get():
                b.place(relx=1.0, rely=0.5, x=-3, anchor="e")
            else:
                b.place_forget()

        def clear(_e=None):
            var.set("")
            entry.focus_set()
        b.bind("<Button-1>", clear)
        b.bind("<Enter>", lambda _e: b.config(fg=C["fg"]))
        b.bind("<Leave>", lambda _e: b.config(fg=C["muted"]))
        entry.bind("<Escape>", clear)
        var.trace_add("write", show)
        show()

