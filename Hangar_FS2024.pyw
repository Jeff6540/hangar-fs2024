    # ---- carte des scènes
    def _load_airports(self, then=None):
        """Charge la base OurAirports (téléchargée une fois, rafraîchie tous les 30 jours)."""
        if self._airports_loading:
            return
        self._airports_loading = True
        self.set_status("Chargement de la base des aéroports…")

        def work():
            fresh = os.path.isfile(AIRPORTS_FILE) and time.time() - os.path.getmtime(AIRPORTS_FILE) < 30 * 86400
            if not fresh:
                try:
                    download_airports(AIRPORTS_FILE)
                except RuntimeError:
                    if not os.path.isfile(AIRPORTS_FILE):
                        raise
            db = load_airports_csv(AIRPORTS_FILE)
            return db, build_city_index(db)

        def done(res, err):
            self._airports_loading = False
            self._icao_cache = {}
            if err:
                self.airports = {}
                if not then:
                    return
                self.log("Base des aéroports indisponible : %s" % err)
                messagebox.showwarning(APP, "Impossible de récupérer la base des aéroports (OurAirports).\n\n%s\n\n"
                                            "La carte s'ouvrira sans positions. Vérifie ta connexion puis "
                                            "réessaie." % err)
            else:
                self.airports, self._city_idx = res
                self.set_status("Base des aéroports chargée : %d terrains." % len(self.airports))
                self.refresh_library()
                self.refresh_flight()
            if then:
                then()

        self.run_bg(work, done)

    def _map_category(self, p, rel, a):
        if "vfr" in rel.lower() or "ulm" in rel.lower() or a["type"] in ("heliport", "seaplane_base",
                                                                         "balloonport", "closed"):
            return "vfr"
        return {"large_airport": "large", "medium_airport": "medium"}.get(a["type"], "small")

    def _map_snapshot(self):
        db = self.airports or {}
        lib = self.cfg["library"]
        off = self.st.get("default_off", {})
        defaults = list(self._dup_streamed or [])
        known = {d["name"] for d in defaults}
        for n, info in off.items():
            if n not in known:
                defaults.append({"name": n, "title": "", "icao": info.get("icao") or streamed_icao(n)})
        def_by_icao = {}
        for d in defaults:
            for c in d["icao"]:
                def_by_icao.setdefault(c, []).append(d)
        addon_by_icao = {}
        pts, nopos = [], []
        for p in self.packages:
            codes = self.airport_icaos(p)
            if not codes:
                continue
            active = self.comm_status(p) != "—"
            rel = ""
            if lib:
                try:
                    rel = os.path.relpath(os.path.dirname(p["path"]), lib)
                except ValueError:
                    rel = ""
                rel = "" if rel == os.curdir else rel
            if db and any(not db.get(c) for c in codes):
                known = [c for c in codes if db.get(c)]
                if not known:   # ex. « LYON » tiré du nom, mais le titre contient le vrai code « LFLL »
                    known = [w for w in re.findall(r"\b[A-Z0-9]{4}\b", (p["name"] + " " + p.get("title", "")).upper())
                             if db.get(w)][:1]
                if known:
                    codes = list(dict.fromkeys(known))
            for c in codes:
                addon_by_icao.setdefault(c, []).append((p, active))
                a = db.get(c)
                if not a:
                    nopos.append({"icao": c, "pkg": p["name"], "title": p["title"]})
                    continue
                also = ""
                if c in def_by_icao:
                    also = T("Scène par défaut MSFS %s") % T("désactivée" if all(d["name"] in off for d in def_by_icao[c])
                                                        else "active")
                pts.append({"kind": "addon", "cat": self._map_category(p, rel, a), "icao": c, "lat": a["lat"],
                            "lon": a["lon"], "name": a["name"], "city": a["city"], "country": a["country"],
                            "pkg": p["name"], "title": p["title"], "folder": rel, "active": active,
                            "pinned": p["pinned"], "also": also})
        for d in defaults:
            for c in d["icao"]:
                a = db.get(c)
                if not a:
                    continue
                also = ""
                if c in addon_by_icao:
                    also = "; ".join("Add-on %s (%s)" % (p["title"] or p["name"], T("actif" if act else "inactif"))
                                     for p, act in addon_by_icao[c])
                pts.append({"kind": "default", "cat": "default", "icao": c, "lat": a["lat"], "lon": a["lon"],
                            "name": a["name"], "city": a["city"], "country": a["country"], "pkg": d["name"],
                            "title": d.get("title", ""), "active": d["name"] not in off, "also": also})
        route = None
        if self.plan:
            rp = []
            for ap in self.plan["airports"]:
                a = db.get(ap["icao"])
                if a:
                    rp.append({"icao": ap["icao"], "role": ap["role"], "primary": ap["primary"],
                               "lat": a["lat"], "lon": a["lon"]})
            route = {"name": ("%s %s" % (self.plan.get("flight", ""), self.plan["route"])).strip(), "points": rp}
        return json.dumps({"points": pts, "nopos": nopos, "route": route, "dbReady": bool(db)},
                          ensure_ascii=False)

    def _push_map(self, force=False):
        """Met à jour les données de la carte ; la page voit le nouveau numéro de version en ~1 s."""
        if not (self._map_server or force):
            return
        try:
            js = self._map_snapshot()
        except Exception as e:  # noqa
            self.log("Carte : %s" % e)
            return
        if js != self._map_json:
            self._map_json = js
            self._map_ver += 1

    def _start_map_server(self):
        if self._map_server:
            return self._map_server.server_address[1]
        app = self

        class Handler(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                path = self.path.split("?", 1)[0]
                if path in ("/", "/index.html"):
                    page = T_page(MAP_HTML)
                    if app.cfg.get("colorblind"):
                        page = page.replace("const CB = false;", "const CB = true;", 1)
                    body, ctype = page.encode("utf-8"), "text/html; charset=utf-8"
                elif path == "/close":
                    which = (urllib.parse.parse_qs(self.path.partition("?")[2]).get("w") or [""])[0]
                    ok = app.close_web_window(which) if which in ("map", "dispatch", "tuto") else False
                    body, ctype = (b"ok" if ok else b"no"), "text/plain"
                elif path in ("/logo.svg", "/bg_map.svg", "/bg_dispatch.svg", "/bg_modal.svg"):
                    body = {"/logo.svg": LOGO_SVG, "/bg_map.svg": BG_MAP_SVG,
                            "/bg_dispatch.svg": BG_DISPATCH_SVG, "/bg_modal.svg": BG_MODAL_SVG}[path].encode("utf-8")
                    ctype = "image/svg+xml"
                elif path in ("/icon_map.png", "/icon_dispatch.png"):
                    body = base64.b64decode(ICON_MAP_PNG if path == "/icon_map.png" else ICON_DISPATCH_PNG)
                    ctype = "image/png"
                elif path in ("/favicon.png", "/favicon.ico"):
                    body, ctype = base64.b64decode(ICON_PNG[64]), "image/png"
                elif path == "/version":
                    body, ctype = str(app._map_ver).encode(), "text/plain"
                elif path == "/tutorial":
                    body, ctype = tutorial_html(LANG).encode("utf-8"), "text/html; charset=utf-8"
                elif path.startswith("/tuto/") and path.endswith(".jpg") and path[6:-4] in TUTO_IMG:
                    body, ctype = base64.b64decode(TUTO_IMG[path[6:-4]].replace("\n", "")), "image/jpeg"
                elif path == "/dispatch":
                    body, ctype = app._dispatch_html().encode("utf-8"), "text/html; charset=utf-8"
                elif path == "/open":
                    url = (urllib.parse.parse_qs(self.path.partition("?")[2]).get("url") or [""])[0]
                    if not re.match(r"^https?://", url, re.I):
                        self.send_error(400)
                        return
                    webbrowser.open(url)
                    body, ctype = b"ok", "text/plain"
                elif path == "/data.json":
                    body, ctype = (app._map_json or "{}").encode("utf-8"), "application/json; charset=utf-8"
                else:
                    self.send_error(404)
                    return
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(body)

            def log_message(self, *_a):
                pass

        srv = None
        for port in list(MAP_PORTS) + [0]:  # port fixe : une carte déjà ouverte se reconnecte après un redémarrage
            try:
                srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
                break
            except OSError:
                continue
        srv.daemon_threads = True
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        self._map_server = srv
        return srv.server_address[1]

