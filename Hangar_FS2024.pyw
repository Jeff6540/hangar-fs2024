      v1: r.speeds_v1, vr: r.speeds_vr, v2: r.speeds_v2, thrust: th, flex: flex, surface: cd.surface_condition,
      mt: mt, c: comps(num(r.true_course), mt), elev: num(r.elevation) };
  }
  function landingInfo(pd) {
    var l = pd && pd.tlr && pd.tlr.landing; if (!l || !l.conditions) return null;
    var cd = l.conditions, r = tlrRunway(l.runway, cd.planned_runway || (pd.destination || {}).plan_rwy); if (!r) return null;
    var icao = (cd.airport_icao || (pd.destination || {}).icao_code || '').toUpperCase(), mt = getMetar(icao);
