def running_images():
    """Noms (en minuscules) des programmes Windows en cours."""
    if not IS_WIN:
        return set()
    try:
        r = subprocess.run(["tasklist", "/FO", "CSV", "/NH"], capture_output=True, encoding=CON_ENC,
                           errors="replace", creationflags=NO_WINDOW, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return set()
    return {line.split('","')[0].strip('"').lower() for line in (r.stdout or "").splitlines() if line.startswith('"')}


