# --------------------------------------------------------------------------- relais Avionics Dispatch
# Repris de « avionics_traffic_relay.py » : trafic IA (SimConnect), SimBrief et METAR
# pour Avionics Dispatch, sur http://localhost:8765. Tout reste sur le PC (127.0.0.1).
RELAY_HOST, RELAY_PORT = "127.0.0.1", 8765
RELAY_RADIUS_KM = 200
RELAY_POLL_SECONDS = 2.0
RELAY_STALE_SECONDS = 10.0
RELAY_LOG = print  # remplacé par le journal de l'appli

DT_INT32, DT_FLOAT64, DT_STRING8, DT_STRING32, DT_STRING64, DT_STRING256 = 1, 4, 5, 6, 7, 9
OBJTYPE_USER, OBJTYPE_AIRCRAFT = 0, 2
RECV_EXCEPTION, RECV_OPEN, RECV_QUIT, RECV_DATA, RECV_DATA_BYTYPE = 1, 2, 3, 8, 9
SC_UNUSED = 0xFFFFFFFF
REQ_AI, REQ_USER, DEFINE_ID = 1, 2, 1
REQ_ROUTE, DEFINE_ROUTE = 3, 2
ROUTE_FIELDS = [("AI TRAFFIC FROMAIRPORT", None, 5), ("AI TRAFFIC TOAIRPORT", None, 5)]
ROUTE_FORMAT = "<8s8s"
ROUTE_SIZE = struct.calcsize(ROUTE_FORMAT)
SC_FIELDS = [
    ("PLANE LATITUDE", "degrees", DT_FLOAT64),
    ("PLANE LONGITUDE", "degrees", DT_FLOAT64),
    ("PLANE ALTITUDE", "feet", DT_FLOAT64),
    ("PLANE HEADING DEGREES TRUE", "degrees", DT_FLOAT64),
    ("GROUND VELOCITY", "knots", DT_FLOAT64),
    ("SIM ON GROUND", "bool", DT_INT32),
    ("ATC ID", None, DT_STRING32),
    ("ATC AIRLINE", None, DT_STRING64),
    ("ATC FLIGHT NUMBER", None, DT_STRING8),
    ("ATC MODEL", None, DT_STRING32),
    ("TITLE", None, DT_STRING256),
    ("PLANE ALT ABOVE GROUND", "feet", DT_FLOAT64),
]
SC_DATA_FORMAT = "<5di32s64s8s32s256sd"
# Données de vol de l'avion du joueur (suivi du vol dans Plan & suivi de vol). Définition séparée :
# si MSFS refuse une variable, seul le suivi est privé de ces valeurs, le trafic IA continue.
REQ_FLIGHT, DEFINE_FLIGHT = 4, 3
FLIGHT_FIELDS = [
    ("vs", "VERTICAL SPEED", "feet per minute"),
    ("fuel_lb", "FUEL TOTAL QUANTITY WEIGHT", "pounds"),
    ("weight_lb", "TOTAL WEIGHT", "pounds"),
    ("flaps", "FLAPS HANDLE INDEX", "number"),
    ("flaps_pct", "FLAPS HANDLE PERCENT", "percent"),
    ("wind_dir", "AMBIENT WIND DIRECTION", "degrees"),
    ("wind_kt", "AMBIENT WIND VELOCITY", "knots"),
    ("pbrake", "BRAKE PARKING POSITION", "bool"),
    ("eng1", "GENERAL ENG COMBUSTION:1", "bool"),
    ("eng2", "GENERAL ENG COMBUSTION:2", "bool"),
    ("eng3", "GENERAL ENG COMBUSTION:3", "bool"),
    ("eng4", "GENERAL ENG COMBUSTION:4", "bool"),
    ("agl", "PLANE ALT ABOVE GROUND", "feet"),
    ("ias", "AIRSPEED INDICATED", "knots"),
]
FLIGHT_FORMAT = "<%dd" % len(FLIGHT_FIELDS)
FLIGHT_SIZE = struct.calcsize(FLIGHT_FORMAT)


def sc_make_flight(values):
    v = dict(zip([k for k, _n, _u in FLIGHT_FIELDS], values))
    return {"vs": int(round(v["vs"])), "fuel_kg": int(round(v["fuel_lb"] * 0.45359237)),
            "weight_kg": int(round(v["weight_lb"] * 0.45359237)), "flaps": int(round(v["flaps"])),
            "flaps_pct": int(round(v["flaps_pct"])), "wind_dir": int(round(v["wind_dir"])) % 360,
            "wind_kt": int(round(v["wind_kt"])), "pbrake": v["pbrake"] >= 0.5,
            "eng": any(v[k] >= 0.5 for k in ("eng1", "eng2", "eng3", "eng4")),
            "agl": int(round(v["agl"])), "ias": int(round(v["ias"]))}
SC_DATA_SIZE = struct.calcsize(SC_DATA_FORMAT)
SC_DATA_OFFSET = 40


def _sc_text(raw):
    return raw.split(b"\x00", 1)[0].decode("utf-8", errors="replace").strip()


def _sc_model(raw):
    """MSFS renvoie parfois une clé de traduction (« ATCCOM.AC_MODEL B788.0.text ») au lieu du type."""
    text = _sc_text(raw)
    m = re.search(r"AC_MODEL[ _]?([A-Za-z0-9]{2,5})", text)
    return m.group(1).upper() if m else text


def sc_make_record(object_id, values):
    lat, lon, alt, hdg, gs, ground, atc_id, airline, flight, model, title, agl = values
    return {"id": int(object_id), "lat": round(lat, 5), "lon": round(lon, 5), "alt": int(round(alt)),
            "hdg": int(round(hdg)) % 360, "gs": int(round(gs)), "ground": bool(ground), "agl": int(round(agl)),
            "callsign": _sc_text(atc_id), "airline": _sc_text(airline), "flight": _sc_text(flight),
            "model": _sc_model(model), "title": _sc_text(title)}


def sc_parse_message(buf):
    if len(buf) < 12:
        return None
    _size, _version, msg_id = struct.unpack_from("<III", buf, 0)
    if msg_id in (RECV_DATA, RECV_DATA_BYTYPE):
        if len(buf) < 20:
            return ("short", len(buf))
        request_id, object_id = struct.unpack_from("<2I", buf, 12)
        if request_id == REQ_FLIGHT:
            if len(buf) < SC_DATA_OFFSET + FLIGHT_SIZE:
                return ("other", msg_id)
            return ("flight", sc_make_flight(struct.unpack_from(FLIGHT_FORMAT, buf, SC_DATA_OFFSET)))
        if request_id == REQ_ROUTE:
            if len(buf) < SC_DATA_OFFSET + ROUTE_SIZE:
                return ("other", msg_id)
            frm, to = struct.unpack_from(ROUTE_FORMAT, buf, SC_DATA_OFFSET)
            return ("route", int(object_id), _sc_text(frm), _sc_text(to))
        if len(buf) < SC_DATA_OFFSET + SC_DATA_SIZE:
            return ("short", len(buf))
        values = struct.unpack_from(SC_DATA_FORMAT, buf, SC_DATA_OFFSET)
        return ("data", request_id, sc_make_record(object_id, values))
    if msg_id == RECV_EXCEPTION:
        code, send_id, index = struct.unpack_from("<3I", buf, 12)
        return ("exception", code, send_id, index)
    if msg_id == RECV_QUIT:
        return ("quit",)
    if msg_id == RECV_OPEN:
        return ("open",)
    return ("other", msg_id)


class RelayState:
    """Données partagées entre la boucle SimConnect et le serveur du relais."""

    def __init__(self):
        self.lock = threading.Lock()
        self.connected = False
        self.mode = "msfs"
        self.objects = {}
        self.user = None
        self.flight = None
        self.routes = {}
        self.exceptions = 0
        self.status = "en attente de MSFS"

    def set_connected(self, value):
        with self.lock:
            self.connected = value
            if not value:
                self.objects.clear()
                self.routes.clear()
                self.user = None
                self.flight = None

    def put(self, request_id, rec):
        if (rec["lat"] == 0 and rec["lon"] == 0) or abs(rec["lat"]) > 90 or abs(rec["lon"]) > 180:
            return
        with self.lock:
            if request_id == REQ_USER:
                self.user = (time.time(), rec)
            else:
                # MSFS 2024 indique parfois « en vol » pour des avions IA garés ou au roulage :
                # un avion à moins de 50 ft du sol, ou lent et bas, est considéré au sol (gris sur la carte)
                if not rec["ground"] and (rec["agl"] < 50 or (rec["gs"] < 40 and rec["agl"] < 500)):
                    rec["ground"] = True
                self.objects[rec["id"]] = (time.time(), rec)

    def handle(self, buf):
        msg = sc_parse_message(buf)
        if not msg:
            return None
        kind = msg[0]
        if kind == "data":
            self.put(msg[1], msg[2])
        elif kind == "flight":
            with self.lock:
                self.flight = (time.time(), msg[1])
        elif kind == "route":
            with self.lock:
                self.routes[msg[1]] = (msg[2], msg[3])
        elif kind == "exception":
            self.exceptions += 1
            if self.exceptions <= 5:
                RELAY_LOG("SimConnect signale une erreur : code=%d, requête=%d, index=%d" % msg[1:4])
        return kind

    def count(self):
        now = time.time()
        with self.lock:
            return sum(1 for ts, _r in self.objects.values() if now - ts <= RELAY_STALE_SECONDS)

    def snapshot(self):
        now = time.time()
        with self.lock:
            for key in [k for k, (ts, _r) in self.objects.items() if now - ts > RELAY_STALE_SECONDS]:
                del self.objects[key]
            user = self.user[1] if self.user and now - self.user[0] <= RELAY_STALE_SECONDS else None
            user_id = user["id"] if user else None
            flight = self.flight[1] if self.flight and now - self.flight[0] <= RELAY_STALE_SECONDS else None
            aircraft = []
            for (_ts, r) in self.objects.values():
                if r["id"] == user_id:
                    continue
                r = dict(r)
                frm, to = self.routes.get(r["id"], (r.get("from", ""), r.get("to", "")))
                r["from"], r["to"] = frm, to
                aircraft.append(r)
            return {"connected": self.connected, "mode": self.mode, "updated": round(now, 1),
                    "user": user, "flight": flight, "aircraft": aircraft}


def find_simconnect_dll(extra_dirs=()):
    here = APP_DIR
    candidates = [os.path.join(d, "SimConnect.dll") for d in (here, BASE_DIR) + tuple(extra_dirs) if d]
    try:
        import SimConnect  # paquet pip « SimConnect » installé par installer.bat : on n'utilise que sa DLL
        candidates.append(os.path.join(os.path.dirname(SimConnect.__file__), "SimConnect.dll"))
    except Exception:  # noqa
        pass
    home = os.path.expanduser("~")
    for desk in (os.path.join(home, "OneDrive", "Desktop"), os.path.join(home, "Desktop"),
                 os.path.join(home, "OneDrive", "Bureau"), os.path.join(home, "Bureau")):
        candidates.append(os.path.join(desk, "relais_trafic_ia", "SimConnect.dll"))
    candidates.append(r"C:\MSFS SDK\SimConnect SDK\lib\SimConnect.dll")
    candidates.append(r"C:\MSFS 2024 SDK\SimConnect SDK\lib\SimConnect.dll")
    for path in candidates:
        if path and os.path.isfile(path):
            return path
    return None


class SimConnectClient:
    def __init__(self, dll_path):
        d = self.dll = ctypes.WinDLL(dll_path)
        self.handle = ctypes.c_void_p()
        u32, vp = ctypes.c_uint32, ctypes.c_void_p
        d.SimConnect_Open.argtypes = [ctypes.POINTER(vp), ctypes.c_char_p, vp, u32, vp, u32]
        d.SimConnect_Open.restype = ctypes.c_long
        d.SimConnect_Close.argtypes = [vp]
        d.SimConnect_Close.restype = ctypes.c_long
        d.SimConnect_AddToDataDefinition.argtypes = [vp, u32, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int,
                                                     ctypes.c_float, u32]
        d.SimConnect_AddToDataDefinition.restype = ctypes.c_long
        d.SimConnect_RequestDataOnSimObjectType.argtypes = [vp, u32, u32, u32, ctypes.c_int]
        d.SimConnect_RequestDataOnSimObjectType.restype = ctypes.c_long
        d.SimConnect_GetNextDispatch.argtypes = [vp, ctypes.POINTER(vp), ctypes.POINTER(u32)]
        d.SimConnect_GetNextDispatch.restype = ctypes.c_long

    def open(self, name):
        hr = self.dll.SimConnect_Open(ctypes.byref(self.handle), name.encode(), None, 0, None, 0)
        if hr != 0:
            raise OSError("MSFS ne répond pas (SimConnect_Open code %d)" % (hr & 0xFFFFFFFF))

    def define(self):
        for name, unit, dtype in SC_FIELDS:
            hr = self.dll.SimConnect_AddToDataDefinition(self.handle, DEFINE_ID, name.encode(),
                                                         unit.encode() if unit else None, dtype, 0.0, SC_UNUSED)
            if hr != 0:
                raise OSError("Variable refusée : %s (code %d)" % (name, hr & 0xFFFFFFFF))

    def define_route(self):
        try:
            for name, _unit, dtype in ROUTE_FIELDS:
                hr = self.dll.SimConnect_AddToDataDefinition(self.handle, DEFINE_ROUTE, name.encode(), None,
                                                             dtype, 0.0, SC_UNUSED)
                if hr != 0:
                    return False
            return True
        except Exception:  # noqa
            return False

    def define_flight(self):
        try:
            for _key, name, unit in FLIGHT_FIELDS:
                hr = self.dll.SimConnect_AddToDataDefinition(self.handle, DEFINE_FLIGHT, name.encode(), unit.encode(),
                                                             DT_FLOAT64, 0.0, SC_UNUSED)
                if hr != 0:
                    return False
            return True
        except Exception:  # noqa
            return False

    def request_flight(self):
        self.dll.SimConnect_RequestDataOnSimObjectType(self.handle, REQ_FLIGHT, DEFINE_FLIGHT, 0, OBJTYPE_USER)

    def request_route(self, radius_m):
        self.dll.SimConnect_RequestDataOnSimObjectType(self.handle, REQ_ROUTE, DEFINE_ROUTE, radius_m,
                                                       OBJTYPE_AIRCRAFT)

    def request(self, request_id, obj_type, radius_m):
        hr = self.dll.SimConnect_RequestDataOnSimObjectType(self.handle, request_id, DEFINE_ID, radius_m, obj_type)
        if hr != 0:
            raise OSError("Demande refusée (code %d)" % (hr & 0xFFFFFFFF))

    def next_message(self):
        pp = ctypes.c_void_p()
        size = ctypes.c_uint32()
        hr = self.dll.SimConnect_GetNextDispatch(self.handle, ctypes.byref(pp), ctypes.byref(size))
        if hr != 0 or not pp.value:
            return None
        return ctypes.string_at(pp.value, size.value)

    def close(self):
        try:
            if self.handle.value:
                self.dll.SimConnect_Close(self.handle)
        except Exception:  # noqa
            pass


def relay_simconnect_loop(state, dll, stop, sim_is_running):
    """Se connecte à MSFS quand il tourne ; se déconnecte proprement quand il se ferme. Ne s'arrête jamais seul."""
    while not stop.is_set():
        if not sim_is_running():
            state.set_connected(False)
            state.status = "en attente de MSFS"
            stop.wait(3.0)
            continue
        client = None
        try:
            client = SimConnectClient(dll)
            client.open("Hangar FS 2024 - relais Avionics Dispatch")
            client.define()
            route_ok = client.define_route()
            flight_ok = client.define_flight()
            state.set_connected(True)
            state.status = "connecté à MSFS"
            RELAY_LOG("connecté à MSFS : le trafic IA est envoyé à Avionics Dispatch.")
            next_poll = 0.0
            while not stop.is_set():
                now = time.time()
                if now >= next_poll:
                    client.request(REQ_AI, OBJTYPE_AIRCRAFT, int(RELAY_RADIUS_KM * 1000))
                    client.request(REQ_USER, OBJTYPE_USER, 0)
                    if flight_ok:
                        client.request_flight()
                    if route_ok:
                        client.request_route(int(RELAY_RADIUS_KM * 1000))
                    next_poll = now + RELAY_POLL_SECONDS
                got = False
                while True:
                    buf = client.next_message()
                    if buf is None:
                        break
                    got = True
                    if state.handle(buf) == "quit":
                        raise ConnectionError("MSFS a été fermé")
                if not got:
                    time.sleep(0.05)
        except Exception as exc:  # noqa
            if state.connected:
                RELAY_LOG("déconnecté de MSFS (%s)." % exc)
            state.set_connected(False)
            state.status = "en attente de MSFS"
            stop.wait(3.0)
        finally:
            if client:
                client.close()


RELAY_SIMBRIEF_URL = "https://www.simbrief.com/api/xml.fetcher.php"
RELAY_UA = {"User-Agent": "HangarFS2024-Relay/1.0"}


def relay_fetch_simbrief(query):
    params = urllib.parse.parse_qs(query)
    userid = (params.get("userid") or [""])[0]
    username = (params.get("username") or [""])[0]
    if userid and re.fullmatch(r"\d{1,12}", userid):
        qs = {"userid": userid, "json": "1"}
    elif username and re.fullmatch(r"[\w .\-]{1,64}", username):
        qs = {"username": username, "json": "1"}
    else:
        return 400, {"fetch": {"status": "Identifiant SimBrief invalide"}}
    req = urllib.request.Request(RELAY_SIMBRIEF_URL + "?" + urllib.parse.urlencode(qs), headers=RELAY_UA)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return 200, json.loads(resp.read().decode("utf-8", errors="replace"))
    except urllib.error.HTTPError as exc:
        try:
            body = json.loads(exc.read().decode("utf-8", errors="replace"))
        except Exception:  # noqa
            body = {"fetch": {"status": "SimBrief a répondu HTTP %d" % exc.code}}
        return exc.code, body
    except Exception as exc:  # noqa
        return 502, {"fetch": {"status": "SimBrief injoignable : %s" % exc}}


RELAY_METAR_SOURCES = [
    ("https://aviationweather.gov/api/data/metar?format=raw&ids=%s", "aviationweather.gov"),
    ("https://tgftp.nws.noaa.gov/data/observations/metar/stations/%s.TXT", "tgftp.nws.noaa.gov"),
]


def relay_fetch_metar(query):
    icao = (urllib.parse.parse_qs(query).get("icao") or [""])[0].upper()
    if not re.fullmatch(r"[A-Z0-9]{3,4}", icao):
        return 400, {"error": "code aéroport invalide"}
    for url, name in RELAY_METAR_SOURCES:
        try:
            req = urllib.request.Request(url % icao, headers=RELAY_UA)
            with urllib.request.urlopen(req, timeout=10) as resp:
                text = resp.read().decode("utf-8", errors="replace").strip()
            lines = [l.strip() for l in text.splitlines() if l.strip()]
            metar = next((l for l in lines if l.startswith(icao)), lines[-1] if lines else "")
            if len(metar) > 10:
                return 200, {"metar": metar, "source": name}
        except Exception:  # noqa
            continue
    return 404, {"error": "aucun METAR trouvé"}


# --------------------------------------------------------------------------- Plans d'aéroport (OpenStreetMap)
# Pistes, taxiways, aires de stationnement et parkings dessinés sur la carte de suivi, d'après OpenStreetMap
# (© contributeurs OpenStreetMap, licence ODbL). Lus par cases de 0,1° via Overpass, gardés 30 jours sur le PC.
AEROWAY_SERVERS = ["https://overpass-api.de/api/interpreter",
                   "https://overpass.private.coffee/api/interpreter",
                   "https://maps.mail.ru/osm/tools/overpass/api/interpreter",
                   "https://overpass.kumi.systems/api/interpreter"]
AEROWAY_TIMEOUT_S = 45
AEROWAY_CELL = 0.1
AEROWAY_TTL_S = 30 * 86400
AEROWAY_DIR = os.path.join(BASE_DIR, "plans_aeroports")
AEROWAY_WAYS = "runway|taxiway|taxilane|apron|parking_position|holding_position|stopway|hangar|terminal"
AEROWAY_NODES = "parking_position|gate|holding_position"
AEROWAY_KEEP_WAYS = set(AEROWAY_WAYS.split("|"))
AEROWAY_KEEP_NODES = set(AEROWAY_NODES.split("|"))
AEROWAY_KEEP_RELS = {"apron", "terminal", "hangar"}
_aeroway_lock = threading.Lock()


def _aeroway_simplify(osm):
    """Réponse Overpass -> liste compacte : {t: type, r: nom/numéro, w: largeur m, g: [[lat, lon], ...]}."""
    out = []
    for el in osm.get("elements", []):
        tags = el.get("tags") or {}
        kind = tags.get("aeroway")
        typ = el.get("type")
        if not kind or kind not in (AEROWAY_KEEP_NODES if typ == "node" else
                                    AEROWAY_KEEP_RELS if typ == "relation" else AEROWAY_KEEP_WAYS):
            continue
        ref = (tags.get("ref") or tags.get("name") or "").strip()[:24]
        if el.get("type") == "node":
            if "lat" in el:
                out.append({"t": kind, "r": ref, "g": [[round(el["lat"], 6), round(el["lon"], 6)]]})
            continue
        if el.get("type") == "relation":   # surface en plusieurs morceaux : on garde les contours extérieurs
            for mem in el.get("members") or []:
                pts = [[round(g["lat"], 6), round(g["lon"], 6)] for g in (mem.get("geometry") or []) if g and "lat" in g]
                if mem.get("role") in ("outer", "") and len(pts) > 3:
                    out.append({"t": kind, "r": ref, "a": 1, "g": pts})
            continue
        geom = el.get("geometry") or []
        pts = [[round(g["lat"], 6), round(g["lon"], 6)] for g in geom if g and "lat" in g]
        if len(pts) < 2:
            continue
        item = {"t": kind, "r": ref, "g": pts}
        if len(pts) > 3 and pts[0] == pts[-1] and (kind in ("apron", "terminal", "hangar") or tags.get("area") == "yes"):
            item["a"] = 1
        try:
            w = float(str(tags.get("width", "")).replace(",", ".").split()[0])
            if 0 < w < 200:
                item["w"] = w
        except (ValueError, IndexError):
            pass
        out.append(item)
    return out


def _aeroway_fetch_one(url, data, out_q):
    host = url.split("/")[2]
    try:
        req = urllib.request.Request(url, data=data, headers={
            "User-Agent": "HangarFS2024/%s (MSFS add-on manager; airport layouts)" % VERSION,
            "Accept": "application/json", "Content-Type": "application/x-www-form-urlencoded"})
        with urllib.request.urlopen(req, timeout=AEROWAY_TIMEOUT_S) as r:
            osm = json.loads(r.read().decode("utf-8", errors="replace"))
        if osm.get("remark") and not osm.get("elements"):   # requête coupée par le serveur (trop chargé)
            raise RuntimeError(str(osm["remark"])[:80])
        out_q.put((True, host, osm))
    except urllib.error.HTTPError as exc:
        out_q.put((False, host, "HTTP %d" % exc.code))
    except Exception as exc:  # noqa
        out_q.put((False, host, str(exc)[:60]))


def _aeroway_fetch_box(s, w, n, e):
    """Demande légère (tout ce qui porte « aeroway » dans la zone, tri fait ici) envoyée aux serveurs en relais :
    le 1er tout de suite, puis un autre toutes les 8 s s'il n'a pas encore répondu ; la 1re bonne réponse gagne."""
    q = '[out:json][timeout:50];nwr["aeroway"](%.4f,%.4f,%.4f,%.4f);out geom;' % (s, w, n, e)
    data = urllib.parse.urlencode({"data": q}).encode("ascii")
    out_q, errors, started = queue.Queue(), [], 0
    deadline = time.time() + AEROWAY_TIMEOUT_S + 8 * len(AEROWAY_SERVERS)
    while time.time() < deadline:
        if started < len(AEROWAY_SERVERS) and (started == 0 or out_q.empty()):
            threading.Thread(target=_aeroway_fetch_one, args=(AEROWAY_SERVERS[started], data, out_q),
                             daemon=True).start()
            started += 1
        try:
            ok, host, res = out_q.get(timeout=8 if started < len(AEROWAY_SERVERS) else max(1, deadline - time.time()))
        except queue.Empty:
            continue
        if ok:
            return _aeroway_simplify(res)
        errors.append("%s %s" % (host, res))
        if len(errors) >= len(AEROWAY_SERVERS):
            break
        if started < len(AEROWAY_SERVERS):   # ce serveur a refusé : on lance le suivant sans attendre
            threading.Thread(target=_aeroway_fetch_one, args=(AEROWAY_SERVERS[started], data, out_q),
                             daemon=True).start()
            started += 1
    raise RuntimeError(" ; ".join(errors) or "délai dépassé")


def _aeroway_cell_path(k):
    return os.path.join(AEROWAY_DIR, "%s.json" % k)


def _aeroway_read_cell(k, stale_ok=False):
    """Plan gardé sur le PC. Après 30 jours il est redemandé à OpenStreetMap (pour rester à jour) ;
    stale_ok=True le relit quand même, quel que soit son âge (serveurs injoignables)."""
    path = _aeroway_cell_path(k)
    try:
        if stale_ok or time.time() - os.path.getmtime(path) < AEROWAY_TTL_S:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
    except (OSError, ValueError):
        pass
    return None


def relay_fetch_aeroway(query):
    """/aeroway?cells=<lat>_<lon>,... (cases de 0,1°) -> {cells: {case: [éléments]}, cached}.
    Les cases déjà gardées sur le PC sont lues directement ; les autres sont demandées en UNE seule fois."""
    qs = urllib.parse.parse_qs(query)
    raw = (qs.get("cells") or qs.get("cell") or [""])[0]
    keys = []
    for k in raw.split(",")[:16]:
        m = re.fullmatch(r"(-?\d{1,3})_(-?\d{1,4})", k.strip())
        if m and -900 <= int(m.group(1)) < 900 and -1800 <= int(m.group(2)) < 1800:
            keys.append("%d_%d" % (int(m.group(1)), int(m.group(2))))
    if not keys:
        return 400, {"error": "case invalide"}
    out, missing = {}, []
    for k in keys:
        items = _aeroway_read_cell(k)
        if items is None:
            missing.append(k)
        else:
            out[k] = items
    if not missing:
        return 200, {"cells": out, "cached": True}
    with _aeroway_lock:   # une seule lecture OpenStreetMap à la fois
        still = []
        for k in missing:   # lue entre-temps par une autre demande ?
            items = _aeroway_read_cell(k)
            if items is None:
                still.append(k)
            else:
                out[k] = items
        missing = still
        if missing:
            idx = [tuple(int(x) for x in k.split("_")) for k in missing]
            s = min(i[0] for i in idx) * AEROWAY_CELL
            w = min(i[1] for i in idx) * AEROWAY_CELL
            n = (max(i[0] for i in idx) + 1) * AEROWAY_CELL
            e = (max(i[1] for i in idx) + 1) * AEROWAY_CELL
            try:
                items = _aeroway_fetch_box(s, w, n, e)
            except Exception as exc:  # noqa
                # serveurs injoignables : on garde l'ancien plan (plus de 30 jours) plutôt que de ne rien afficher
                lost = []
                for k in missing:
                    old_items = _aeroway_read_cell(k, stale_ok=True)
                    if old_items is None:
                        lost.append(k)
                    else:
                        out[k] = old_items
                if not lost:
                    return 200, {"cells": out, "cached": True, "stale": True}
                msg = ("OpenStreetMap unreachable: %s" if LANG == "en" else "OpenStreetMap injoignable : %s") % exc
                return 502, {"error": msg, "cells": out}
            parts = {k: [] for k in missing}
            for it in items:
                g = it["g"][len(it["g"]) // 2]
                k = "%d_%d" % (math.floor(g[0] / AEROWAY_CELL + 1e-9), math.floor(g[1] / AEROWAY_CELL + 1e-9))
                if k in parts:
                    parts[k].append(it)
            try:
                os.makedirs(AEROWAY_DIR, exist_ok=True)
            except OSError:
                pass
            for k, lst in parts.items():
                out[k] = lst
                try:
                    tmp = _aeroway_cell_path(k) + ".tmp"
                    with open(tmp, "w", encoding="utf-8") as f:
                        json.dump(lst, f, separators=(",", ":"))
                    os.replace(tmp, _aeroway_cell_path(k))
                except OSError:
                    pass
    return 200, {"cells": out, "cached": False}


# --------------------------------------------------------------------------- FSHub (pilotes de la compagnie)
FSHUB_API = "https://fshub.io/api/v3"
FSHUB_POLL_S = 6           # comme le radar FSHub : relu toutes les 6 s tant que la carte est ouverte
FSHUB_MOVEMENTS = "https://movements.api.fshub.io/airline/%s/lite"   # flux public du radar de la compagnie
FSHUB_MOVEMENTS_ALL = "https://movements.api.fshub.io/all/lite"      # flux public du radar global (toutes les VA)
FSHUB_ALL_CACHE_S = 10      # radar global relu au plus toutes les 10 s, et seulement quand la carte le demande
FSHUB_PHASES = {"level_flight": "palier", "cruise": "croisière", "climbing": "montée", "descending": "descente",
                "approach": "approche", "landing": "atterrissage", "takeoff": "décollage",
                "taxiing_to_runway": "roulage vers la piste", "taxiing_to_gate": "roulage vers le parking",
                "awaiting_departure": "attente au départ", "parked": "au parking", "pushback": "repoussage",
                "boarding": "embarquement", "deboarding": "débarquement", "on_approach": "approche",
                "take_off": "décollage", "taking_off": "décollage", "landed": "atterri", "taxiing": "roulage",
                "go_around": "remise de gaz", "holding": "attente", "on_ground": "au sol", "in_flight": "en vol",
                "final": "finale", "on_final": "finale", "rejected_takeoff": "décollage interrompu"}
FSHUB_IDLE_S = 120          # plus personne ne regarde la carte depuis 2 min : on arrête d'interroger FSHub


def fshub_get(path, token, timeout=12):
    req = urllib.request.Request(FSHUB_API + path, headers={"X-Pilot-Token": token, "Accept": "application/json",
                                                             "Content-Type": "application/json",
                                                             "User-Agent": "%s/%s" % (APP, VERSION)})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            if r.status == 204:
                return None
            return json.loads(r.read().decode("utf-8", errors="replace") or "null")
    except urllib.error.HTTPError as e:
        if e.code == 204:
            return None
        if e.code in (401, 403):
            raise PermissionError("clé FSHub refusée (vérifie ou régénère ta clé)")
        raise RuntimeError("FSHub a répondu HTTP %d sur %s" % (e.code, path.split("?")[0]))
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise RuntimeError("FSHub injoignable (%s)" % getattr(e, "reason", e))


def _fshub_list(payload):
    d = payload.get("data") if isinstance(payload, dict) else payload
    return d if isinstance(d, list) else ([d] if isinstance(d, dict) else [])


def fshub_identify(token, va=""):
    """Pilote titulaire de la clé et sa compagnie : celle dont le code est réglé (« Ma VA FSHub »),
    sinon la première compagnie de son profil."""
    me = (fshub_get("/user", token) or {}).get("data") or {}
    if isinstance(me, list):
        me = me[0] if me else {}
    if not me.get("id"):
        raise RuntimeError("profil FSHub introuvable (réponse de /user sans identifiant)")
    try:
        airlines = _fshub_list(fshub_get("/pilot/%s/airline" % me["id"], token) or {})
    except RuntimeError:
        airlines = []
    if not airlines and isinstance(me.get("airline"), (dict, list)):
        airlines = me["airline"] if isinstance(me["airline"], list) else [me["airline"]]
    if not airlines:
        raise RuntimeError("ton profil FSHub n'est membre d'aucune compagnie")
    va = (va or "").strip().upper()
    pick = next((a for a in airlines if va and str(a.get("abbr", "")).upper() == va), None)
    if pick is None:
        if va:   # la clé est valable mais ce pilote n'est pas membre de cette VA : on affiche quand même la VA réglée
            pick = {"id": None, "name": va, "abbr": va}
        else:
            pick = airlines[0]
    return {"id": me["id"], "name": me.get("name", "")}, {"id": pick.get("id"), "name": pick.get("name", ""),
                                                          "abbr": pick.get("abbr", "")}


def _fshub_pilot_rec(p):
    gps = p.get("gps") or {}
    try:
        lat, lon = float(gps.get("lat")), float(gps.get("lng", gps.get("lon")))
    except (TypeError, ValueError):
        lat = lon = None
    return {"id": p.get("id"), "name": p.get("name") or "Pilote", "lat": lat, "lon": lon}


def fshub_online_pilots(token, airline_id):
    """Pilotes en ligne de la compagnie. Si FSHub refuse cette liste (404), on essaie d'autres formes de la
    demande, puis la liste de tes amis FSHub. Renvoie (pilotes, source)."""
    try:
        return _fshub_airline_pilots(token, airline_id), "airline"
    except RuntimeError as e:
        if "404" not in str(e):
            raise
        first = e
    try:
        payload = fshub_get("/user/friends", token) or {}
    except RuntimeError:
        raise first
    out = [_fshub_pilot_rec(p) for p in _fshub_list(payload) if p.get("is_online")]
    return out, "friends"


def _fshub_airline_pilots(token, airline_id):
    last = None
    for first_q in ("?limit=100", "", "?limit=50"):
        try:
            return _fshub_airline_pages(token, airline_id, first_q)
        except RuntimeError as e:
            if "404" not in str(e):
                raise
            last = e
    raise last


def _fshub_airline_pages(token, airline_id, first_q):
    out, cursor = [], None
    for _page in range(6):
        q = first_q if not cursor else ("?cursor=%s" % urllib.parse.quote(str(cursor)) +
                                        ("&" + first_q[1:] if first_q else ""))
        payload = fshub_get("/airline/%s/pilot%s" % (airline_id, q), token) or {}
        for p in _fshub_list(payload):
            if p.get("is_online"):
                out.append(_fshub_pilot_rec(p))
        nxt = (((payload.get("meta") or {}).get("cursor") or {}).get("next")) if isinstance(payload, dict) else None
        if not nxt or nxt == cursor:
            break
        cursor = nxt
    return out


def _fshub_icao(v):
    if isinstance(v, dict):
        for k in ("icao", "ident", "code", "icao_code"):
            if isinstance(v.get(k), str) and v.get(k).strip():
                return v[k].strip().upper()
        return ""
    if isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9]{3,4}", v.strip()):
        return v.strip().upper()
    return ""


def fshub_parse_plan(payload):
    """Plan de vol actif FSHub -> {"dep", "arr", "aircraft"} (champs tolérants : la forme exacte n'est pas
    documentée)."""
    d = payload.get("data") if isinstance(payload, dict) and "data" in payload else payload
    if isinstance(d, list):
        d = d[0] if d else None
    if not isinstance(d, dict) or not d:
        return None

    def pick(keys):
        for k in keys:
            if k in d:
                code = _fshub_icao(d[k])
                if code:
                    return code
        return ""
    dep = pick(("departure", "dep", "origin", "from", "departure_icao", "dep_icao", "departure_airport"))
    arr = pick(("arrival", "arr", "destination", "to", "arrival_icao", "arr_icao", "arrival_airport"))
    ac = d.get("aircraft") or d.get("aircraft_icao") or d.get("aircraft_type") or ""
    if isinstance(ac, dict):
        ac = ac.get("icao") or ac.get("icao_code") or ac.get("name") or ac.get("type") or ""
    return {"dep": dep, "arr": arr, "aircraft": str(ac)[:24]}


def fshub_radar_flights(code):
    """Vols en cours de la compagnie, tels que les montre le radar FSHub (positions en direct, sans clé).
    code=None : tous les vols du radar global FSHub."""
    url = FSHUB_MOVEMENTS_ALL if code is None else FSHUB_MOVEMENTS % urllib.parse.quote(str(code))
    req = urllib.request.Request(url, headers={"Accept": "application/json", "Origin": "https://fshub.io",
                                               "Referer": "https://fshub.io/", "User-Agent": "%s/%s" % (APP, VERSION)})
    try:
        with urllib.request.urlopen(req, timeout=12) as r:
            payload = json.loads(r.read().decode("utf-8", errors="replace") or "null")
    except urllib.error.HTTPError as e:
        raise RuntimeError("radar FSHub : HTTP %d" % e.code)
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise RuntimeError("radar FSHub injoignable (%s)" % getattr(e, "reason", e))
    flights = payload.get("flights") if isinstance(payload, dict) else None
    if not isinstance(flights, list):
        raise RuntimeError("radar FSHub : réponse inattendue")
    out = []
    for f in flights:
        if not isinstance(f, dict):
            continue
        pilot = f.get("pilot") if isinstance(f.get("pilot"), dict) else {}
        try:
            lat, lon = float(f.get("lat")), float(f.get("lng", f.get("lon")))
        except (TypeError, ValueError):
            lat = lon = None
        if lat is not None and abs(lat) < 1.0 and abs(lon) < 1.0:
            lat = lon = None
        plan = fshub_parse_plan(f["plan"]) if isinstance(f.get("plan"), dict) else None
        if not plan or not (plan["dep"] or plan["arr"]):
            plan = fshub_parse_plan(f) or plan
        phase = str(f.get("phase") or "")

        def num(k):
            try:
                return int(round(float(f.get(k))))
            except (TypeError, ValueError):
                return None
        out.append({"id": pilot.get("id") or f.get("id"), "pid": pilot.get("id"),
                    "fid": f.get("id") if re.fullmatch(r"[A-Za-z0-9_-]{1,64}", str(f.get("id") or "")) else None, "name": pilot.get("name") or "Pilote", "lat": lat, "lon": lon,
                    "hdg": num("hdg"), "gs": num("ktas"), "alt": num("altf"), "aircraft": (str(f.get("icao") or "") if re.fullmatch(r"[A-Za-z0-9-]{2,8}", str(f.get("icao") or "")) else ""),
                    "phase": phase.replace("_", " ") if LANG == "en" else FSHUB_PHASES.get(phase, phase.replace("_", " ")),
                    "route": (" → ".join(x for x in ((plan or {}).get("dep"), (plan or {}).get("arr")) if x)),
                    "ground": bool(f.get("gnd")), "flying": not f.get("gnd"), "live": True,
                    "va": f.get("airline") if type(f.get("airline")) is int else None})
    return out, payload


_fshub_all = {"t": 0.0, "data": None}
_fshub_all_lock = threading.Lock()


def relay_fshub_all():
    """/fshub-all : tous les vols FSHub (radar global), sans nom de pilote. Gardé 10 s pour ménager FSHub."""
    with _fshub_all_lock:
        if _fshub_all["data"] is not None and time.time() - _fshub_all["t"] < FSHUB_ALL_CACHE_S:
            return 200, _fshub_all["data"]
        try:
            pilots, payload = fshub_radar_flights(None)
        except RuntimeError as e:
            return 502, {"enabled": False, "error": str(e), "pilots": []}
        keep = ("id", "pid", "fid", "lat", "lon", "hdg", "gs", "alt", "aircraft", "phase", "ground", "va")
        data = {"enabled": True, "pilots": [{k: p.get(k) for k in keep} for p in pilots if p.get("lat") is not None],
                "total": payload.get("total") if isinstance(payload, dict) else None, "updated": round(time.time())}
        _fshub_all.update(t=time.time(), data=data)
        return 200, data


def relay_plan_current(get_plan):
    """/plan-current : le plan récupéré dans l'onglet Vol SimBrief (rien si aucun plan ou vol terminé).
    Sans identifiant SimBrief : la page garde le sien."""
    try:
        p = get_plan() if callable(get_plan) else None
    except Exception:  # noqa
        p = None
    if not isinstance(p, dict) or not p.get("airports"):
        return {"has": False}
    prim = [a.get("icao", "") for a in p["airports"] if a.get("primary")]
    return {"has": True, "dep": prim[0] if prim else "", "arr": prim[1] if len(prim) > 1 else "",
            "route": p.get("route", ""), "ofp_id": p.get("ofp_id", ""),
            "generated": p.get("generated") or 0, "fetched": p.get("fetched") or 0}


FSHUB_MOVE_BASE = "https://movements.api.fshub.io"
_fshub_flight = {}
_fshub_flight_lock = threading.Lock()


def _movements_get(path, timeout=10):
    req = urllib.request.Request(FSHUB_MOVE_BASE + path, headers={
        "Accept": "application/json", "Origin": "https://fshub.io", "Referer": "https://fshub.io/",
        "User-Agent": "%s/%s" % (APP, VERSION)})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8", errors="replace") or "null")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise RuntimeError("FSHub : HTTP %d" % e.code)
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise RuntimeError("FSHub injoignable (%s)" % getattr(e, "reason", e))


def _lines_of(geo):
    """GeoJSON (texte ou objet) -> liste de lignes [[lat, lon], ...]."""
    if isinstance(geo, str):
        try:
            geo = json.loads(geo)
        except ValueError:
            return []
    out = []

    def walk(g):
        if not isinstance(g, dict):
            return
        t = g.get("type")
        if isinstance(g.get("features"), list):
            for f in g["features"]:
                walk(f)
        elif isinstance(g.get("geometry"), dict):
            walk(g["geometry"])
        elif t == "LineString":
            out.append(g.get("coordinates") or [])
        elif t == "MultiLineString":
            out.extend(g.get("coordinates") or [])
    walk(geo)
    lines = []
    for ln in out:
        pts = []
        for c in ln:
            try:
                lon, lat = float(c[0]), float(c[1])
            except (TypeError, ValueError, IndexError):
                continue
            if -90 <= lat <= 90 and -180 <= lon <= 180:
                pts.append([round(lat, 5), round(lon, 5)])
        if len(pts) > 1:
            lines.append(pts)
    return lines


def relay_fshub_flight(query):
    """/fshub-flight?pilot=<id>&flight=<id> : plan déposé sur FSHub (route + points) et trajectoire déjà volée.
    Aucun nom de pilote n'est renvoyé. Plan gardé 2 min, trajectoire 30 s."""
    q = urllib.parse.parse_qs(query)
    pid = (q.get("pilot") or [""])[0]
    fid = (q.get("flight") or [""])[0]
    if pid and not re.fullmatch(r"\d{1,12}", pid):
        pid = ""
    if fid and not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", fid):
        fid = ""
    if not pid and not fid:
        return 400, {"ok": False, "error": "identifiant manquant"}
    now = time.time()
    res = {"ok": True, "plan": None, "path": []}
    errors = []
    with _fshub_flight_lock:
        for k in [k for k, v in _fshub_flight.items() if now - v[0] > 600]:
            del _fshub_flight[k]
        if pid:
            c = _fshub_flight.get("p" + pid)
            if c and now - c[0] < 120:
                res["plan"] = c[1]
            else:
                try:
                    d = _movements_get("/pilot/%s" % pid) or {}
                    af = d.get("active_flight") if isinstance(d.get("active_flight"), dict) else d
                    pl = af.get("plan") if isinstance(af, dict) and isinstance(af.get("plan"), dict) else None
                    plan = None
                    if pl:
                        lines = _lines_of(pl.get("geo_json"))
                        coords = lines[0] if lines else []
                        wp = [str(w)[:12] for w in (pl.get("waypoints") or []) if isinstance(w, (str, int))]
                        if coords:
                            plan = {"coords": coords, "wpts": wp[:len(coords)],
                                    "dep": _fshub_icao(pl.get("departure")) or "", "arr": _fshub_icao(pl.get("arrival")) or "",
                                    "cruise": str(pl.get("cruise_lvl") or "")[:8], "route": str(pl.get("route") or "")[:600]}
                    _fshub_flight["p" + pid] = (now, plan)
                    res["plan"] = plan
                except RuntimeError as e:
                    errors.append(str(e))
                    if c:
                        res["plan"] = c[1]
        if fid:
            c = _fshub_flight.get("f" + fid)
            if c and now - c[0] < 30:
                res["path"] = c[1]
            else:
                try:
                    lines = _lines_of(_movements_get("/path/%s/geojson" % fid))
                    total = sum(len(x) for x in lines)
                    if total > 2000:   # allège les très longs vols
                        step = total // 2000 + 1
                        lines = [x[::step] + ([x[-1]] if (len(x) - 1) % step else []) for x in lines]
                    _fshub_flight["f" + fid] = (now, lines)
                    res["path"] = lines
                except RuntimeError as e:
                    errors.append(str(e))
                    if c:
                        res["path"] = c[1]
    if errors and not res["plan"] and not res["path"]:
        return 502, {"ok": False, "error": errors[0]}
    return 200, res


DECOR_EXACT = ("poi", "pois", "lift", "lifts", "lib", "libs", "fix", "fixes", "pack", "packs")


def is_decor_pack(text):
    """Pack de décor / environnement d'après son nom et son titre (pas une scène d'aéroport)."""
    t = text.lower()
    if any(w in t for w in AIRPORT_WORDS):
        return False
    if any(w in t for w in DECOR_WORDS):
        return True
    return bool(set(re.findall(r"[a-zà-ÿ]+", t)) & set(DECOR_EXACT))


def _bearing_nm(a, b, c, d):
    import math
    r = math.radians
    dl = r(d - b)
    y = math.sin(dl) * math.cos(r(c))
    x = math.cos(r(a)) * math.sin(r(c)) - math.sin(r(a)) * math.cos(r(c)) * math.cos(dl)
    brg = (math.degrees(math.atan2(y, x)) + 360) % 360
    h = math.sin(r(c - a) / 2) ** 2 + math.cos(r(a)) * math.cos(r(c)) * math.sin(dl / 2) ** 2
    return brg, 3440.065 * 2 * math.asin(min(1, math.sqrt(h)))


class FshubFeed:
    """Interroge FSHub toutes les 30 s (seulement quand la carte est ouverte) et garde la dernière liste."""

    def __init__(self, get_token, get_va=lambda: ""):
        self.get_token = get_token
        self.get_va = get_va
        self.lock = threading.Lock()
        self.last_request = 0.0
        self.me = self.airline = None
        self.ident_token = ""
        self.prev = {}        # id -> (t, lat, lon, hdg, gs)
        self.plans = {}       # id -> (t, plan ou None) : plan de vol actif FSHub, relu toutes les 2 min
        self.data = {"enabled": False, "status": "aucune VA FSHub réglée", "pilots": []}
        self.wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def snapshot(self):
        self.last_request = time.time()
        self.wake.set()
        with self.lock:
            return dict(self.data)

    def _set(self, **kw):
        if isinstance(kw.get("pilots"), list):   # pas de noms de pilotes sur la carte : avion + route à la place
            kw["pilots"] = [dict(p, name="") for p in kw["pilots"]]
        with self.lock:
            self.data = dict(self.data, **kw)

    def _loop(self):
        while True:
            token = (self.get_token() or "").strip()
            if time.time() - self.last_request < FSHUB_IDLE_S:
                try:
                    self.poll(token)
                except Exception as e:  # noqa
                    self._set(enabled=True, status=str(e))
            t0 = time.time()
            self.wake.wait(FSHUB_POLL_S)
            self.wake.clear()
            time.sleep(max(0.5, 4.0 - (time.time() - t0)))   # jamais plus d'une demande toutes les 4 s

    def _plan(self, token, pilot_id, now):
        """Plan de vol actif du pilote (None = pas de vol en cours). Mis en cache 2 min pour ménager FSHub."""
        cached = self.plans.get(pilot_id)
        if cached and now - cached[0] < 120:
            return cached[1]
        try:
            plan = fshub_parse_plan(fshub_get("/pilot/%s/flight-plan" % pilot_id, token, timeout=8) or {})
        except PermissionError:
            raise
        except RuntimeError as e:
            if "404" in str(e):
                plan = None
            else:
                return cached[1] if cached else None
        self.plans[pilot_id] = (now, plan)
        return plan

    def poll(self, token):
        now = time.time()
        va = re.sub(r"[^A-Z0-9]", "", (self.get_va() or "").upper())[:8]
        sig = token + "|" + va
        if token and (sig != self.ident_token or not self.airline):
            try:
                self.me, self.airline = fshub_identify(token, va)
                self.ident_token = sig
            except RuntimeError:
                self.me = None
                self.airline = {"id": None, "name": va, "abbr": va} if va else None
        elif not token:
            self.me, self.ident_token = None, sig
            self.airline = {"id": None, "name": va, "abbr": va} if va else None
        if not self.airline:   # ni code de VA ni clé FSHub : rien à afficher
            self._set(enabled=False, status="no FSHub VA set" if LANG == "en" else "aucune VA FSHub réglée",
                      airline=None, me=None, pilots=[])
            return
        # 1) le radar FSHub de la compagnie : positions en direct, comme sur fshub.io/airline/<code>/radar
        try:
            if not self.airline.get("abbr"):
                raise RuntimeError("code de la VA inconnu")
            pilots, payload = fshub_radar_flights(self.airline["abbr"])
            me_id = str((self.me or {}).get("id", ""))
            for p in pilots:
                p["me"] = bool(me_id) and str(p["id"]) == me_id
            n_air = sum(1 for p in pilots if p["flying"])
            status = ("%d pilot%s online · %d flying" if LANG == "en" else "%d pilote%s en ligne · %d en vol") % (
                len(pilots), "s" if len(pilots) > 1 else "", n_air)
            self._set(enabled=True, status=status, airline=self.airline, me=self.me, pilots=pilots, source="radar",
                      updated=round(now))
            return
        except RuntimeError as e:
            if not token:
                raise
            radar_error = e
        self.source = "api"
        _ = radar_error
        if not self.airline.get("id"):
            raise radar_error
        pilots = []
        found, source = fshub_online_pilots(token, self.airline["id"])
        self.source = source
        for p in found:
            p["me"] = str(p["id"]) == str(self.me["id"])
            if p["lat"] is not None and abs(p["lat"]) < 1.0 and abs(p["lon"]) < 1.0:
                p["lat"] = p["lon"] = None          # position « 0, 0 » donnée par FSHub : inconnue, pas au large de l'Afrique
            plan = self._plan(token, p["id"], now)
            p["route"] = (" → ".join(x for x in (plan["dep"], plan["arr"]) if x)) if plan else ""
            p["aircraft"] = plan["aircraft"] if plan else ""
            # Mouvement réel : la position FSHub a changé de plus de 2 NM depuis son dernier changement.
            # (Un pilote peut voler sans plan de vol déposé sur FSHub : il est alors repéré par son déplacement.)
            old = self.prev.get(p["id"])        # (t du dernier changement, lat, lon, cap, vitesse, en mouvement jusqu'à)
            hdg, gs, moving_until = (old[3], old[4], old[5]) if old else (None, None, 0)
            if p["lat"] is not None:
                if old and old[1] is not None:
                    brg, dist = _bearing_nm(old[1], old[2], p["lat"], p["lon"])
                    if dist > 2:
                        hdg, gs = brg, dist / (max(5.0, now - old[0]) / 3600.0)
                        moving_until = now + 300
                        self.prev[p["id"]] = (now, p["lat"], p["lon"], hdg, gs, moving_until)
                else:
                    self.prev[p["id"]] = (now, p["lat"], p["lon"], None, None, 0)
            moving = now < moving_until and (gs or 0) >= 50
            p["flying"] = plan is not None or moving
            p["hdg"] = int(round(hdg)) if hdg is not None and p["flying"] else None
            p["gs"] = int(round(gs)) if gs is not None and moving else None
            p["ground"] = not p["flying"]            # au sol = connecté à FSHub, sans plan de vol actif ni déplacement
            pilots.append(p)
        flying = sum(1 for p in pilots if p["flying"])
        self._set(enabled=True, status="%d pilote%s en ligne · %d en vol%s" % (
                  len(pilots), "s" if len(pilots) > 1 else "", flying,
                  "" if source == "airline" else " (amis FSHub : liste de la compagnie refusée)"),
                  airline=self.airline if source == "airline" else {"id": None, "name": "Amis FSHub", "abbr": ""},
                  me=self.me, pilots=pilots, source=source, updated=round(now))


def make_relay_handler(state):
    class RelayHandler(http.server.BaseHTTPRequestHandler):
        def _headers(self, status=200, ctype="application/json; charset=utf-8"):
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Private-Network", "true")
            self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "*")

        def do_OPTIONS(self):
            self._headers(204)
            self.end_headers()

        def do_GET(self):
            route, _, query = self.path.partition("?")
            if route == "/traffic":
                status, payload = 200, state.snapshot()
            elif route == "/simbrief":
                status, payload = relay_fetch_simbrief(query)
            elif route == "/metar":
                status, payload = relay_fetch_metar(query)
            elif route == "/aeroway":
                status, payload = relay_fetch_aeroway(query)
            elif route == "/fshub-all":
                status, payload = relay_fshub_all()
            elif route == "/fshub-flight":
                status, payload = relay_fshub_flight(query)
            elif route == "/plan-current":
                status, payload = 200, relay_plan_current(getattr(state, "plan_info", None))
            elif route == "/fshub":
                feed = getattr(state, "fshub", None)
                status, payload = 200, (feed.snapshot() if feed else {"enabled": False, "pilots": []})
            else:
                body = "Relais Avionics Dispatch (Hangar FS 2024) actif : /traffic, /simbrief, /metar, /aeroway, /fshub, /fshub-all, /fshub-flight".encode("utf-8")
                self._headers(200, "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
            self._headers(status)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_a):
            pass

    return RelayHandler


