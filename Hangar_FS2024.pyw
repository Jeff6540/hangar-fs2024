# Choix du fond de carte sur les cartes plein écran de Plan & suivi de vol
DISPATCH_LAYERS_JS = r"""<script>
/* Hangar FS 2024 : choix du fond de carte (Plan, Plan sombre, Satellite, Relief) sur les cartes plein écran.
   Ajouté par-dessus la page sans modifier sa logique ; le bouton FOND SOMBRE reste synchronisé. */
(function () {
  var OSM = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
  function base(map) {
    var osm = null;
    map.eachLayer(function (l) { if (!osm && l instanceof L.TileLayer) osm = l; });
    if (!osm) osm = L.tileLayer(OSM, { maxZoom: 19, subdomains: 'abc' }).addTo(map);
    return {
      plan: osm,
      dark: L.tileLayer(OSM, { maxZoom: 19, subdomains: 'abc' }),
      sat: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 18 }),
      topo: L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: 'Fond © Esri, HERE, Garmin, USGS, NGA, OpenStreetMap contributors' })
    };
  }
  function setup(map, wrapperId, isDark, setDark, fnName) {
    var b = base(map), current = b.plan, busy = false;
    if (isDark()) { map.removeLayer(b.plan); b.dark.addTo(map); current = b.dark; }
    L.control.layers({
      'Plan (OpenStreetMap)': b.plan, 'Plan sombre': b.dark,
      'Satellite (Esri)': b.sat, 'Relief (Esri)': b.topo
    }, null, { collapsed: true, position: 'topleft' }).addTo(map);
    var tg = map.getContainer().querySelector('.leaflet-control-layers-toggle');
    if (tg) { tg.title = 'Changer de fond de carte'; tg.setAttribute('aria-label', 'Changer de fond de carte'); }
    map.on('baselayerchange', function (e) {
      current = e.layer;
      busy = true;
      var want = e.layer === b.dark;
      if (want !== isDark()) setDark(want);
      busy = false;
    });
    var orig = window[fnName];
    if (typeof orig === 'function') {
      window[fnName] = function () {
        var r = orig.apply(this, arguments);
        if (!busy && (current === b.plan || current === b.dark)) {
          var next = isDark() ? b.dark : b.plan;
          if (next !== current) { map.removeLayer(current); next.addTo(map); current = next; }
        }
        return r;
      };
    }
  }
  var doneFull = false, doneTraffic = false;
  var timer = setInterval(function () {
    try {
      if (!doneFull && typeof fullMap !== 'undefined' && fullMap) {
        doneFull = true;
        setup(fullMap, 'fullMapWrapper',
          function () { return document.getElementById('fullMapWrapper').classList.contains('map-dark-tiles'); },
          function () { toggleMapTheme('full'); }, 'toggleMapTheme');
      }
      if (!doneTraffic && typeof trafficMap !== 'undefined' && trafficMap) {
        doneTraffic = true;
        setup(trafficMap, 'trafficMapWrapper',
          function () { return document.getElementById('trafficMapWrapper').classList.contains('map-dark-tiles'); },
          function () { toggleTrafficTheme(); }, 'toggleTrafficTheme');
      }
      if (doneFull && doneTraffic) clearInterval(timer);
    } catch (e) { /* carte pas encore prête */ }
  }, 500);
})();
</script>
