def content_backups(path, folder):
    """Sauvegardes à proposer pour la restauration : la sauvegarde initiale d'abord, puis les copies
    automatiques (les plus récentes d'abord), puis les copies gardées avant une restauration."""
    out = []
    ini = content_initial_backup(folder)
    if os.path.isfile(ini):
        out.append((os.path.getmtime(ini), ini, "initiale"))
    more = []
    places = [(os.path.dirname(path), r"^Content\.xml\.hangar_\d{8}\.bak$", "automatique"),
              (folder, r"^Content_.+\.xml$", "avant restauration"),
              (os.path.join(APP_DIR, "Sauvegardes"), r"^Content_.*\.xml$", "ancienne"),
              (os.path.join(documents_dir(), "Hangar FS 2024", "Sauvegardes"), r"^Content_.*\.xml$", "ancienne")]
    for d, pattern, kind in places:
        try:
            for e in os.scandir(d):
                if e.is_file() and re.match(pattern, e.name, re.I):
                    more.append((e.stat().st_mtime, e.path, kind))
        except OSError:
            pass
    order = {"automatique": 0, "avant restauration": 1, "ancienne": 2}
    more.sort(key=lambda x: (order[x[2]], -x[0]))
    return out + more


def content_xml_set(path, names, disabled):
    """Passe des contenus en « UserDisabled » (désactivé dans My Library) ou les remet en « Activated ».
    Ne touche qu'aux lignes de ces paquets, jamais aux « SystemDisabled » ; sauvegarde le fichier avant.
    Renvoie la liste des paquets modifiés."""
    with open(path, "rb") as f:
        raw = f.read()
    text = raw.decode("utf-8-sig", errors="strict")
    src, dst = ("Activated", "UserDisabled") if disabled else ("UserDisabled", "Activated")
    changed = []
    for n in names:
        esc = n.replace("&", "&amp;").replace('"', "&quot;").replace("<", "&lt;").replace(">", "&gt;")
        pat = re.compile(r'(<Package\s+name="%s"\s+active=")%s(")' % (re.escape(esc), src), re.I)
        text, k = pat.subn(lambda m: m.group(1) + dst + m.group(2), text)
        if k:
            changed.append(n)
    if not changed:
        return []
    folder = os.path.dirname(path)
    bak = os.path.join(folder, "Content.xml.hangar_%s.bak" % time.strftime("%Y%m%d"))
    if not os.path.exists(bak):
        with open(bak, "wb") as f:
            f.write(raw)
        # on ne garde que les CONTENT_AUTO_KEEP copies automatiques les plus récentes (jamais d'autres fichiers)
        try:
            autos = sorted(e.path for e in os.scandir(folder)
                           if e.is_file() and re.match(r"^Content\.xml\.hangar_\d{8}\.bak$", e.name, re.I))
            for old in autos[:-CONTENT_AUTO_KEEP]:
                os.remove(old)
        except OSError:
            pass
    data = text.encode("utf-8")
    if raw.startswith(b"\xef\xbb\xbf"):
        data = b"\xef\xbb\xbf" + data
    tmp = path + ".hangar_tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)
    return changed


def streamed_icao(name, title=""):
    parts = [x for x in re.split(r"[-_ .]+", name.lower()) if x]
    if "airport" in parts:
        i = parts.index("airport")
        if i + 1 < len(parts) and len(parts[i + 1]) == 4 and parts[i + 1].isalnum() and parts[i + 1][0].isalpha():
            return [parts[i + 1].upper()]
    out = []
    for t in tokens4(name) + tokens4(title, upper_only=True):
        if t not in out:
            out.append(t)
    return out


