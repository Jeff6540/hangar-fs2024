    var x = c.cross > xwMax() || c.gcross > xwMax() ? '<span class="alp-w">travers ' + c.cross + (c.gcross > c.cross ? ' (raf. ' + c.gcross + ')' : '') + '</span>'
                                                   : 'travers ' + c.cross + (c.gcross > c.cross ? ' (raf. ' + c.gcross + ')' : '');
    return h + ' · ' + x + ' kt';
  }
  function windRaw(mt) {
    if (!mt || mt.spd == null) return '';
