def _wait_process_end(pid, ms=15000):
    """Attend que l'ancienne fenêtre de Hangar FS 2024 soit fermée (relance), sans commande cachée."""
    if not (IS_WIN and pid):
        return
    try:
        h = ctypes.windll.kernel32.OpenProcess(0x00100000, False, int(pid))   # SYNCHRONIZE
        if h:
            ctypes.windll.kernel32.WaitForSingleObject(h, int(ms))
            ctypes.windll.kernel32.CloseHandle(h)
    except (OSError, AttributeError, ValueError):
        pass


_wait_process_end(_WAIT_PID)


def write_relaunch_flag(expect_admin, show=True):
    """Drapeau lu par la nouvelle fenêtre : PID de l'ancienne (à attendre), droits attendus, date, affichage."""
    os.makedirs(BASE_DIR, exist_ok=True)
    with open(_flag, "w", encoding="utf-8") as f:
        f.write("%d|%d|%d|%d" % (os.getpid(), 1 if expect_admin else 0, int(time.time()), 1 if show else 0))


def relaunch_args():
    """Commande pour relancer l'appli (fenêtre affichée) en attendant la fermeture de celle-ci."""
    exe, args, wd = launch_command()
    if FROZEN:
        argv = [exe]
    elif PORTABLE:
        argv = [exe, os.path.join(APP_DIR, "app", "Hangar_FS2024.pyc")]
    else:
        argv = [exe, os.path.abspath(__file__)]
    return argv + ["--wait-pid", str(os.getpid())], wd


TASK_NAME = "Hangar FS 2024"
SHOW_FLAG = os.path.join(BASE_DIR, "afficher_au_demarrage.flag")


FROZEN = bool(getattr(sys, "frozen", False))  # True quand l'appli tourne en .exe (PyInstaller)
APP_DIR = os.path.dirname(os.path.abspath(sys.executable if FROZEN else globals().get("__file__", sys.argv[0])))
# Version « portable » : <dossier>\runtime\pythonw.exe (Python officiel, signé) + <dossier>\app\Hangar_FS2024.pyc
