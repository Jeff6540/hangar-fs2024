class Tip:
    """Bulle d'aide au survol d'un widget (ou d'une zone d'un widget si when() le dit)."""

    def __init__(self, widget, text, when=None):
        self.w, self.text, self.when, self.tw, self._job = widget, text, when, None, None
        widget.bind("<Enter>", self._arm, add="+")
        widget.bind("<Motion>", self._arm, add="+")
        widget.bind("<Leave>", self._hide, add="+")
        widget.bind("<ButtonPress>", self._hide, add="+")

    def _arm(self, e):
        ok = self.when(e) if self.when else True
        if not ok:
            self._hide()
            return
        if self.tw is None and self._job is None:
            self._job = self.w.after(450, lambda: self._show(e.x_root, e.y_root))

    def _show(self, x, y):
        self._job = None
        try:
            tw = tk.Toplevel(self.w)
            tw.overrideredirect(True)
            tw.attributes("-topmost", True)
            tk.Label(tw, text=T(self.text), justify="left", wraplength=420, bg="#1f2937", fg="#e5e7eb",
                     relief="solid", bd=1, padx=10, pady=7, font=(UI_FONT, 9)).pack()
            tw.geometry("+%d+%d" % (x + 14, y + 18))
            self.tw = tw
        except tk.TclError:
            self.tw = None

    def _hide(self, _e=None):
        if self._job:
            try:
                self.w.after_cancel(self._job)
            except tk.TclError:
                pass
            self._job = None
        if self.tw is not None:
            try:
                self.tw.destroy()
            except tk.TclError:
                pass
            self.tw = None


# --------------------------------------------------------------------------- rangées de boutons qui passent à la ligne
FLOW_KINDS = ("TButton", "TLabel", "TCheckbutton", "TRadiobutton", "TCombobox", "TSpinbox", "TMenubutton",
              "Button", "Label", "Checkbutton", "Radiobutton", "Menubutton")


class _Flow:
    """Une rangée de boutons (pack side=left/right) qui passe à la ligne quand la fenêtre est trop étroite,
    au lieu de couper les derniers boutons. Sur une seule ligne, l'aspect reste celui d'origine."""

    def __init__(self, frame, items):
        self.f, self.items, self._w, self._job = frame, items, 0, None
        for w, _side, _px in items:
            w.pack_forget()
            w.bind("<Configure>", self._later, add="+")
        frame.bind("<Configure>", self._resized, add="+")
        self._later()

    def _resized(self, e):
        if e.width != self._w:
            self._w = e.width
            self._later()

    def _later(self, _e=None):
        if self._job is None:
            self._job = self.f.after_idle(self.layout)

    def layout(self):
        self._job = None
        try:
            W = self.f.winfo_width()
            sizes = [(w, side, px, w.winfo_reqwidth(), w.winfo_reqheight()) for w, side, px in self.items]
        except tk.TclError:
            return
        total = sum(px[0] + rw + px[1] for _w, _s, px, rw, _h in sizes)
        if W <= 1:          # pas encore affichée : on suppose que tout tient sur une ligne
            W = total
        rows = []
        if total <= W:
            x, xr, h = 0, W, max([sz[4] for sz in sizes] or [1])
            for w, side, px, rw, rh in sizes:
                if side != "right":
                    x += px[0]
                    w.place(x=x, y=(h - rh) // 2)
                    x += rw + px[1]
            for w, side, px, rw, rh in reversed(sizes):
                if side == "right":
                    xr -= px[1] + rw
                    w.place(x=xr, y=(h - rh) // 2)
                    xr -= px[0]
            height = h
        else:
            x = y = h = 0
            for w, side, px, rw, rh in sizes:
                need = rw + (px[0] if x else 0)
                if x and x + need > W:
                    y += h + 6
                    x = h = 0
                    need = rw
                w.place(x=x + (need - rw), y=y)
                x += need + px[1]
                h = max(h, rh)
            height = y + h
        try:
            if int(self.f.cget("height") or 0) != height or int(self.f.cget("width") or 0) != total:
                self.f.configure(height=height, width=total)
        except (tk.TclError, ValueError):
            pass


def _pad_pair(v):
    try:
        parts = [int(float(str(x))) for x in (v if isinstance(v, (tuple, list)) else str(v).split())]
    except ValueError:
        return (0, 0)
    return (parts[0], parts[-1]) if parts else (0, 0)


def make_flow_rows(root, skip=()):
    """Transforme toutes les rangées de boutons simples de la fenêtre en rangées qui passent à la ligne."""
    todo = [root]
    while todo:
        w = todo.pop()
        try:
            kids = w.winfo_children()
        except tk.TclError:
            continue
        todo.extend(kids)
        if w in skip or getattr(w, "_flow", None) or w.winfo_class() not in ("TFrame", "Frame"):
            continue
        slaves = w.pack_slaves()
        if len(slaves) < 2 or len(slaves) != len(kids):
            continue
        items, ok = [], True
        for c in slaves:
            info = c.pack_info()
            if (c.winfo_class() not in FLOW_KINDS or str(info.get("expand")) in ("1", "True", "true")
                    or info.get("fill") in ("x", "both") or info.get("side") not in ("left", "right")):
                ok = False
                break
            items.append((c, info["side"], _pad_pair(info.get("padx", 0))))
        if not ok:
            continue
        # ordre visuel : les « left » dans l'ordre, puis les « right » de gauche à droite
        left = [i for i in items if i[1] == "left"]
        right = [i for i in items if i[1] == "right"][::-1]
        w._flow = _Flow(w, left + right)


