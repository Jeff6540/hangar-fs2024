def detect_streamed(community=""):
    """Cache des paquets diffusés par MSFS 2024 : on essaie tous les emplacements connus."""
    local = os.environ.get("LOCALAPPDATA", "")
    roaming = os.environ.get("APPDATA", "")
    cands = []
    if community:
        cands.append(os.path.join(os.path.dirname(os.path.normpath(community)), "StreamedPackages"))
    for base in packages_paths():
        cands.append(os.path.join(base, "StreamedPackages"))
    cands += [
        os.path.join(local, "Packages", "Microsoft.Limitless_8wekyb3d8bbwe", "LocalState", "StreamedPackages"),
        os.path.join(local, "Packages", "Microsoft.Limitless_8wekyb3d8bbwe", "LocalCache", "StreamedPackages"),
        os.path.join(local, "Packages", "Microsoft.Limitless_8wekyb3d8bbwe", "LocalCache", "Packages", "StreamedPackages"),
        os.path.join(roaming, "Microsoft Flight Simulator 2024", "Packages", "StreamedPackages"),
        os.path.join(roaming, "Microsoft Flight Simulator 2024", "StreamedPackages"),
    ]
    for c in cands:
        try:
            if c and os.path.isdir(c):
                return os.path.normpath(c)
        except OSError:
            continue
    return ""


