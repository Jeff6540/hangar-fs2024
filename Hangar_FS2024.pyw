def clean_frozen_env(after_tk=False):
    """En .exe : les programmes lancés par l'appli (y compris l'appli elle-même au redémarrage) ne doivent pas
    hériter du dossier temporaire _MEI de PyInstaller, qui disparaît quand l'appli se ferme
    (sinon : « Failed to load Python DLL … _MEI…\\python3xx.dll »)."""
    if not FROZEN:
        return
    os.environ["PYINSTALLER_RESET_ENVIRONMENT"] = "1"
    meipass = getattr(sys, "_MEIPASS", "") or ""
    for k in list(os.environ):
        if k.startswith("_PYI_") or k in ("_MEIPASS2", "_PYI_ONEDIR_MODE"):
            os.environ.pop(k, None)
        elif after_tk and k in ("TCL_LIBRARY", "TK_LIBRARY", "TCLLIBPATH"):
            os.environ.pop(k, None)
        elif meipass and k.upper() == "PATH":
            parts = [x for x in os.environ[k].split(os.pathsep) if x and not x.lower().startswith(meipass.lower())]
            os.environ[k] = os.pathsep.join(parts)


clean_frozen_env()


def launch_command():
    """(programme, arguments, dossier) pour démarrer Hangar FS 2024 sans fenêtre noire."""
    if FROZEN:
        return sys.executable, " --minimized", APP_DIR
    if PORTABLE:
        return (os.path.join(APP_DIR, "runtime", "pythonw.exe"),
                '"%s" --minimized' % os.path.join(APP_DIR, "app", "Hangar_FS2024.pyc"), APP_DIR)
    exe = sys.executable
    pw = os.path.join(os.path.dirname(exe), "pythonw.exe")
    if os.path.isfile(pw):
        exe = pw
    script = os.path.abspath(__file__)
    return exe, '"%s" --minimized' % script, os.path.dirname(script)


