    # ---- tâches en arrière-plan
    def _poll(self):
        try:
            while True:
                self.q.get_nowait()()
        except queue.Empty:
            pass
        self.after(150, self._poll)

    def run_bg(self, work, done):
        def t():
            try:
                res = work()
                self.q.put(lambda: done(res, None))
            except Exception as e:  # noqa
                self.q.put(lambda e=e: done(None, e))
        threading.Thread(target=t, daemon=True).start()

    # ---- construction de l'interface
    def _taskbar_identity(self, ico):
        try:
            self.update_idletasks()
            hwnd = ctypes.windll.user32.GetParent(self.winfo_id())
            exe, args, _wd = launch_command()
            set_taskbar_identity(hwnd, ico, '"%s" %s' % (exe, args.replace(" --minimized", "")), APP)
        except Exception:  # noqa — purement cosmétique, ne doit jamais bloquer l'appli
            pass

    def _tab_changed(self, _e=None):
        cur = self.nb.select()
        if cur == str(self.tab_map):
            self.nb.select(self._last_tab)
            self.after(10, self.open_map)
        elif cur == str(self.tab_dispatch):
            self.nb.select(self._last_tab)
            self.after(10, self.open_dispatch)
        else:
            prev = self._last_tab
            self._last_tab = cur
            if prev == str(self.tab_set) and cur != prev and self._settings_changed():
                self.after(10, self._ask_save_settings)

    def _ask_save_settings(self):
        ans = messagebox.askyesnocancel(APP, "Tu as modifié des dossiers ou des chemins dans Réglages sans les "
                                             "enregistrer.\n\nLes enregistrer maintenant ?")
        if ans is None:            # Annuler : on reste dans Réglages
            self.nb.select(self.tab_set)
        elif ans:
            self.save_settings()
        else:                      # Non : on remet les valeurs enregistrées
            self._revert_settings()
            self.set_status("Modifications de Réglages annulées.")

