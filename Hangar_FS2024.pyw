    '.alp-tg{float:right;cursor:pointer;color:#60a5fa;font:600 10px "Segoe UI",sans-serif;border:1px solid #2b3b55;border-radius:5px;padding:0 5px;margin-left:6px}' +
    '.alp-t{color:#fbbf24;font-weight:700}.alp-l{color:#34d399;font-weight:700}.alp-m{color:#8a98b0}.alp-w{color:#fb923c;font-weight:700}' +
    '.alp-b{color:#38bdf8;font-weight:700}.alp-ok{color:#34d399}.alp-y{color:#fbbf24;font-weight:700}' +
    '.alp-s{border-top:1px solid #2b3b55;margin:4px 0}.alp-n{color:#8a98b0;font:10px "Segoe UI",sans-serif;margin-top:4px}.alp-n a{color:#60a5fa}' +
