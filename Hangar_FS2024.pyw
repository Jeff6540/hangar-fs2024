    def _launcher_opts(self):
        self.cfg["launcher_auto"] = self.var_launch_auto.get()
        self.cfg["parking_need_airport"] = self.var_park_apt.get()
        self.save_cfg()

    def _apps(self):
        return self.cfg.setdefault("launcher", [])

    def _app_by_id(self, key):
        return next((a for a in self._apps() if a["id"] == key), None)

    def _selected_apps(self):
        return [a for a in (self._app_by_id(i) for i in self.tv_launch.selection()) if a]

    def _app_state(self, app):
        key = app["id"]
        if key in self._pending:
            left = max(0, int(round(self._pending[key][0] - time.time())))
            return "⏳ démarrage dans %d s" % left, "wait"
        procs = [x.lower() for x in split_procs(app.get("proc"))]
        if any(x in self._images for x in procs):
            return "● en cours", "run"
        p = self._procs.get(key)
        if p is not None and p.poll() is None:
            return "● en cours", "run"
        if key in self._lstatus:
            txt = self._lstatus[key]
            return txt, "wait" if txt.startswith("🛡") else "err"
        if app.get("trigger") == "parking" and app.get("enabled", True) and self.sim_on \
                and self.cfg.get("launcher_auto", True) and not self._parking_fired:
            if self.relay and self.relay.connected:
                return "🅿 attend l'avion au parking", "wait"
            return "🅿 attend le relais (MSFS)", "wait"
        return "arrêtée", "off" if not app.get("enabled", True) else ""

    def launcher_refresh(self):
        tv = self.tv_launch
        sel = tv.selection()
        tv.delete(*tv.get_children())
        for app in self._apps():
            etat, tag = self._app_state(app)
            tags = (tag,) if tag else ()
            if not app.get("enabled", True) and tag != "run":
                tags = ("off",)
            tv.insert("", "end", iid=app["id"], tags=tags, values=(
                "✓" if app.get("enabled", True) else "—", app.get("name", ""),
                "🛡" if app.get("admin") else "",
                ("🅿 Parking + %d s" if app.get("trigger") == "parking" else "MSFS + %d s") % int(app.get("delay", 0)),
                "Oui" if app.get("close_with_sim", True) else "Non", etat, app.get("path", "")))
        keep = [i for i in sel if tv.exists(i)]
        if keep:
            tv.selection_set(keep)

    def _launcher_tick(self):
        """Compte à rebours affiché tant que des lancements sont programmés."""
        if self._pending:
            self.launcher_refresh()
            self.after(1000, self._launcher_tick)

    # -- ajout / modification
    def launcher_add(self):
        path = filedialog.askopenfilename(title="Application à lancer avec MSFS 2024", parent=self,
                                          filetypes=[("Programmes et raccourcis", "*.exe *.lnk *.bat *.cmd"),
                                                     ("Tous les fichiers", "*.*")])
        if not path:
            return
        path = os.path.normpath(path)
        args, cwd = "", ""
        if path.lower().endswith(".lnk"):
            target, args, cwd = resolve_shortcut(path)
            if target:
                path = target
        app = {"id": "app%d" % time.time_ns(), "name": os.path.splitext(os.path.basename(path))[0], "path": path,
               "args": args, "cwd": cwd, "delay": 10, "close_with_sim": True, "enabled": True,
               "proc": os.path.basename(path) if path.lower().endswith(".exe") else ""}
        if self._edit_app_dialog(app, new=True):
            self._apps().append(app)
            self.save_cfg()
            self.launcher_refresh()

    def launcher_edit(self):
        apps = self._selected_apps()
        if len(apps) != 1:
            messagebox.showinfo(APP, "Sélectionne une application dans la liste.")
            return
        if self._edit_app_dialog(apps[0]):
            self.save_cfg()
            self.launcher_refresh()

    def launcher_delete(self):
        apps = self._selected_apps()
        if not apps:
            return
        if not messagebox.askyesno(APP, "Retirer %s de la liste du démarrage auto ?\n\n(L'application elle-même n'est pas "
                                        "désinstallée.)" % ", ".join("« %s »" % a["name"] for a in apps)):
            return
        for a in apps:
            self._cancel_pending(a["id"])
            self._apps().remove(a)
        self.save_cfg()
        self.launcher_refresh()

    def launcher_move(self, step):
        apps = self._selected_apps()
        if len(apps) != 1:
            return
        lst = self._apps()
        i = lst.index(apps[0])
        j = i + step
        if 0 <= j < len(lst):
            lst[i], lst[j] = lst[j], lst[i]
            self.save_cfg()
            self.launcher_refresh()
            self.tv_launch.selection_set(apps[0]["id"])

