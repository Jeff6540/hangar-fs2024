html body button.bg-cockpit-900:hover,html body button.bg-cockpit-800:hover{background:#29303c!important}
button{border-radius:var(--r-ctl)!important}

/* Groupes à bascule (Départ/Arrivée, IFR/VFR…) */
.bg-cockpit-950,.bg-cockpit-950\/70,.bg-cockpit-950\/60,.bg-cockpit-950\/90,.bg-cockpit-950\/95{background-color:var(--al-field)!important}
.bg-cockpit-900{background-color:#161a21!important}
.bg-cockpit-800{background-color:var(--al-card2)!important}

