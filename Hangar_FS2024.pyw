        ttk.Button(bt, text="💾  Enregistrer la sélection comme profil…", command=save_new).pack(side="left", padx=6)
        ttk.Button(bt, text="Remplacer par la sélection", command=update_sel).pack(side="left")
        ttk.Button(bt, text="✎  Renommer…", command=rename).pack(side="left", padx=6)
        ttk.Button(bt, text="🗑  Supprimer", command=delete).pack(side="left")
        ttk.Button(bt, text="Fermer", command=win.destroy).pack(side="right")
        ttk.Button(bt, text="★  Remettre les protégés", command=restore_pins).pack(side="right", padx=6)
        make_flow_rows(bt)
