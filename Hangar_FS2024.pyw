    # ---- actions du menu
    def delete_broken(self, paths):
        if self._sim_locked():
            return
        comm = self.cfg["community"]
        if paths is None:
            paths = []
            try:
                for name in os.listdir(comm):
                    p = os.path.normpath(os.path.join(comm, name))
                    if is_link(p) and not os.path.exists(p):
                        paths.append(p)
            except OSError:
                pass
        if not paths:
            messagebox.showinfo(APP, "Aucun lien invalide dans Community.")
            return
        if not messagebox.askyesno(APP, "Supprimer %d lien(s) invalide(s) ?\n\nCes liens pointent vers des "
                                        "dossiers qui n'existent plus." % len(paths), icon="warning"):
            return
        n = 0
        for p in paths:
            try:
                remove_link(p)
                self.st["links"].pop(p, None)
                n += 1
                self.log("Lien invalide supprimé : %s" % os.path.basename(p))
            except OSError as e:
                self.log("Impossible de supprimer %s : %s" % (os.path.basename(p), e))
        self.save_st()
        self.refresh_library()
        self.check_health()
        self.set_status("%d lien(s) invalide(s) supprimé(s)." % n)

    def move_to_library(self, path):
        if self._sim_locked():
            return
        lib = self.cfg["library"]
        if not lib or not os.path.isdir(lib):
            messagebox.showerror(APP, "Indique d'abord ta bibliothèque dans l'onglet Réglages.")
            return
        src = self._real_target(path)
        name = os.path.basename(path)
        dest_dir = filedialog.askdirectory(title="Dossier de destination dans ta bibliothèque",
                                           initialdir=lib, parent=self)
        if not dest_dir:
            return
        dest_dir = os.path.normpath(dest_dir)
        if inside(dest_dir, self.cfg["community"]) or inside(dest_dir, src):
            messagebox.showerror(APP, "Choisis un dossier de ta bibliothèque, pas Community ni l'add-on lui-même.")
            return
        if not inside(dest_dir, lib) and not messagebox.askyesno(
                APP, "Ce dossier est en dehors de ta bibliothèque : l'appli ne pourra pas gérer l'add-on. Continuer ?"):
            return
        dest = os.path.join(dest_dir, name)
        if same_path(dest, src):
            messagebox.showinfo(APP, "L'add-on est déjà dans ce dossier.")
            return
        if os.path.lexists(dest):
            messagebox.showerror(APP, "Un dossier « %s » existe déjà à cet endroit." % name)
            return
        is_l = is_link(path)
        if not messagebox.askyesno(APP, "Déplacer « %s » vers :\n%s\n\nIl restera actif dans Community grâce à "
                                        "un lien.%s" % (name, dest_dir, "" if is_l else
                                        "\n\nC'est une vraie copie : le déplacement peut prendre du temps "
                                        "si la bibliothèque est sur un autre disque.")):
            return
        kind = self.st["links"].get(path, {}).get("kind", "manual")

        def work():
            if is_l:
                remove_link(path)
            try:
                shutil.move(src, dest)
            except Exception:
                if is_l and os.path.isdir(src) and not os.path.lexists(path):
                    make_link(src, path)
                raise
            make_link(dest, path)
            return True

        def done(_res, err):
            if err:
                self.log("Déplacement impossible pour %s : %s" % (name, err))
                messagebox.showerror(APP, "Déplacement impossible : %s" % err)
                self.refresh_library()
                return
            self.st["links"][path] = {"target": dest, "kind": kind}
            ov = self.cfg["overrides"].pop(src, None)
            if ov:
                self.cfg["overrides"][dest] = ov
            self.save_cfg()
            self.save_st()
            self.log("Déplacé dans la bibliothèque : %s → %s" % (name, dest_dir))
            self.set_status("« %s » est maintenant rangé dans ta bibliothèque et protégé (★)." % name)
            self.rescan()

        self.set_status("Déplacement de « %s » en cours…" % name)
        self.run_bg(work, done)

    def regen_layout(self, pkg):
        if self._sim_locked():
            return
        if not pkg or not os.path.isdir(pkg):
            return
        name = os.path.basename(pkg)
        if not os.path.isfile(os.path.join(pkg, "manifest.json")):
            messagebox.showerror(APP, "« %s » n'a pas de manifest.json : ce n'est pas un add-on MSFS." % name)
            return
        if not messagebox.askyesno(APP, "Régénérer le fichier layout.json de « %s » ?\n\nÀ faire après avoir "
                                        "modifié un add-on (livrée, fichiers ajoutés ou supprimés). Une copie de "
                                        "sauvegarde layout.json.bak et manifest.json.bak est créée." % name):
            return
        self.set_status("Régénération de layout.json…")

        def done(res, err):
            if err:
                self.log("layout.json non régénéré pour %s : %s" % (name, err))
                messagebox.showerror(APP, "Échec : %s" % err)
                return
            n, total = res
            self.log("layout.json régénéré : %s (%d fichiers, %s)" % (name, n, fmt_size(total)))
            self.set_status("layout.json régénéré pour « %s » : %d fichiers." % (name, n))

        self.run_bg(lambda: regenerate_layout(pkg), done)

    def show_properties(self, pkg, comm_path=None):
        if not pkg or not os.path.isdir(pkg):
            return
        try:
            with open(os.path.join(pkg, "manifest.json"), "r", encoding="utf-8-sig", errors="ignore") as f:
                m = json.load(f)
            if not isinstance(m, dict):
                m = {}
        except (OSError, ValueError):
            m = {}
        win = tk.Toplevel(self)
        win.title("Propriétés — %s" % os.path.basename(pkg))
        win.configure(bg=C["bg"])
        win.geometry("720x480")
        self._place_win(win)
        win.transient(self)
        fr = ttk.Frame(win, padding=14)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text=m.get("title") or os.path.basename(pkg), style="Head.TLabel").grid(
            row=0, column=0, columnspan=2, sticky="w", pady=(0, 10))
        deps = m.get("dependencies") if isinstance(m.get("dependencies"), list) else []
        dep_names = ", ".join(str(d.get("name", "")) for d in deps if isinstance(d, dict)) or "aucune"
        try:
            declared = fmt_size(int(str(m.get("total_package_size", "0")).strip() or 0))
        except ValueError:
            declared = "?"
        rows = [("Dossier", os.path.basename(pkg)),
                ("Emplacement", pkg)]
        if comm_path and is_link(comm_path):
            rows.append(("Dans Community", "lien → " + comm_path))
        elif comm_path:
            rows.append(("Dans Community", "vraie copie"))
        rows += [("Créateur", _s(m.get("creator"))), ("Type", _s(m.get("content_type"))),
                 ("Version", _s(m.get("package_version"))),
                 ("Version MSFS minimum", _s(m.get("minimum_game_version"))),
                 ("Dépendances", dep_names),
                 ("Taille déclarée", declared)]
        r = 1
        for k, v in rows:
            ttk.Label(fr, text=k, style="Muted.TLabel").grid(row=r, column=0, sticky="nw", padx=(0, 14), pady=2)
            ttk.Label(fr, text=v or "—", wraplength=520, justify="left").grid(row=r, column=1, sticky="w", pady=2)
            r += 1
        ttk.Label(fr, text="Sur le disque", style="Muted.TLabel").grid(row=r, column=0, sticky="nw", padx=(0, 14), pady=2)
        disk = ttk.Label(fr, text="calcul…")
        disk.grid(row=r, column=1, sticky="w", pady=2)
        ttk.Label(fr, text="layout.json", style="Muted.TLabel").grid(row=r + 1, column=0, sticky="nw", padx=(0, 14), pady=2)
        lay = ttk.Label(fr, text="calcul…", wraplength=520, justify="left")
        lay.grid(row=r + 1, column=1, sticky="w", pady=2)
        fr.columnconfigure(1, weight=1)
        row = ttk.Frame(fr)
        row.grid(row=r + 2, column=0, columnspan=2, sticky="we", pady=(16, 0))
        ttk.Button(row, text="📂  Ouvrir le dossier", command=lambda: open_folder(pkg)).pack(side="left")
        self._lk(ttk.Button(row, text="🗎  Régénérer layout.json", command=lambda: self.regen_layout(pkg))).pack(
            side="left", padx=6)
        ttk.Button(row, text="Fermer", command=win.destroy).pack(side="right")

        def work():
            files = layout_files(pkg)
            total = sum(sz for _p, sz, _d in files)
            listed = None
            try:
                with open(os.path.join(pkg, "layout.json"), "r", encoding="utf-8-sig", errors="ignore") as f:
                    data = json.load(f)
                listed = len(data.get("content", [])) if isinstance(data, dict) else None
            except (OSError, ValueError):
                pass
            return len(files), total, listed

        def done(res, err):
            try:
                if err:
                    disk.config(text="?")
                    lay.config(text="?")
                    return
                n, total, listed = res
                disk.config(text="%s · %d fichiers" % (fmt_size(total), n))
                if listed is None:
                    lay.config(text="absent ou illisible — à régénérer")
                elif listed == n:
                    lay.config(text="%d fichiers listés · cohérent" % listed)
                else:
                    lay.config(text="%d fichiers listés pour %d sur le disque · à régénérer" % (listed, n))
            except tk.TclError:  # fenêtre fermée entre-temps
                pass

        self.run_bg(work, done)

