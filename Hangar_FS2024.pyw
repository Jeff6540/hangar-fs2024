  box-shadow:0 1px 0 rgba(255,255,255,.035) inset,0 12px 32px rgba(0,0,0,.32)!important}
html body .avionics-panel:not(header):hover{border-color:var(--al-line2)!important}
.avionics-panel h3{color:var(--al-text)!important;font-weight:700!important;letter-spacing:.05em!important}
.avionics-panel h3 i{color:var(--al-blue-hi)!important}
.border-cockpit-border,.border-cockpit-border\/80{border-color:var(--al-line)!important}
.divide-cockpit-border>*+*,.divide-cockpit-border\/50>*+*{border-color:var(--al-line)!important}

/* Libellés de section (texte bleu clair) */
.text-cockpit-cyan,.text-cockpit-hud{color:var(--al-sky)!important}
.text-cockpit-amber,.text-amber-300{color:var(--al-amber)!important}

/* Boutons pleins : bleu Hangar FS 2024 */
html body .bg-cockpit-cyan{background:linear-gradient(180deg,var(--al-blue-hi),var(--al-blue))!important;color:#fff!important;
  border-color:transparent!important;box-shadow:0 4px 14px rgba(59,130,246,.28)!important}
html body .bg-cockpit-cyan *{color:#fff!important}
