    '.alp-gs,.alp-xw{background:#0b1220;border:1px solid #475569;border-radius:4px;color:#fbbf24;font:700 10.5px Consolas,monospace;padding:0 4px}' +
    '.alp-gs{width:48px;text-align:center}.alp-xw{width:24px;text-align:center}';
  document.head.appendChild(css);
