    # ---- vérification et réparation (add-ons supprimés ou déplacés hors de l'appli)
    def refresh_and_check(self):
        self.rescan(on_done=lambda: self.check_health(manual=True))

    def _health_issues(self):
        if not self.packages or not self.cfg["library"] or not os.path.isdir(self.cfg["library"]):
            return []
        by_name = {}
        for p in self.packages:
            by_name.setdefault(p["name"].lower(), []).append(p)
        lib = self.cfg["library"]

        def where(p):
            try:
                r = os.path.relpath(os.path.dirname(p["path"]), lib)
                return "racine" if r == os.curdir else r
            except ValueError:
                return os.path.dirname(p["path"])

        issues = []
        seen = set()
        for link, v in list(self.st["links"].items()):
            tgt = v["target"]
            if os.path.exists(tgt) and os.path.lexists(link):
                continue
            seen.add(link)
            name = os.path.basename(link)
            cands = [p for p in by_name.get(name.lower(), []) if not same_path(p["path"], tgt)]
            if not os.path.lexists(link) and os.path.exists(tgt):
                issues.append({"kind": "forget", "link": link, "name": name,
                               "msg": "Lien supprimé hors de l'appli", "fix": "Oublier ce lien"})
            elif cands:
                issues.append({"kind": "moved", "link": link, "name": name, "new": cands[0]["path"],
                               "link_kind": v["kind"], "msg": "Add-on déplacé dans la bibliothèque",
                               "fix": "Refaire le lien (dossier « %s »)" % where(cands[0])})
            else:
                issues.append({"kind": "missing", "link": link, "name": name,
                               "msg": "Dossier introuvable dans la bibliothèque",
                               "fix": "Retirer le lien cassé de Community"})
        comm = self.cfg["community"]
        if comm and os.path.isdir(comm):
            try:
                names = os.listdir(comm)
            except OSError:
                names = []
            for name in names:
                path = os.path.normpath(os.path.join(comm, name))
                if path in seen or path in self.st["links"] or not is_link(path) or os.path.exists(path):
                    continue
                cands = by_name.get(name.lower(), [])
                if cands:
                    issues.append({"kind": "moved", "link": path, "name": name, "new": cands[0]["path"],
                                   "link_kind": "manual", "msg": "Lien externe cassé, add-on retrouvé",
                                   "fix": "Refaire le lien (dossier « %s »)" % where(cands[0])})
                else:
                    issues.append({"kind": "missing", "link": path, "name": name,
                                   "msg": "Lien externe cassé", "fix": "Retirer le lien cassé de Community"})
        for n, info in list(self.st.get("default_off", {}).items()):
            codes = set(info.get("icao") or streamed_icao(n))
            if codes and not any(codes.intersection(self.airport_icaos(p)) for p in self.packages):
                issues.append({"kind": "default_orphan", "name": n,
                               "msg": "Scène par défaut %s désactivée, mais plus d'add-on pour cet aéroport"
                                      % "/".join(sorted(codes)),
                               "fix": "Réactiver la scène par défaut"})
        for key in list(self.cfg["overrides"]):
            if os.path.exists(key):
                continue
            cands = by_name.get(os.path.basename(key).lower(), [])
            if cands:
                issues.append({"kind": "settings", "old": key, "new": cands[0]["path"],
                               "name": os.path.basename(key), "msg": "Réglages d'un add-on déplacé",
                               "fix": "Reporter la protection ★ et les codes ICAO"})
        return issues

    def check_health(self, manual=False):
        self._issues = self._health_issues()
        n = len(self._issues)
        if n:
            self.issue_label.config(text="⚠  %d problème%s : add-on supprimé ou déplacé hors de l'appli, ou lien cassé."
                                         % (n, "s" if n > 1 else ""))
            if not self.issue_banner.winfo_ismapped():
                self.issue_banner.pack(fill="x", before=self.nb)
        else:
            self.issue_banner.pack_forget()
        if manual:
            if n:
                self.show_health()
            else:
                messagebox.showinfo(APP, "Tout est en ordre : aucun add-on manquant ni lien cassé.")

    def show_health(self):
        issues = self._health_issues()
        self._issues = issues
        if not issues:
            self.check_health()
            messagebox.showinfo(APP, "Tout est en ordre : aucun add-on manquant ni lien cassé.")
