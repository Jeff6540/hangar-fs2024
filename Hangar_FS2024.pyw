header.avionics-panel h1 span:first-child{color:#fff}
header.avionics-panel a{background:rgba(15,20,30,.62)!important;border:1px solid rgba(255,255,255,.12)!important;
  border-radius:999px!important;padding:8px 16px!important;backdrop-filter:blur(6px)}
header.avionics-panel a:hover{background:rgba(59,130,246,.28)!important;border-color:rgba(91,155,255,.6)!important}
#dbStatusBadge{background:rgba(15,20,30,.62)!important;border:1px solid rgba(255,255,255,.12)!important;border-radius:999px!important;backdrop-filter:blur(6px)}

/* Cartes */
html body .avionics-panel:not(header){
  background:linear-gradient(180deg,var(--al-card2) 0%,var(--al-card) 140px)!important;
