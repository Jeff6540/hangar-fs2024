TUTO_TITLE = {"fr": "Tutoriel — Hangar FS 2024", "en": "Tutorial — Hangar FS 2024"}


def _tuto_inline(t):
    t = t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    return re.sub(r"`(.+?)`", r"<code>\1</code>", t)


def tutorial_html(lang):
    """Page du tutoriel (sommaire + parties illustrées), dans la langue de l'appli. Fonctionne hors ligne."""
    lang = "en" if lang == "en" else "fr"
    md = TUTO_MD[lang]
    out, toc, i, lines = [], [], 0, md.splitlines()
    while i < len(lines):
        ln = lines[i].rstrip()
        if not ln.strip():
            i += 1
            continue
        if ln.startswith("## "):
            sid = "s%d" % (len(toc) + 1)
            toc.append((sid, ln[3:].strip()))
            out.append('</section><section id="%s"><h2>%s</h2>' % (sid, _tuto_inline(ln[3:].strip())))
            i += 1
        elif ln.startswith("### "):
            out.append("<h3>%s</h3>" % _tuto_inline(ln[4:].strip()))
            i += 1
        elif ln.startswith("!["):
            m = re.match(r"!\[(.*?)\]\(img:(\w+)\)", ln)
            if m:
                name = m.group(2)
                key = name + "_" + lang if name + "_" + lang in TUTO_IMG else (
                    name + "_fr" if name + "_fr" in TUTO_IMG else name)
                if key in TUTO_IMG:
                    out.append('<figure><img src="tuto/%s.jpg" alt=""><figcaption>%s</figcaption></figure>'
                               % (key, _tuto_inline(m.group(1))))
            i += 1
        elif ln.startswith("|"):
            rows = []
            while i < len(lines) and lines[i].startswith("|"):
                cells = [c.strip() for c in lines[i].strip().strip("|").split("|")]
                if not all(set(c) <= set("-: ") for c in cells):
                    rows.append(cells)
                i += 1
            if rows:
                h = "".join("<th>%s</th>" % _tuto_inline(c) for c in rows[0])
                b = "".join("<tr>%s</tr>" % "".join("<td>%s</td>" % _tuto_inline(c) for c in r) for r in rows[1:])
                out.append("<table><thead><tr>%s</tr></thead><tbody>%s</tbody></table>" % (h, b))
        elif re.match(r"^(- |\d+\. )", ln):
            ordered = not ln.startswith("- ")
            items = []
            while i < len(lines) and re.match(r"^(- |\d+\. )", lines[i]):
                items.append(re.sub(r"^(- |\d+\. )", "", lines[i].strip()))
                i += 1
            tag = "ol" if ordered else "ul"
            out.append("<%s>%s</%s>" % (tag, "".join("<li>%s</li>" % _tuto_inline(x) for x in items), tag))
        else:
            para = []
            while i < len(lines) and lines[i].strip() and not re.match(r"^(#|!\[|\||- |\d+\. )", lines[i]):
                para.append(lines[i].strip())
                i += 1
            out.append("<p>%s</p>" % _tuto_inline(" ".join(para)))
    body = "".join(out)[len("</section>"):] + "</section>" if out else ""
    nav = "".join('<a href="#%s" data-s="%s">%s</a>' % (sid, sid, _tuto_inline(t)) for sid, t in toc)
    sub = "Addon Manager · guide illustré" if lang == "fr" else "Addon Manager · illustrated guide"
    close = "✕ Fermer" if lang == "fr" else "✕ Close"
    return """<!doctype html><html lang="%(lang)s"><head><meta charset="utf-8"><title>%(title)s</title>
<link rel="icon" type="image/png" href="favicon.png">
<style>
*{box-sizing:border-box}html,body{margin:0;height:100%%;background:#111419;color:#e8ecf3;font:15px "Segoe UI Variable Text","Segoe UI",Inter,system-ui,sans-serif}
.hd{height:84px;background:#0f1724 url(bg_modal.svg) center/cover;border-bottom:1px solid rgba(59,130,246,.5);display:flex;align-items:center;gap:12px;padding:0 20px}
.hd img{width:50px;height:50px}.hd h1{margin:0;font-size:20px}.hd .s{color:#9fb0c8;font-size:12.5px}
.hd button{margin-left:auto;background:rgba(15,20,30,.66);color:#f87171;border:1px solid #b9383a;border-radius:999px;padding:7px 16px;font:600 13px inherit;cursor:pointer}
.hd button:hover{background:#d0484a;color:#fff}
.wrap{display:grid;grid-template-columns:260px 1fr;height:calc(100%% - 84px)}
nav{background:#15181e;border-right:1px solid #272d38;padding:14px 10px;overflow:auto}
nav a{display:block;padding:8px 12px;border-radius:8px;color:#b9c3d3;text-decoration:none;font-size:13.5px;margin-bottom:2px}
nav a:hover{background:#1f242e;color:#fff}nav a.on{background:rgba(59,130,246,.18);color:#fff;box-shadow:inset 3px 0 #3b82f6}
main{position:relative;overflow:auto;padding:10px 40px 60px;scroll-behavior:smooth}section{max-width:900px;padding-top:14px}
h2{font-size:23px;margin:18px 0 8px;padding-top:10px;border-top:1px solid #272d38}section:first-child h2{border-top:0}
h3{font-size:17px;margin:20px 0 6px;color:#8cc4ff}p,li{line-height:1.6;color:#d6dde8}b{color:#fff}
code{background:#1c212a;border:1px solid #2c333f;border-radius:5px;padding:1px 6px;font:13px Consolas,"Cascadia Mono",monospace;color:#8cc4ff}
figure{margin:16px 0}figure img{width:100%%;border-radius:12px;border:1px solid #2c333f;box-shadow:0 10px 30px rgba(0,0,0,.4)}
figcaption{color:#97a3b6;font-size:13px;margin-top:6px}
table{border-collapse:collapse;width:100%%;margin:10px 0;font-size:14px;background:#191d25;border-radius:10px;overflow:hidden}
th{text-align:left;background:#1f242e;color:#97a3b6;font-size:12px;letter-spacing:.04em;padding:9px 12px}td{padding:8px 12px;border-top:1px solid #272d38;vertical-align:top}
ol,ul{padding-left:22px}
</style></head><body>
<div class="hd"><img src="logo.svg" alt=""><div><h1>%(title)s</h1><div class="s">%(sub)s</div></div><button id="cl">%(close)s</button></div>
<div class="wrap"><nav>%(nav)s</nav><main id="m">%(body)s</main></div>
<script>
var links=[].slice.call(document.querySelectorAll('nav a')),m=document.getElementById('m');
function mark(){var best=null;links.forEach(function(a){var s=document.getElementById(a.dataset.s);if(s&&s.offsetTop-m.scrollTop<120)best=a;});
links.forEach(function(a){a.classList.toggle('on',a===best||(!best&&a===links[0]));});}
m.addEventListener('scroll',mark);mark();
links.forEach(function(a){a.addEventListener('click',function(e){e.preventDefault();var s=document.getElementById(a.dataset.s);m.scrollTop=s.offsetTop-10;});});
document.getElementById('cl').onclick=function(){fetch('close?w=tuto').then(function(r){return r.text()}).then(function(t){if(t!=='ok')window.close()}).catch(function(){window.close()});};
</script></body></html>""" % {"lang": lang, "title": TUTO_TITLE[lang], "sub": sub, "close": close, "nav": nav, "body": body}


