for _old in (os.path.join(_APPDATA, "AddonsLinks"), os.path.join(_APPDATA, "SimBriefLinker")):
    if os.path.isdir(_old) and not os.path.exists(BASE_DIR):
        try:
            os.rename(_old, BASE_DIR)
