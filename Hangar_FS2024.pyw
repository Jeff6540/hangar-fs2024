def _dispatch_tr_text(m):
    raw = m.group(1)
    key = " ".join(raw.split())
    en = DISPATCH_EN_TEXT.get(key)
    if not en:
        return m.group(0)
    lead = raw[:len(raw) - len(raw.lstrip())]
    trail = raw[len(raw.rstrip()):]
    return ">" + lead + en + trail + "<"


def _dispatch_tr_attr(m):
    en = DISPATCH_EN_TEXT.get(" ".join(m.group(2).split()))
    return '%s="%s"' % (m.group(1), en) if en else m.group(0)


def dispatch_localize(html):
    """Page Avionics Dispatch : version générique (les deux langues), puis traduite en anglais si besoin."""
    for fr, gen in DISPATCH_GENERIC_PAIRS:
        html = html.replace(fr, gen)
    if LANG != "en":
        return html
    html = html.replace('<html lang="fr"', '<html lang="en"')
    html = re.sub(r">(\d{1,3}) (\d{3}) ft · FL", r">\1,\2 ft · FL", html)   # liste des altitudes : 10,000 ft
    out = []
    pos = 0
    for m in re.finditer(r"(<script(?![^>]*\bsrc=)[^>]*>)(.*?)(</script>)", html, re.S | re.I):
        out.append(_dispatch_tr_html(html[pos:m.start()]))
        code = m.group(2)
        for fr, en in DISPATCH_EN_JS:
            code = code.replace(fr, en)
        out.append(m.group(1) + code + m.group(3))
        pos = m.end()
    out.append(_dispatch_tr_html(html[pos:]))
    return "".join(out)


def _dispatch_tr_html(part):
    """Textes et attributs hors <style> ; les feuilles de style sont laissées telles quelles."""
    res = []
    pos = 0
    for m in re.finditer(r"<style[^>]*>.*?</style>", part, re.S | re.I):
        seg = part[pos:m.start()]
        seg = re.sub(r">([^<>]+)<", _dispatch_tr_text, seg)
        seg = re.sub(r'\b(placeholder|title|aria-label|alt)="([^"]+)"', _dispatch_tr_attr, seg)
        res.append(seg + m.group(0))
        pos = m.end()
    seg = part[pos:]
    seg = re.sub(r">([^<>]+)<", _dispatch_tr_text, seg)
    seg = re.sub(r'\b(placeholder|title|aria-label|alt)="([^"]+)"', _dispatch_tr_attr, seg)
    res.append(seg)
    return "".join(res)


def dispatch_builtin_html():
    try:
        html = zlib.decompress(base64.b64decode(DISPATCH_BUILTIN_Z.replace("\n", ""))).decode("utf-8", errors="replace")
    except Exception:  # noqa
        return ""
    return dispatch_localize(html)


def download_airports(dest):
    last = None
    for url in AIRPORTS_URLS:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "%s/%s" % (APP, VERSION)})
            with urllib.request.urlopen(req, timeout=90) as r:
                data = r.read()
            if len(data) < 1000000 or not data.startswith(b'"id"') and not data.startswith(b"id"):
                raise RuntimeError("fichier inattendu")
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest + ".tmp", "wb") as f:
                f.write(data)
            os.replace(dest + ".tmp", dest)
            return
        except Exception as e:  # noqa
            last = e
    raise RuntimeError("téléchargement impossible (%s)" % last)


def load_airports_csv(path):
    """Base OurAirports : code OACI -> position, type (large/medium/small…), nom, pays."""
    db = {}
    with open(path, newline="", encoding="utf-8", errors="replace") as f:
        for r in csv.DictReader(f):
            try:
                lat, lon = float(r["latitude_deg"]), float(r["longitude_deg"])
            except (KeyError, TypeError, ValueError):
                continue
            rec = {"name": r.get("name", ""), "type": r.get("type", ""), "lat": lat, "lon": lon,
                   "country": r.get("iso_country", ""), "city": r.get("municipality", "")}
            for key in ("icao_code", "gps_code", "ident"):
                code = (r.get(key) or "").strip().upper()
                if code and (code not in db or (db[code]["type"] == "closed" and rec["type"] != "closed")):
                    db[code] = rec
    return db


GENERIC_WORDS = {"airport", "aeroport", "international", "intl", "airfield", "aerodrome", "scenery", "msfs",
                 "the", "and", "de", "du", "la", "le", "les", "des", "et", "city", "int", "regional", "region",
                 "airports", "pack", "airbase", "heliport", "altiport", "airstrip", "field"}
TYPE_RANK = {"large_airport": 0, "medium_airport": 1, "small_airport": 2, "heliport": 3, "seaplane_base": 4,
             "balloonport": 5}


def text_words(text):
    t = unicodedata.normalize("NFKD", text or "").encode("ascii", "ignore").decode().lower()
    return {w for w in re.findall(r"[a-z]+", t) if len(w) >= 3 and w not in GENERIC_WORDS}


def build_city_index(db):
    """Ville (un seul mot) -> aéroports, pour retrouver un terrain cité par son nom de ville."""
    idx = {}
    for code, rec in db.items():
        if len(code) != 4 or not code.isalpha() or rec["type"] not in TYPE_RANK:
            continue
        w = text_words(rec["city"])
        if len(w) == 1:
            idx.setdefault(w.pop(), []).append((code, rec))
    return idx


def resolve_codes(codes, text, db, city_idx):
    """Garde les codes dont l'aéroport correspond au nom de l'add-on ; sinon cherche par la ville citée."""
    codes = list(codes)
    if len(codes) >= 10:
        # pack de nombreux aéroports (ex. France VFR North East) : on ne cherche pas par le nom du pack,
        # ses mots (north, east, france…) désigneraient de faux aéroports (KXNO à North, Caroline du Sud)
        return drop_stray_codes(codes, db)
    words = text_words(text)
    near = set(drop_stray_codes(codes, db))
    matched = []
    for c in codes:
        if c not in near:
            continue
        rec = db.get(c)
        if rec and text_words(rec["city"] + " " + rec["name"]) & (words - {c.lower()}):
            matched.append(c)
    if matched:
        return matched
    best = None
    for w in words:
        for code, rec in city_idx.get(w, ()):
            if code.lower() == w:
                continue
            r = TYPE_RANK.get(rec["type"], 9)
            if best is None or r < best[0]:
                best = (r, code)
    if best:
        return [best[1]]
    return drop_stray_codes(codes, db)


def drop_stray_codes(codes, db):
    """Pack de plusieurs aéroports (ex. France VFR) : écarte les codes égarés, loin de la zone du pack
    (ex. KXNO aux États-Unis dans un pack français) ou inconnus avec un préfixe étranger (ex. AGRI)."""
    codes = list(codes)
    if len(codes) < 5:
        return codes
    known = [(c, db[c]) for c in codes if c in db]
    if len(known) < 4:
        return codes
    lats = sorted(r["lat"] for _c, r in known)
    lons = sorted(r["lon"] for _c, r in known)
    clat, clon = lats[len(lats) // 2], lons[len(lons) // 2]

    def km(r):
        la1, lo1, la2, lo2 = map(math.radians, (clat, clon, r["lat"], r["lon"]))
        h = math.sin((la2 - la1) / 2) ** 2 + math.cos(la1) * math.cos(la2) * math.sin((lo2 - lo1) / 2) ** 2
        return 12742 * math.asin(min(1, math.sqrt(h)))
    dist = {c: km(r) for c, r in known}
    med = sorted(dist.values())[len(dist) // 2]
    limit = max(1500, 4 * med)
    near = {c for c, d in dist.items() if d <= limit}
    letters = {c[0] for c in near}
    keep = [c for c in codes if c in near or (c not in db and c[:1] in letters)]
    return keep or codes


def lib_signature(lib):
    """Empreinte légère de la bibliothèque (dates des dossiers sur 2 niveaux) pour voir si elle a changé."""
    if not lib or not os.path.isdir(lib):
        return None
    sig = []
    try:
        sig.append(("", os.stat(lib).st_mtime))
        for e in os.scandir(lib):
            if e.is_dir(follow_symlinks=False):
                sig.append((e.name, e.stat(follow_symlinks=False).st_mtime))
                try:
                    for e2 in os.scandir(e.path):
                        if e2.is_dir(follow_symlinks=False):
                            sig.append((e.name + "/" + e2.name, e2.stat(follow_symlinks=False).st_mtime))
                except OSError:
                    pass
    except OSError:
        return None
    return tuple(sorted(sig))


def manifest_brief(path):
    try:
        with open(os.path.join(path, "manifest.json"), "r", encoding="utf-8-sig", errors="ignore") as f:
            m = json.load(f)
        if isinstance(m, dict):
            return (str(m.get("title", "") or ""), str(m.get("creator", "") or ""),
                    str(m.get("package_version", "") or "").strip())
    except (OSError, ValueError):
        pass
    return "", "", ""


# --------------------------------------------------------------------------- Community
def detect_community():
    """Lit UserCfg.opt (MSFS 2024 puis 2020, Store puis Steam) pour trouver Community."""
    local = os.environ.get("LOCALAPPDATA", "")
    roaming = os.environ.get("APPDATA", "")
    candidates = [
        os.path.join(local, "Packages", "Microsoft.Limitless_8wekyb3d8bbwe", "LocalCache", "UserCfg.opt"),
        os.path.join(roaming, "Microsoft Flight Simulator 2024", "UserCfg.opt"),
        os.path.join(local, "Packages", "Microsoft.FlightSimulator_8wekyb3d8bbwe", "LocalCache", "UserCfg.opt"),
        os.path.join(roaming, "Microsoft Flight Simulator", "UserCfg.opt"),
    ]
    for opt in candidates:
        try:
            with open(opt, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("InstalledPackagesPath"):
                        parts = line.split(None, 1)
                        if len(parts) < 2:
                            continue
                        comm = os.path.join(parts[1].strip().strip('"'), "Community")
                        if os.path.isdir(comm):
                            return os.path.normpath(comm)
        except OSError:
            continue
    return ""


# --------------------------------------------------------------------------- liens
def is_link(path):
    try:
        if hasattr(os.path, "isjunction") and os.path.isjunction(path):
            return True
        if os.path.islink(path):
            return True
        os.readlink(path)
        return True
    except (OSError, ValueError):
        return False


def link_target(path):
    try:
        t = os.readlink(path)
    except (OSError, ValueError):
        return ""
    if t.startswith("\\\\?\\"):
        t = t[4:]
    return t


def make_link(target, link):
    if IS_WIN:
        r = subprocess.run(["cmd", "/c", "mklink", "/J", link, target],
                           capture_output=True, encoding=CON_ENC, errors="replace",
                           creationflags=NO_WINDOW)
        if r.returncode != 0:
            raise OSError((r.stderr or r.stdout or "").strip() or "mklink a échoué")
    else:
        os.symlink(target, link, target_is_directory=True)


def remove_link(link):
    if not os.path.lexists(link):
        return
    if not is_link(link):
        raise OSError("refus : c'est un vrai dossier, pas un lien")
    if IS_WIN:
        os.rmdir(link)  # retire la jonction, pas le contenu de la cible
    else:
        os.unlink(link)


def sim_running(exe):
    if not IS_WIN or not exe:
        return False
    try:
        r = subprocess.run(["tasklist", "/FI", "IMAGENAME eq %s" % exe, "/NH", "/FO", "CSV"],
                           capture_output=True, encoding=CON_ENC, errors="replace",
                           creationflags=NO_WINDOW, timeout=15)
        return exe.lower() in (r.stdout or "").lower()
    except (OSError, subprocess.SubprocessError):
        return False


