    def _toggle_startup(self):
        on, admin = self.var_startup.get(), self.var_startup_admin.get()
        if admin and not on:
            self.var_startup.set(True)  # le mode administrateur implique le démarrage avec Windows
            on = True
        self.set_status("Mise à jour du démarrage avec Windows…")

        def work():
            if on and admin:
                if not create_admin_task():
                    return "La tâche administrateur n'a pas pu être créée (confirmation Windows refusée ?)."
                # démarrage par le raccourci normal ; l'appli se met ensuite en administrateur par la tâche
                if not set_start_with_windows(True):
                    return "Impossible de modifier le démarrage avec Windows."
                return ""
            if task_exists() and not delete_admin_task():
                return "La tâche administrateur n'a pas pu être supprimée (confirmation Windows refusée ?)."
            if not set_start_with_windows(on):
                return "Impossible de modifier le démarrage avec Windows."
            return ""

        def done(err_msg, err):
            msg = err_msg or (str(err) if err else "")
            self.cfg["startup_admin"] = task_exists()
            self.save_cfg()
            self.var_startup_admin.set(self.cfg["startup_admin"])
            self.var_startup.set(self.cfg["startup_admin"] or os.path.isfile(startup_shortcut()))
            if msg:
                self.set_status(msg)
                messagebox.showwarning(APP, msg)
                return
            if self.cfg["startup_admin"]:
                self.set_status("Hangar FS 2024 démarrera avec Windows en mode administrateur, sans confirmation.")
            elif self.var_startup.get():
                self.set_status("Hangar FS 2024 démarrera avec Windows (mode normal).")
            else:
                self.set_status("Hangar FS 2024 ne démarrera plus avec Windows.")
            self.log(self.status.cget("text"))

        self.run_bg(work, done)

    # ---- sauvegarde des réglages (un seul fichier .zip, choisi par l'utilisateur)
    def _export_settings(self):
        try:
            self.save_cfg()
        except Exception:  # noqa
            pass
        docs = os.path.join(os.path.expanduser("~"), "Documents")
        path = filedialog.asksaveasfilename(
            parent=self, title="Exporter mes réglages", defaultextension=".zip",
            initialdir=docs if os.path.isdir(docs) else None,
            initialfile="Hangar_FS2024_reglages_%s.zip" % time.strftime("%Y-%m-%d"),
            filetypes=[("Sauvegarde Hangar FS 2024", "*.zip")])
        if not path:
            return
        import zipfile
        info = {"app": APP, "version": VERSION, "date": time.strftime("%Y-%m-%d %H:%M"), "kind": "hangar_fs2024_settings"}
        try:
            with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
                z.writestr("hangar_backup.json", json.dumps(info, ensure_ascii=False, indent=2))
                z.writestr("config.json", json.dumps(self.cfg, ensure_ascii=False, indent=2))
        except (OSError, ValueError) as e:
            messagebox.showerror(APP, "Export impossible : %s" % e, parent=self)
            return
        self.log("Réglages exportés : %s" % os.path.basename(path))
        messagebox.showinfo(APP, "Réglages exportés dans :\n%s\n\nCe fichier est personnel : il contient ton identifiant "
                                 "SimBrief et ta clé FSHub. Ne le partage pas." % path, parent=self)

    def _import_settings(self):
        if self.sim_on:
            messagebox.showinfo(APP, "Ferme d'abord MSFS 2024 : l'appli redémarre après la restauration.", parent=self)
            return
        path = filedialog.askopenfilename(parent=self, title="Restaurer mes réglages",
                                          filetypes=[("Sauvegarde Hangar FS 2024", "*.zip")])
        if not path:
            return
        import zipfile
        try:
            with zipfile.ZipFile(path) as z:
                info = json.loads(z.read("hangar_backup.json").decode("utf-8"))
                cfg = json.loads(z.read("config.json").decode("utf-8"))
            if not isinstance(info, dict) or info.get("kind") != "hangar_fs2024_settings" or not isinstance(cfg, dict):
                raise ValueError("fichier non reconnu")
        except (OSError, KeyError, ValueError, zipfile.BadZipFile) as e:
            messagebox.showerror(APP, "Ce fichier n'est pas une sauvegarde Hangar FS 2024 (%s)." % e, parent=self)
            return
        if not messagebox.askyesno(APP, "Remplacer tes réglages actuels par ceux de la sauvegarde du %s (version %s) ?\n\n"
                                        "Tes réglages actuels sont d'abord gardés à côté. L'appli redémarre ensuite ; "
                                        "vérifie alors les dossiers dans Réglages s'il s'agit d'un autre PC."
                                        % (info.get("date", "?"), info.get("version", "?")), parent=self):
            return
        try:
            if os.path.exists(CONFIG_FILE):
                shutil.copy2(CONFIG_FILE, os.path.join(BASE_DIR, "config_avant_restauration_%s.json"
                                                       % time.strftime("%Y%m%d_%H%M%S")))
            cfg["lang"] = self.cfg.get("lang", cfg.get("lang", "fr"))   # garde la langue choisie sur ce PC
            save_json(CONFIG_FILE, cfg)
        except OSError as e:
            messagebox.showerror(APP, "Restauration impossible : %s" % e, parent=self)
            return
        self.cfg = cfg
        try:
            self.var_user.set(cfg.get("simbrief_user", ""))   # save_cfg() à la fermeture relit ce champ
        except Exception:  # noqa
            pass
        self.log("Réglages restaurés depuis %s" % os.path.basename(path))
        self._restored = True
        self.restart_app()

    def restart_app(self):
        """Relance l'appli dans le même mode (normal ou administrateur), fenêtre affichée."""
        argv, wd = relaunch_args()
        try:
            subprocess.Popen(argv, cwd=wd, creationflags=getattr(subprocess, "DETACHED_PROCESS", 0))
        except OSError as e:
            messagebox.showerror(APP, "Relance impossible : %s" % e)
            return
        self.on_close()

    def restart_as_admin(self):
        if self.sim_on and not messagebox.askyesno(APP, "MSFS 2024 est lancé. Relancer Hangar FS 2024 maintenant ?\n\n"
                                                        "Les applications déjà ouvertes ne sont pas touchées."):
            return
        exe, _args, _wd = launch_command()
        if task_exists() and same_program(task_command(), exe):
            # la tâche planifiée démarre l'appli en administrateur sans confirmation
            try:
                write_relaunch_flag(True)
                r = subprocess.run(["schtasks", "/Run", "/TN", TASK_NAME], capture_output=True,
                                   creationflags=NO_WINDOW, timeout=15)
                if r.returncode != 0:
                    raise OSError((r.stderr or r.stdout or b"").decode(CON_ENC, "replace").strip() or "schtasks")
            except (OSError, subprocess.SubprocessError) as e:
                messagebox.showerror(APP, "Relance impossible : %s" % e)
                return
        else:
            argv, wd = relaunch_args()
            params = " ".join('"%s"' % a if " " in a else a for a in argv[1:])
            if not shell_runas(argv[0], params, wd, 1):
                messagebox.showinfo(APP, "Relance annulée (confirmation Windows refusée).")
                return
        self.on_close()

    def _detect_msfs_ui(self):
        self.set_status("Recherche de MSFS 2024…")

        def done(res, err):
            if res:
                self.var_msfs.set(res)
                self.cfg["msfs_launch"] = res
                self.save_cfg()
                self.set_status("MSFS 2024 trouvé.")
            else:
                messagebox.showinfo(APP, "MSFS 2024 introuvable automatiquement. Indique son raccourci ou son "
                                         "programme dans le champ « Lancement de MSFS 2024 ».")

        self.run_bg(detect_msfs_launch, done)

    def launch_msfs(self):
        if self.sim_on or sim_running(self.cfg["sim_exe"]):
            messagebox.showinfo(APP, "MSFS 2024 est déjà lancé.")
            return

        def go(target):
            try:
                if target.lower().startswith("shell:"):
                    subprocess.Popen(["explorer.exe", target])
                else:
                    os.startfile(target)  # noqa : programme, raccourci ou lien steam://
            except OSError as e:
                messagebox.showerror(APP, "Impossible de lancer MSFS 2024 : %s" % e)
                return
            self.log("MSFS 2024 lancé depuis Hangar FS 2024.")
            self.set_status("MSFS 2024 démarre… le démarrage auto des applis et le relais suivront automatiquement.")

        target = self.cfg.get("msfs_launch", "")
        if target:
            go(target)
            return
        self.set_status("Recherche de MSFS 2024…")

        def done(res, err):
            if not res:
                messagebox.showinfo(APP, "MSFS 2024 introuvable automatiquement. Indique son raccourci ou son "
                                         "programme dans l'onglet Réglages, ligne « Lancement de MSFS 2024 ».")
                return
            self.cfg["msfs_launch"] = res
            self.save_cfg()
            try:
                self.var_msfs.set(res)
            except (AttributeError, tk.TclError):
                pass
            go(res)

        self.run_bg(detect_msfs_launch, done)

    def _browse_dispatch(self):
        cur = self.var_dispatch.get().strip()
        f = filedialog.askopenfilename(title="Fichier Avionics Dispatch", parent=self,
                                       initialdir=os.path.dirname(cur) if cur else None,
                                       filetypes=[("Page web", "*.html *.htm"), ("Tous les fichiers", "*.*")])
        if f:
            self.var_dispatch.set(os.path.normpath(f))

    def _detect_streamed_ui(self):
        d = detect_streamed(self.var_comm.get().strip() or self.cfg["community"])
        if d:
            self.var_streamed.set(d)
        else:
            messagebox.showinfo(APP, "Dossier StreamedPackages introuvable automatiquement.\n\nIl se trouve en "
                                     "général à côté de ton dossier Community. Indique-le avec « Parcourir ».")

    def _detect(self):
        c = detect_community()
        if c:
            self.var_comm.set(c)
        else:
            messagebox.showinfo(APP, "Dossier Community introuvable automatiquement.\nIndique-le avec « Parcourir ».")

    def _settings_changed(self):
        return bool(getattr(self, "_set_vars", None)) and [v.get() for v in self._set_vars] != self._set_saved

    def _settings_dirty(self):
        if not getattr(self, "btn_save", None):
            return
        if self._settings_changed():
            self.btn_save.config(style="Accent.TButton")
            self.lbl_save.config(text=T("● Modifications non enregistrées : clique sur Enregistrer"),
                                 foreground=C["warn"])
        else:
            self.btn_save.config(style="TButton")
            self.lbl_save.config(text=T("Enregistrer valide les dossiers et chemins. Les cases, les écrans et "
                                        "la clé FSHub s'appliquent tout de suite."), foreground=C["muted"])

    def _revert_settings(self):
        for v, val in zip(self._set_vars, self._set_saved):
            v.set(val)

    def save_settings(self):
        if self._sim_locked():
            return
        lib = self.var_lib.get().strip()
        comm = self.var_comm.get().strip()
        if lib and comm and (inside(lib, comm) or inside(comm, lib)):
            messagebox.showerror(APP, "La bibliothèque et le dossier Community doivent être deux dossiers séparés "
                                      "(l'un ne peut pas être à l'intérieur de l'autre).")
            return
        if self.st["links"] and comm and self.cfg["community"] and not same_path(comm, self.cfg["community"]):
            if not messagebox.askyesno(APP, "Des liens existent dans l'ancien dossier Community. "
                                            "Ils n'y seront plus gérés. Continuer ?"):
                return
        self.cfg.update(library=lib, community=comm, sim_exe=self.var_exe.get().strip(),
                        streamed=self.var_streamed.get().strip(),
                        dispatch_file=self.var_dispatch.get().strip(),
                        msfs_launch=self.var_msfs.get().strip())
        self._dup_streamed = None
        self.save_cfg()
        self._set_saved = [v.get() for v in self._set_vars]
        self._settings_dirty()
        self.set_status("Réglages enregistrés.")
        self.rescan()

    # ---- bibliothèque
    def rescan(self, on_done=None):
        lib = self.cfg["library"]
        if not lib or not os.path.isdir(lib):
            self.packages = []
            self.refresh_library()
            self.refresh_flight()
            self.set_status("Indique le dossier de ta bibliothèque dans l'onglet Réglages.")
            return
        self.set_status("Analyse de la bibliothèque…")

        self._scanning += 1

        def work():
            return [scan_package(p) for p in find_packages(lib)], lib_signature(lib)

        def done(out, err):
            self._scanning -= 1
            if err:
                self.set_status("Erreur d'analyse : %s" % err)
                return
            res, self._lib_sig = out
            for p in res:
                self._apply_override(p)
            res.sort(key=lambda p: p["name"].lower())
            self.packages = res
            self.checked &= {p["path"] for p in res}
            n_apt = sum(1 for p in res if p["icao"])
            self.set_status("%d add-ons trouvés, dont %d scènes d'aéroport reconnues." % (len(res), n_apt))
            self.refresh_library()
            self.refresh_flight()
            self.check_health()
            if on_done:
                on_done()

        self.run_bg(work, done)

    def _apply_override(self, p):
        ov = self.cfg["overrides"].get(p["path"], {})
        p["icao_auto"] = list(p["icao"])
        if "icao" in ov:
            p["icao"] = list(ov["icao"])
        p["pinned"] = bool(ov.get("pinned", False))

    def _link_path(self, p):
        return os.path.normpath(os.path.join(self.cfg["community"], p["name"]))

    def comm_status(self, p):
        if not self.cfg["community"]:
            return "?"
        link = self._link_path(p)
        if not os.path.lexists(link):
            return "—"
        if link in self.st["links"]:
            return "Lié (vol)" if self.st["links"][link]["kind"] == "flight" else "Lié"
        if is_link(link):
            return "Lien externe"
        return "Copie réelle"

    def refresh_library(self):
        tv = self.tv_lib
        was_open = {i: tv.item(i, "open") for i in self._iter_nodes() if i.startswith("grp:")}
        tv.delete(*tv.get_children())
        q = self.var_search.get().strip().lower()
        flt = self.var_filter.get()
        flt = next((x for x in self._filters if T(x) == flt), flt)  # libellé affiché -> valeur interne
        lib = self.cfg["library"]
        rows = []
        n_active = 0
        for p in self.packages:
            st = self.comm_status(p)
            if st != "—":
                n_active += 1
            if q and q not in (p["name"] + " " + p["title"] + " " + " ".join(p["icao"])).lower():
                continue
            if flt == "Scènes d'aéroport" and not p["icao"]:
                continue
            if flt == "Protégés ★" and not p["pinned"]:
                continue
            if flt == "Présents dans Community" and st == "—":
                continue
            if flt == "Absents de Community" and st != "—":
                continue
            rel = ""
            if lib:
                try:
                    rel = os.path.relpath(os.path.dirname(p["path"]), lib)
                except ValueError:
                    rel = ""
            if rel == os.curdir:
                rel = ""
            rows.append((rel, p, st))

        self._grp_name = {}

        def grp(rel):
            if not rel:
                return ""
            iid = "grp:" + rel
            if not tv.exists(iid):
                parent = grp(os.path.dirname(rel))
                tv.insert(parent, "end", iid=iid, text=" " + os.path.basename(rel), tags=("group",),
                          open=was_open.get(iid, bool(q)), image=self._img["off"])
                self._grp_name[iid] = os.path.basename(rel)
            return iid

        for rel in sorted({r[0] for r in rows}, key=str.lower):
            grp(rel)
        for rel, p, st in rows:
            tv.insert(grp(rel), "end", iid=p["path"], text=" " + p["name"], image=self._img["off"],
                      tags=("active",) if st != "—" else (),
                      values=(p["title"], p["type"].title(), p.get("version", ""), ", ".join(p["icao"]),
                              "★" if p["pinned"] else "", st))
        self._update_marks()

        free = ""
        if lib and os.path.isdir(lib):
            try:
                free = " · %.0f Go libres" % (shutil.disk_usage(lib).free / 1e9)
            except OSError:
                pass
        self.lbl_lib_head.config(text="Bibliothèque — %d add-ons, %d dans Community%s"
                                 % (len(self.packages), n_active, free))
        self.refresh_community()
        self._push_map()

    # ---- arbre et cases à cocher
    def _iter_nodes(self, parent=""):
        for c in self.tv_lib.get_children(parent):
            yield c
            yield from self._iter_nodes(c)

    def _leaves(self, iid):
        if not iid.startswith("grp:"):
            yield iid
            return
        for c in self.tv_lib.get_children(iid):
            yield from self._leaves(c)

    def _all_leaves(self):
        out = []
        for top in self.tv_lib.get_children(""):
            out.extend(self._leaves(top))
        return out

    def _selected_leaves(self):
        out = []
        for iid in self.tv_lib.selection():
            for leaf in self._leaves(iid):
                if leaf not in out:
                    out.append(leaf)
        return out

    def _update_marks(self, parent=""):
        """Met à jour cases et compteurs ; renvoie (cochés, dans Community, total) du sous-arbre."""
        tv = self.tv_lib
        tot_c = tot_a = tot = 0
        for iid in tv.get_children(parent):
            if iid.startswith("grp:"):
                c, a, t = self._update_marks(iid)
                if c:
                    state = "on" if c == t else "part"
                else:
                    state = "act" if t and a == t else ("actpart" if a else "off")
                tv.item(iid, image=self._img[state],
                        text=" %s (%d / %d)" % (self._grp_name.get(iid, ""), a, t))
            else:
                on = iid in self.checked
                tags = [x for x in (tv.item(iid, "tags") or ()) if x != "checked"]
                c, t = int(on), 1
                a = 1 if "active" in tags else 0
                state = ("act_on" if a else "on") if on else ("act" if a else "off")
                tv.item(iid, image=self._img[state], tags=tags + (["checked"] if on else []))
            tot_c += c
            tot_a += a
            tot += t
        if parent == "":
            self._update_checked_label()
        return tot_c, tot_a, tot

    def _update_checked_label(self):
        n = len(self.checked)
        nsel = len(self._selected_leaves())
        if nsel:
            self.lbl_checked.config(text="%d scène%s surlignée%s (prioritaire sur les cases) · Échap pour annuler"
                                         % (nsel, "s" if nsel > 1 else "", "s" if nsel > 1 else ""))
        else:
            if self.cfg.get("colorblind"):
                self.lbl_checked.config(text="%d coché%s · case orange ✓ = dans Community, bleue = cochée" % (n, "s" if n > 1 else ""))
            else:
                self.lbl_checked.config(text="%d coché%s · ✓ vert = dans Community" % (n, "s" if n > 1 else ""))
        pk, src = self._targets()
        present = sum(1 for p in pk if self.comm_status(p) != "—")
        absent = len(pk) - present

        def nb(k):
            if src == "sel":
                return "%d add-on%s surligné%s" % (k, "s" if k > 1 else "", "s" if k > 1 else "")
            return "%d add-on%s coché%s" % (k, "s" if k > 1 else "", "s" if k > 1 else "")

        if absent:
            act = "▶  Activer %s dans Community" % nb(absent)
        elif present:
            act = "✓  Tous déjà actifs" if present > 1 else "✓  Déjà actif"
        else:
            act = "▶  Activer dans Community"
        if present:
            rem = "🗑  Retirer %s de Community" % nb(present)
        elif absent:
            rem = "🗑  Aucun dans Community"
        else:
            rem = "🗑  Retirer de Community"
        self.btn_activate.config(text=act)
        self.btn_remove.config(text=rem)
        self.btn_quar.config(text="⚠  Mettre %s en quarantaine" % nb(len(pk)) if pk
                             else "⚠  Mettre en quarantaine")

    def _set_many(self, leaves, on):
        for leaf in leaves:
            if on:
                self.checked.add(leaf)
            else:
                self.checked.discard(leaf)
        self._update_marks()

    def _lib_click(self, e):
        tv = self.tv_lib
        iid = tv.identify_row(e.y)
        if iid and "image" not in str(tv.identify_element(e.x, e.y)):
            ctrl = bool(e.state & 0x0004)
            if not ctrl:
                # clic simple : ne vise rien (seuls Ctrl+clic et les cases désignent des scènes).
                # Sur un dossier, un simple clic l'ouvre ou le referme.
                tv.selection_remove(*tv.selection())
                tv.focus(iid)
                if iid.startswith("grp:"):
                    tv.item(iid, open=not tv.item(iid, "open"))
                self._update_checked_label()
                return "break"
            return None
        if not iid:
            return None
        leaves = list(self._leaves(iid))
        self._set_many(leaves, not all(x in self.checked for x in leaves))
        return "break"

    def _lib_double(self, e):
        # pas d'action au double-clic : le second clic est traité comme un simple clic
        return self._lib_click(e)

    def _lib_space(self, _e):
        leaves = self._selected_leaves()
        if leaves:
            self._set_many(leaves, not all(x in self.checked for x in leaves))
        return "break"

    def check_all(self):
        self._set_many(self._all_leaves(), True)

    def uncheck_all(self):
        self.checked.clear()
        self._update_marks()

    def _expand_all(self, opened):
        for iid in self._iter_nodes():
            if iid.startswith("grp:"):
                self.tv_lib.item(iid, open=opened)

    def _checked_pkgs(self):
        return [p for p in self.packages if p["path"] in self.checked]

    def _targets(self):
        """Add-ons visés par les boutons : les lignes surlignées s'il y en a, sinon les cases cochées."""
        sel = set(self._selected_leaves())
        if sel:
            return [p for p in self.packages if p["path"] in sel], "sel"
        return self._checked_pkgs(), "chk"

    def _clear_highlight(self, _e=None):
        self.tv_lib.selection_remove(*self.tv_lib.selection())
        return "break"

    def _lib_click_empty(self, e):
        if not self.tv_lib.identify_row(e.y):
            self._clear_highlight()

    def _run_batch(self, pkgs, fn, kind, done):
        """Traite les add-ons un par un avec une fine barre de progression sous chaque ligne.
        fn(p) renvoie un texte de résultat ou lève OSError ; done(résultats) est appelé à la fin."""
        tv = self.tv_lib
        self._batch_running = True
        style = "Inst.Horizontal.TProgressbar" if kind == "install" else "Rem.Horizontal.TProgressbar"
        label = "⏳ installation…" if kind == "install" else "⏳ retrait…"
        bars = {}
        tv.update_idletasks()
        width = max(tv.winfo_width() - 4, 50)
        for p in pkgs:
            iid = p["path"]
            if not tv.exists(iid):
                continue
            tv.item(iid, tags=list(tv.item(iid, "tags") or ()) + ["busy"])
            tv.set(iid, "comm", label)
            bb = tv.bbox(iid)
            if bb:
                pb = ttk.Progressbar(tv, style=style, maximum=100, value=0, mode="determinate")
                pb.place(x=2, y=bb[1] + bb[3] - 3, width=width, height=3)
                bars[iid] = pb
        results = []
        state = {"i": 0}
        n = len(pkgs)

        def finish():
            for pb in bars.values():
                try:
                    pb.destroy()
                except tk.TclError:
                    pass
            self._batch_running = False
            done(results)

        def step():
            k = state["i"]
            if k >= n:
                self.after(450, finish)
                return
            p = pkgs[k]
            pb = bars.get(p["path"])
            if pb:
                pb["value"] = 35
                tv.update_idletasks()
            try:
                results.append((p, fn(p), None))
            except OSError as e:
                results.append((p, None, e))
            if pb:
                pb["value"] = 100
            if tv.exists(p["path"]):
                tv.set(p["path"], "comm", "✔ fait" if results[-1][2] is None else "✖ erreur")
            state["i"] = k + 1
            self.set_status("%s : %d / %d…" % ("Installation" if kind == "install" else "Retrait", k + 1, n))
            self.after(70, step)

        self.after(30, step)

    def activate_checked(self, pkgs=None):
        if self._sim_locked() or self._batch_running:
            return
        pk = pkgs if pkgs is not None else self._targets()[0]
        if not pk:
            messagebox.showinfo(APP, "Surligne ou coche d'abord les add-ons à activer.")
            return
        if not self._check_comm():
            return
        pk = [p for p in pk if self.comm_status(p) == "—"]
        if not pk:
            self.set_status("Les add-ons cochés sont déjà dans Community.")
            return
        parked = {os.path.normcase(os.path.normpath(e.get("target", ""))) for e in (self.st.get("parked") or [])}
        n_parked = sum(1 for p in pk if os.path.normcase(os.path.normpath(p["path"])) in parked)
        if n_parked and not messagebox.askyesno(
                APP, "Un vol est préparé en mode « Ne charger que les scènes du vol ».\n\n"
                     "%d de ces add-ons sont des scènes mises de côté pour ce vol : les activer maintenant "
                     "les recharge dans le simulateur.\n\nActiver quand même ?" % n_parked, icon="warning"):
            return

        def done(results):
            n = errors = 0
            done_pk = []
            for p, res, err in results:
                if err:
                    errors += 1
                    self.log("Erreur pour %s : %s" % (p["name"], err))
                elif res == "lié":
                    n += 1
                    done_pk.append(p)
                    self.log("Activé : %s" % p["name"])
            if done_pk:
                self._set_undo("activate", [{"path": p["path"], "pinned": False} for p in done_pk])
            self.save_st()
            self.checked.clear()   # la sélection ne doit pas faire croire que des add-ons restent « présents »
            self.refresh_library()
            self.refresh_flight()
            msg = "%d add-on(s) activé(s)." % n
            if errors:
                msg += " %d erreur(s) — voir le journal (onglet Vol)." % errors
            elif sim_running(self.cfg["sim_exe"]):
                msg += " Redémarre le simulateur pour les charger."
            self.set_status(msg)

        self._run_batch(pk, lambda p: self._link(p, "manual"), "install", done)

    # ---- profils (ensembles d'add-ons à activer en un clic)
    def _pkg_folder(self, p):
        try:
            rel = os.path.relpath(os.path.dirname(p["path"]), self.cfg["library"])
        except ValueError:
            return ""
        return "" if rel in (".", "") else os.path.normpath(rel)

    def _profiles(self):
        return self.cfg.setdefault("profiles", [])

    def _profile_capture(self, pkgs):
        """Sélection -> (dossiers entiers, add-ons à l'unité). Un dossier entièrement sélectionné est gardé comme
        dossier : ce que tu y ajoutes plus tard fera aussi partie du profil."""
        sel = {q["path"] for q in pkgs}
        by_folder = {}
        for q in self.packages:
            f = self._pkg_folder(q)
            parts = f.split(os.sep) if f else []
            for i in range(1, len(parts) + 1):
                by_folder.setdefault(os.sep.join(parts[:i]), []).append(q["path"])
        full = sorted((f for f, paths in by_folder.items() if paths and all(x in sel for x in paths)),
                      key=lambda f: f.count(os.sep))
        folders = []
        for f in full:
            if not any(f == g or f.startswith(g + os.sep) for g in folders):
                folders.append(f)
        covered = {x for f in folders for x in by_folder[f]}
        addons = sorted(q["name"] for q in pkgs if q["path"] not in covered)
        return folders, addons

    def _profile_resolve(self, prof):
        names = set(prof.get("addons") or [])
        folders = [os.path.normpath(f) for f in (prof.get("folders") or [])]
        out = []
        for q in self.packages:
            f = self._pkg_folder(q)
            if q["name"] in names or any(f == g or f.startswith(g + os.sep) for g in folders):
                out.append(q)
        missing = sorted(names - {q["name"] for q in out})
        return out, missing

    def _is_airport_pkg(self, q):
        if not self.airport_icaos(q):
            return False
        manual = "icao" in self.cfg["overrides"].get(q["path"], {})
        return manual or not is_decor_pack(q["name"] + " " + q.get("title", ""))

    def _profile_plan(self, prof):
        """Ce que l'activation du profil va faire : (à lier, à retirer [(package, ancien type)], manquants)."""
        want, missing = self._profile_resolve(prof)
        want_paths = {q["path"] for q in want}
        by_path = {os.path.normcase(os.path.normpath(q["path"])): q for q in self.packages}
        scope_all = prof.get("scope") == "all"
        ignore_pin = bool(prof.get("ignore_pinned"))
        to_unlink = []
        for link, v in list(self.st["links"].items()):
            q = by_path.get(os.path.normcase(os.path.normpath(v.get("target", ""))))
            if not q or q["path"] in want_paths:
                continue
            if v["kind"] == "pinned" or q.get("pinned"):
                if not ignore_pin:
                    continue
            elif v["kind"] != "manual":
                continue
            if not scope_all and not self._is_airport_pkg(q):
                continue
            to_unlink.append((q, v["kind"]))
        to_link = [q for q in want if self.comm_status(q) == "—"]
        return to_link, to_unlink, missing

