                          command=lambda: act_addon(False))
            m.add_command(label="▶  Activer l'add-on", state=self._st(free and selected("addon")),
                          command=lambda: act_addon(True))
            try:
                m.tk_popup(e.x_root, e.y_root)
            finally:
                m.grab_release()

        tv.bind("<Button-3>", menu)
        fill()
        if self._dup_streamed is None:
