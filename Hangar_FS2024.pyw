def find_content_xml(community=""):
    """Fichier Content.xml de MSFS 2024 (état activé / désactivé de chaque contenu dans My Library).
    Store : LocalCache\\<compte Xbox>\\Content.xml ; Steam : AppData\\Roaming\\Microsoft Flight Simulator 2024."""
    local = os.environ.get("LOCALAPPDATA", "")
    roaming = os.environ.get("APPDATA", "")
    bases = []
    if community:   # …\\LocalCache\\Packages\\Community -> …\\LocalCache
        bases.append(os.path.dirname(os.path.dirname(os.path.normpath(community))))
    bases += [os.path.join(local, "Packages", "Microsoft.Limitless_8wekyb3d8bbwe", "LocalCache"),
              os.path.join(roaming, "Microsoft Flight Simulator 2024")]
    found = []
    for b in bases:
        try:
            if not b or not os.path.isdir(b):
                continue
            dirs = [b] + [e.path for e in os.scandir(b) if e.is_dir(follow_symlinks=False)
                          and e.name.lower() not in ("packages", "sceneryindexes", "simobjects", "pc", "$pcs")]
        except OSError:
            continue
        for d in dirs:
            f = os.path.join(d, "Content.xml")
            try:
                if os.path.isfile(f):
                    found.append((os.path.getmtime(f), os.path.normpath(f)))
            except OSError:
                pass
    return max(found)[1] if found else ""


def _known_folder(csidl, fallback):
    """Dossier Windows de l'utilisateur (Bureau, Documents…), même déplacé vers OneDrive."""
    if IS_WIN:
        try:
            buf = ctypes.create_unicode_buffer(260)
            if ctypes.windll.shell32.SHGetFolderPathW(None, csidl, None, 0, buf) == 0 and buf.value:
                return buf.value
        except (OSError, AttributeError):
            pass
    return os.path.join(os.path.expanduser("~"), fallback)


def point_on_screen(x, y):
    """Vrai si le point (x, y) est sur un écran branché (Windows) ; ailleurs, on suppose que oui."""
    if not IS_WIN:
        return True
    try:
        class _PT(ctypes.Structure):
            _fields_ = [("x", ctypes.c_long), ("y", ctypes.c_long)]
        return bool(ctypes.windll.user32.MonitorFromPoint(_PT(int(x), int(y)), 0))
    except (OSError, AttributeError, ValueError):
        return True


