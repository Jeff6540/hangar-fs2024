        row = ttk.Frame(fr)
        row.pack(fill="x", pady=(10, 0))
        self._lk(ttk.Button(row, text="🛠  Réparer tout", style="Accent.TButton", command=repair)).pack(side="left")
        ttk.Button(row, text="Fermer", command=win.destroy).pack(side="right")

    def _repair(self, issues):
        fixed = errors = 0
        for it in issues:
            k = it["kind"]
            try:
                if k == "forget":
                    self.st["links"].pop(it["link"], None)
                elif k == "missing":
                    remove_link(it["link"])
                    self.st["links"].pop(it["link"], None)
                elif k == "moved":
                    remove_link(it["link"])
                    self.st["links"].pop(it["link"], None)
                    make_link(it["new"], it["link"])
                    self.st["links"][it["link"]] = {"target": it["new"], "kind": it["link_kind"]}
                elif k == "default_orphan":
                    path = os.path.join(self.cfg["community"], it["name"]) if self.cfg["community"] else ""
                    if path and os.path.isdir(path) and not is_link(path):
                        os.rmdir(path)  # dossier vide uniquement
                    self.st.get("default_off", {}).pop(it["name"], None)
                elif k == "settings":
                    old = self.cfg["overrides"].pop(it["old"], {})
                    merged = dict(old)
                    merged.update(self.cfg["overrides"].get(it["new"], {}))
                    self.cfg["overrides"][it["new"]] = merged
                fixed += 1
                self.log("Réparé : %s — %s" % (it["name"], it["fix"]))
            except OSError as e:
                errors += 1
                self.log("Réparation impossible pour %s : %s" % (it["name"], e))
        self.save_cfg()
        self.save_st()
        self.set_status("%d problème(s) réparé(s)%s." % (fixed, ", %d erreur(s) — voir le journal" % errors if errors else ""))
        self.rescan()

    def remove_comm_selected(self):
        if self._sim_locked():
            return
        sel = list(self.tv_comm.selection())
        if not sel:
            messagebox.showinfo(APP, "Sélectionne d'abord des add-ons dans la liste Community "
                                     "(Ctrl ou Maj + clic pour en prendre plusieurs).")
            return
        links = [p for p in sel if is_link(p)]
        real = len(sel) - len(links)
        if not links:
            messagebox.showinfo(APP, "La sélection ne contient que des vraies copies : "
                                     "déplace-les à la main vers ta bibliothèque.")
            return
        msg = "Retirer %d lien(s) du dossier Community ?\n\nLes fichiers d'origine ne sont pas touchés." % len(links)
        if real:
            msg += "\n%d vraie(s) copie(s) seront ignorée(s)." % real
        if sim_running(self.cfg["sim_exe"]):
            msg += "\n\nAttention : le simulateur est lancé."
        if not messagebox.askyesno(APP, msg, icon="warning"):
            return
        by_link = {self._link_path(p): p for p in self.packages}
        removed = errors = 0
        for link in links:
            try:
                self._unlink(link)
                removed += 1
                self.log("Retiré de Community : %s" % os.path.basename(link))
            except OSError as e:
                errors += 1
                self.log("Erreur en retirant %s : %s" % (os.path.basename(link), e))
                continue
            p = by_link.get(link)
            if p:
                self.checked.discard(p["path"])
            if p and p["pinned"]:
                p["pinned"] = False
                self.cfg["overrides"].setdefault(p["path"], {})["pinned"] = False
        self.save_cfg()
        self.save_st()
        self.refresh_library()
        self.refresh_flight()
        self.set_status("%d lien(s) retiré(s) de Community.%s"
                        % (removed, " %d erreur(s) — voir le journal." % errors if errors else ""))

    # ---- quarantaine
    def _quar_dir(self):
        lib = self.cfg["library"]
        return os.path.join(lib, QUAR_NAME) if lib else ""

    def quarantine_checked(self, pkgs=None):
        if self._sim_locked():
            return
        pk = pkgs if pkgs is not None else self._targets()[0]
        if not pk:
            messagebox.showinfo(APP, "Surligne ou coche d'abord les add-ons à mettre en quarantaine.")
            return
        names = "\n".join("• " + p["name"] for p in pk[:12]) + ("\n• …" if len(pk) > 12 else "")
        msg = ("Mettre %d add-on(s) en quarantaine ?\n\n%s\n\n"
               "Ils seront retirés de Community et déplacés dans le dossier « %s » de ta bibliothèque. "
               "Rien n'est effacé : tu pourras les restaurer à tout moment." % (len(pk), names, QUAR_NAME))
        if sim_running(self.cfg["sim_exe"]):
            msg += "\n\nAttention : le simulateur est lancé, ferme-le d'abord."
        if not messagebox.askyesno(APP, msg, icon="warning"):
            return
        qdir = self._quar_dir()
        try:
            os.makedirs(qdir, exist_ok=True)
        except OSError as e:
            messagebox.showerror(APP, "Impossible de créer le dossier de quarantaine : %s" % e)
            return
        quar = self.st.setdefault("quarantine", {})
        moved = errors = 0
        for p in pk:
            link = self._link_path(p) if self.cfg["community"] else ""
            if link and os.path.lexists(link) and is_link(link) and same_path(link_target(link), p["path"]):
                try:
                    self._unlink(link)
                except OSError as e:
                    errors += 1
                    self.log("Erreur en retirant %s de Community : %s" % (p["name"], e))
                    continue
            dest = os.path.join(qdir, p["name"])
            i = 2
            while os.path.lexists(dest):
                dest = os.path.join(qdir, "%s (%d)" % (p["name"], i))
                i += 1
            try:
                shutil.move(p["path"], dest)
            except (OSError, shutil.Error) as e:
                errors += 1
                self.log("Impossible de déplacer %s : %s" % (p["name"], e))
                continue
            entry = {"origin": p["path"], "date": time.strftime("%d/%m/%Y %H:%M")}
            ov = self.cfg["overrides"].pop(p["path"], None)
            if ov:
                entry["override"] = ov
            quar[os.path.normpath(dest)] = entry
            moved += 1
            self.log("Mis en quarantaine : %s" % p["name"])
        self.save_cfg()
        self.save_st()
        self.checked.clear()
        self.rescan()
        if errors:
            messagebox.showwarning(APP, "%d add-on(s) en quarantaine, %d erreur(s) — voir le journal (onglet Vol)."
                                   % (moved, errors))

    def show_quarantine(self):
        qdir = self._quar_dir()
        if not qdir:
            messagebox.showinfo(APP, "Indique d'abord ta bibliothèque dans l'onglet Réglages.")
            return
        win = tk.Toplevel(self)
        win.title("Quarantaine")
        win.configure(bg=C["bg"])
        win.geometry("860x440")
        self._place_win(win)
        win.transient(self)
        fr = ttk.Frame(win, padding=12)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text="Add-ons en quarantaine", style="Head.TLabel").pack(anchor="w")
        ttk.Label(fr, text="Ils n'apparaissent plus dans la bibliothèque et ne sont plus chargés par le "
                           "simulateur. Restaure-les quand le souci est réglé, ou supprime-les toi-même "
                           "depuis le dossier.", style="Muted.TLabel", wraplength=820).pack(anchor="w", pady=(2, 8))
        tv = ttk.Treeview(fr, columns=("nom", "origine", "date"), show="headings", selectmode="extended")
        for c, t, w in (("nom", "Nom", 260), ("origine", "Dossier d'origine", 380), ("date", "Mis de côté le", 140)):
            tv.heading(c, text=t, anchor="w")
            tv.column(c, width=w, anchor="w")
        tv.pack(fill="both", expand=True)
        quar = self.st.setdefault("quarantine", {})

        def fill():
            tv.delete(*tv.get_children())
            lib = self.cfg["library"]
            try:
                names = sorted(os.listdir(qdir), key=str.lower) if os.path.isdir(qdir) else []
            except OSError:
                names = []
            for name in names:
                path = os.path.normpath(os.path.join(qdir, name))
                if not os.path.isdir(path):
                    continue
                info = quar.get(path, {})
                origin = info.get("origin", "")
                where = "?"
                if origin:
                    try:
                        where = os.path.relpath(os.path.dirname(origin), lib)
                        where = "(racine)" if where == os.curdir else where
                    except ValueError:
                        where = os.path.dirname(origin)
                tv.insert("", "end", iid=path, values=(name, where, info.get("date", "")))

        def restore():
            if self._sim_locked():
                return
            sel = tv.selection()
            if not sel:
                return
            lib = self.cfg["library"]
            errors = 0
            for path in sel:
                info = quar.get(path, {})
                origin = info.get("origin") or os.path.join(lib, os.path.basename(path))
                if os.path.lexists(origin):
                    errors += 1
                    self.log("Restauration impossible, un dossier existe déjà : %s" % origin)
                    continue
                try:
                    os.makedirs(os.path.dirname(origin), exist_ok=True)
                    shutil.move(path, origin)
                except (OSError, shutil.Error) as e:
                    errors += 1
                    self.log("Restauration impossible pour %s : %s" % (os.path.basename(path), e))
                    continue
                if "override" in info:
                    self.cfg["overrides"][origin] = info["override"]
                quar.pop(path, None)
                self.log("Restauré : %s" % os.path.basename(origin))
            self.save_cfg()
            self.save_st()
            fill()
            self.rescan()
            if errors:
                messagebox.showwarning(APP, "%d add-on(s) n'ont pas pu être restaurés — voir le journal." % errors,
                                       parent=win)

        row = ttk.Frame(fr)
        row.pack(fill="x", pady=(10, 0))
        self._lk(ttk.Button(row, text="↩  Restaurer la sélection", style="Accent.TButton", command=restore)).pack(side="left")
        ttk.Button(row, text="Ouvrir le dossier", command=lambda: open_folder(qdir)).pack(side="left", padx=6)
        ttk.Button(row, text="Fermer", command=win.destroy).pack(side="right")
        fill()

    def toggle_pinned(self):
        by = {p["path"]: p for p in self.packages}
        targets = [by[i] for i in (self._selected_leaves() or list(self.checked)) if i in by]
        if targets:
            self.set_pinned(not all(p["pinned"] for p in targets))

    def set_pinned(self, new):
        """★ Protéger : l'add-on est lié et jamais retiré ni mis de côté par un vol.
        ☆ Ne plus protéger : seule la protection est enlevée, l'add-on reste dans Community comme un lien normal."""
        if self._sim_locked():
            return
        by = {p["path"]: p for p in self.packages}
        used = [by[i] for i in (self._selected_leaves() or list(self.checked)) if i in by]
        targets = [p for p in used if bool(p["pinned"]) != new]
        if new and self.st.get("pin_suspended"):
            self.st["pin_suspended"] = [x for x in self.st["pin_suspended"] if x not in {q["path"] for q in used}]
        # ★ / ☆ ne prépare aucune autre action : les add-ons utilisés sont décochés et désélectionnés,
        # leur case redevient verte (dans Community) et rien n'est proposé au retrait
        for p in used:
            self.checked.discard(p["path"])
        try:
            self.tv_lib.selection_remove(*[p["path"] for p in used if self.tv_lib.exists(p["path"])])
        except tk.TclError:
            pass
        if not targets:
            self._update_marks()
            self.set_status("Rien à changer : sélectionne ou coche des add-ons." if not used else
                            ("Déjà protégé(s) ★." if new else "Déjà sans protection."))
            return
        for p in targets:
            p["pinned"] = new
            self.cfg["overrides"].setdefault(p["path"], {})["pinned"] = new
        self.save_cfg()
        if self.cfg["community"] and os.path.isdir(self.cfg["community"]):
            errs = self._sync_pinned()
            self.save_st()
            if errs:
                self.set_status("%d erreur(s) — voir le journal (onglet Vol)." % errs)
            elif new:
                self.set_status("%d add-on(s) protégé(s) ★." % len(targets))
            else:
                self.set_status("%d add-on(s) ne sont plus protégés (ils restent dans Community)." % len(targets))
        self.refresh_library()

    def edit_icao(self):
        sel = [i for i in self.tv_lib.selection() if not i.startswith("grp:")]
        if len(sel) != 1:
            messagebox.showinfo(APP, "Sélectionne un seul add-on.")
            return
        p = next((x for x in self.packages if x["path"] == sel[0]), None)
        if not p:
            return
        s = simpledialog.askstring(
            APP,
            "Codes OACI couverts par « %s »\n(séparés par des espaces ; vide = détection auto ; « - » = aucun)\n\n"
            "Détection auto : %s" % (p["name"], ", ".join(p["icao_auto"]) or "aucun"),
            initialvalue=" ".join(p["icao"]), parent=self)
        if s is None:
            return
        ov = self.cfg["overrides"].setdefault(p["path"], {})
        if s.strip() == "-":
            ov["icao"] = []
            p["icao"] = []
        else:
            codes = []
            for t in re.findall(r"[A-Za-z0-9]{3,4}", s.upper()):
                if t not in codes:
                    codes.append(t)
            if codes:
                ov["icao"] = codes
                p["icao"] = codes
            else:
                ov.pop("icao", None)
                p["icao"] = list(p["icao_auto"])
        self.save_cfg()
        self.refresh_library()
        self.refresh_flight()

    # ---- liens
    def _link(self, p, kind):
        if not os.path.isdir(p["path"]):
            if not self._rescan_queued:
                self._rescan_queued = True
                self.after(300, self._queued_rescan)
            raise OSError("dossier introuvable dans la bibliothèque (supprimé ou déplacé) — actualisation lancée")
        link = self._link_path(p)
        if os.path.lexists(link):
            ours = link in self.st["links"]
            if is_link(link) and same_path(link_target(link), p["path"]):
                if ours:
                    cur = self.st["links"][link]["kind"]
                    if LINK_RANK.get(kind, 0) > LINK_RANK.get(cur, 0):
                        self.st["links"][link]["kind"] = kind
                    return "déjà lié"
                return "déjà présent (lien externe, non géré)"
            if ours and is_link(link):  # notre ancien lien vers un autre emplacement : on le refait
                self._unlink(link)
            else:
                raise OSError("un dossier du même nom existe déjà dans Community")
        make_link(p["path"], link)
        self.st["links"][link] = {"target": p["path"], "kind": kind}
        return "lié"

    def _queued_rescan(self):
        self._rescan_queued = False
        self.rescan()

    def _unlink(self, link):
        remove_link(link)
        self.st["links"].pop(link, None)

    def _sync_pinned(self):
        if not self.packages:  # bibliothèque pas encore analysée : on ne touche à rien
            return 0
        errors = 0
        suspended = set(self.st.get("pin_suspended") or [])   # profil « sans les protégés » en cours
        pinned = {self._link_path(p): p for p in self.packages if p["pinned"] and p["path"] not in suspended}
        fl = self.st.get("flight")
        flight_links = {self._link_path(p) for p in self.packages_for(fl["icaos"])} if fl else set()
        for link, v in list(self.st["links"].items()):
            if v["kind"] == "pinned" and link not in pinned:
                # plus protégé : le lien reste dans Community, comme un lien normal (mis de côté au besoin par un vol)
                v["kind"] = "flight" if link in flight_links else "manual"
                self.log("Plus protégé (reste dans Community) : %s" % os.path.basename(link))
        for link, p in pinned.items():
            try:
                if self._link(p, "pinned") == "lié":
                    self.log("Protégé : %s — lié" % p["name"])
            except OSError as e:
                errors += 1
                self.log("Erreur pour %s : %s" % (p["name"], e))
        return errors

    # ---- vol
    def active_icaos(self):
        if not self.plan:
            return []
        return [a["icao"] for a in self.plan["airports"] if a["primary"] or self.var_alt.get()]

    def packages_for(self, icaos):
        s = set(icaos)
        return [p for p in self.packages if s.intersection(self.airport_icaos(p))]

    def refresh_flight(self):
        self._push_map()
        tv = self.tv_apt
        tv.delete(*tv.get_children())
        if not self.plan:
            self.lbl_plan.config(text="Aucun plan de vol chargé.")
        else:
            p = self.plan
            txt = p["route"]
            if p.get("flight"):
                txt = p["flight"] + "    " + txt
            if p.get("aircraft"):
                txt += "    (%s)" % p["aircraft"]
            self.lbl_plan.config(text=txt)
            for a in p["airports"]:
                used = a["primary"] or self.var_alt.get()
                pk = self.packages_for([a["icao"]])
                scenes = ", ".join(x["title"] or x["name"] for x in pk) or "aucune — scène par défaut du simulateur"
                tags = ("off",) if not used else (("none",) if not pk else ())
                tv.insert("", "end", values=(a["role"], a["icao"], a["name"], scenes), tags=tags)
        fl = self.st.get("flight")
        n = sum(1 for v in self.st["links"].values() if v["kind"] == "flight")
        npk = len(self.st.get("parked") or [])
        if fl:  # scènes du vol présentes dans Community (liées pour le vol ou déjà actives avant)
            n = sum(1 for p in self.packages_for(fl.get("icaos", [])) if self._link_path(p) in self.st["links"]) or n
        txt = ("Vol actif : %s — %d scène(s) du vol chargée(s)" % (fl["route"], n)) if fl else "Aucun vol actif."
        if npk:
            txt += " · %d scène(s) d'aéroport mise(s) de côté" % npk
        self.lbl_flight.config(text=txt)

    def fetch_plan(self):
        user = self.var_user.get().strip()
        self.save_cfg()
        self.btn_fetch.config(state="disabled")
        self.set_status("Récupération du plan SimBrief…")

        def done(res, err):
            self.btn_fetch.config(state="normal")
            if err:
                self.set_status("Échec de la récupération SimBrief.")
                self.log(str(err))
                messagebox.showerror(APP, str(err))
                return
            res["fetched"] = int(time.time())
            self.plan = res
            self.st["plan"] = res
            self.save_st()
            self.set_status("Plan de vol chargé.")
            self.log("Plan chargé : %s (%s)" % (res["route"], ", ".join(a["icao"] for a in res["airports"])))
            self.refresh_flight()

        self.run_bg(lambda: fetch_simbrief(user), done)

    def _check_comm(self):
        comm = self.cfg["community"]
        if not comm or not os.path.isdir(comm):
            messagebox.showerror(APP, "Dossier Community introuvable. Vérifie l'onglet Réglages.")
            return False
        return True

    def _check_ready(self):
        if not self._check_comm():
            return False
        if not self.packages:
            messagebox.showerror(APP, "Aucun add-on dans la bibliothèque (ou analyse en cours). Vérifie l'onglet Réglages.")
            return False
        return True

    def prepare_flight(self):
        if self._sim_locked():
            return
        if not self.plan:
            messagebox.showinfo(APP, "Récupère d'abord ton plan de vol SimBrief.")
            return
        if not self._check_ready():
            return
        running = sim_running(self.cfg["sim_exe"])
        if running and not messagebox.askyesno(
                APP, "Le simulateur est déjà lancé : les scènes ne seront prises en compte "
                     "qu'au prochain démarrage.\n\nContinuer quand même ?"):
            return
        self.skip_next_exit = running

        icaos = self.active_icaos()
        wanted = self.packages_for(icaos)
        # Plusieurs scènes pour un même aéroport : on demande laquelle activer
        choice = self._ask_scenery_choice(icaos, wanted)
        if choice is None:
            return
        wanted, set_aside = choice
        wanted_links = {self._link_path(p) for p in wanted}
        errors = 0
        if set_aside:   # scènes non choisies déjà actives : mises de côté pendant le vol, remises à la fin
            errors += self._park_links(set_aside, "Mise de côté (autre scène choisie pour ce vol)")
        for link, v in list(self.st["links"].items()):
            if v["kind"] == "flight" and link not in wanted_links:
                try:
                    self._unlink(link)
                    self.log("Retiré (vol précédent) : %s" % os.path.basename(link))
                except OSError as e:
                    errors += 1
                    self.log("Erreur en retirant %s : %s" % (os.path.basename(link), e))
        if self.var_flight_only.get():
            errors += self._park_other_airports(wanted_links)
        self.st["flight"] = {"route": self.plan["route"], "icaos": icaos}
        for p in wanted:
            try:
                r = self._link(p, "flight")
                codes = ", ".join(i for i in icaos if i in p["icao"])
                self.log("%s : %s — %s" % (codes, p["name"], r))
            except OSError as e:
                errors += 1
                self.log("Erreur pour %s : %s" % (p["name"], e))
        errors += self._sync_pinned()
        missing = [i for i in icaos if not self.packages_for([i])]
        if missing:
            self.log("Sans scène add-on (scène par défaut) : " + ", ".join(missing))
        self.save_st()
        self.checked.clear()
        self._undo = None          # le vol a changé Community : on n'annule plus l'action d'avant
        self._update_undo_btn()
        self.refresh_flight()
        self.refresh_library()
        self.set_status("Vol prêt : tu peux lancer le simulateur." if not errors
                        else "Vol préparé avec %d erreur(s) — voir le journal." % errors)

    def _park_other_airports(self, wanted_links):
        """« Ne charger que les scènes du vol » : retire les liens des autres scènes d'aéroport activées à la main
        et les note pour les remettre à la fin du vol. Ne touche jamais aux add-ons ★ protégés, aux add-ons qui ne
        sont pas des aéroports, ni aux vrais dossiers ou liens externes de Community."""
        by_path = {os.path.normcase(os.path.normpath(p["path"])): p for p in self.packages}
        parked = self.st.setdefault("parked", [])
        known = {e["link"] for e in parked}
        moved, codes, errors = 0, [], 0
        for link, v in list(self.st["links"].items()):
            if v["kind"] != "manual" or link in wanted_links:
                continue
            p = by_path.get(os.path.normcase(os.path.normpath(v.get("target", ""))))
            if not p or p.get("pinned") or not self.airport_icaos(p):
                continue
            manual_codes = "icao" in self.cfg["overrides"].get(p["path"], {})
            if not manual_codes and is_decor_pack(p["name"] + " " + p.get("title", "")):
                continue   # pack de décor (pylônes, panneaux solaires…) : pas un aéroport, on n'y touche pas
            try:
                self._unlink(link)
            except OSError as e:
                errors += 1
                self.log("Erreur en mettant de côté %s : %s" % (os.path.basename(link), e))
                continue
            if link not in known:
                parked.append({"link": link, "target": v["target"]})
                known.add(link)
            moved += 1
            codes += [c for c in self.airport_icaos(p) if c not in codes][:1]
        if moved:
            more = "…" if len(codes) > 5 else ""
            self.log("Mis de côté (autres aéroports) : %d scène%s — %s%s" % (
                moved, "s" if moved > 1 else "", ", ".join(codes[:5]), more))
        return errors

    def _park_links(self, packages, why):
        """Retire pendant le vol les liens de ces add-ons (activés à la main) et les note pour les remettre."""
        parked = self.st.setdefault("parked", [])
        known = {e["link"] for e in parked}
        errors = 0
        for p in packages:
            link = self._link_path(p)
            v = self.st["links"].get(link)
            if not v or v["kind"] != "manual":
                continue
            try:
                self._unlink(link)
            except OSError as e:
                errors += 1
                self.log("Erreur en mettant de côté %s : %s" % (os.path.basename(link), e))
                continue
            if link not in known:
                parked.append({"link": link, "target": v["target"]})
                known.add(link)
            self.log("%s : %s" % (why, p["name"]))
        return errors

    def _ask_scenery_choice(self, icaos, wanted):
        """Pour chaque aéroport du vol qui a plusieurs scènes dans la bibliothèque, demande laquelle activer.
        Renvoie (scènes à lier, scènes actives à mettre de côté), ou None si l'utilisateur annule."""
        multi = []
        for icao in icaos:
            cands = [p for p in wanted if icao in self.airport_icaos(p)]
            if len(cands) > 1:
                multi.append((icao, cands))
        if not multi:
            return wanted, []
        memo = self.cfg.setdefault("scenery_choice", {})
        names = {a["icao"]: a.get("name", "") for a in (self.plan or {}).get("airports", [])}
        win = tk.Toplevel(self)
        win.title("Choisir les scènes du vol")
        win.configure(bg=C["bg"])
        win.transient(self)
        win.resizable(False, False)
        fr = ttk.Frame(win, padding=16)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text="Plusieurs scènes pour le même aéroport", style="Head.TLabel").pack(anchor="w")
        ttk.Label(fr, text="Choisis la scène à activer pour ce vol. Les autres restent dans ta bibliothèque ; "
                           "si l'une d'elles est active, elle est mise de côté pendant le vol puis remise à la fin.",
                  style="Muted.TLabel", wraplength=560, justify="left").pack(anchor="w", pady=(4, 10))
        vars_ = {}
        for icao, cands in multi:
            box = ttk.LabelFrame(fr, text="  %s — %s  " % (icao, names.get(icao) or ""), padding=(10, 6))
            box.pack(fill="x", pady=5)
            v = tk.StringVar(value=memo.get(icao) if memo.get(icao) in [c["path"] for c in cands] else cands[0]["path"])
            vars_[icao] = v
            for c in cands:
                st = self.comm_status(c)
                extra = []
                if c.get("pinned"):
                    extra.append(T("★ Protégé"))
                if st not in ("—", "?"):
                    extra.append(T("déjà dans Community"))
                label = "%s   (%s)%s" % (c.get("title") or c["name"], c["name"],
                                        ("   · " + " · ".join(extra)) if extra else "")
                ttk.Radiobutton(box, text=label, variable=v, value=c["path"]).pack(anchor="w", pady=1)
        res = {"ok": False}
        bt = ttk.Frame(fr)
        bt.pack(fill="x", pady=(12, 0))

        def ok():
            res["ok"] = True
            win.destroy()
        ttk.Button(bt, text="Annuler", command=win.destroy).pack(side="right")
        ttk.Button(bt, text="Activer ces scènes", style="Accent.TButton", command=ok).pack(side="right", padx=(0, 8))
        win.bind("<Escape>", lambda _e: win.destroy())
        win.update_idletasks()
        try:
            self._place_win(win)
            win.grab_set()
        except tk.TclError:
            pass
        self.wait_window(win)
        if not res["ok"]:
            self.set_status("Préparation du vol annulée.")
            return None
        drop, set_aside = set(), []
        for icao, cands in multi:
            chosen = vars_[icao].get()
            memo[icao] = chosen   # proposé par défaut la prochaine fois
            for c in cands:
                if c["path"] != chosen:
                    drop.add(c["path"])
        chosen_paths = {vars_[i].get() for i, _c in multi}
        drop -= chosen_paths
        kept = [p for p in wanted if p["path"] not in drop]
        for p in wanted:
            if p["path"] in drop and not p.get("pinned"):
                set_aside.append(p)
                self.log("%s : scène non choisie pour ce vol — %s" % (
                    ", ".join(i for i in self.airport_icaos(p) if i in icaos), p["name"]))
        self.save_cfg()
        return kept, set_aside

    def _restore_parked(self):
        """Remet dans Community les scènes mises de côté pour le vol (même si l'appli a été fermée entre-temps)."""
        parked = self.st.get("parked") or []
        if not parked:
            return 0
        if sim_running(self.cfg["sim_exe"]):   # jamais pendant que MSFS tourne : on attend sa fermeture
            self.log("Simulateur ouvert : les %d scènes mises de côté seront remises après sa fermeture." % len(parked))
            return 0
        by_path = {os.path.normcase(os.path.normpath(p["path"])): p for p in self.packages}
        back, errors, keep = 0, 0, []
        for e in parked:
            p = by_path.get(os.path.normcase(os.path.normpath(e.get("target", ""))))
            if not p:
                if not self.packages:      # bibliothèque pas encore analysée : on réessaiera plus tard
                    keep.append(e)
                else:
                    errors += 1
                    self.log("Introuvable dans la bibliothèque, non remis : %s" % os.path.basename(e["link"]))
                continue
            try:
                self._link(p, "manual")
                back += 1
            except OSError as ex:
                errors += 1
                self.log("Erreur en remettant %s : %s" % (p["name"], ex))
        self.st["parked"] = keep
        if back:
            self.log("Remis dans Community : %d scène%s mise%s de côté pour le vol" % (
                back, "s" if back > 1 else "", "s" if back > 1 else ""))
        return errors

    def end_flight(self, auto=False):
        if not auto and self._sim_locked():
            return
        links = [l for l, v in self.st["links"].items() if v["kind"] == "flight"]
        if not auto:
            if not self.st.get("flight") and not links and not self.st.get("parked"):
                self.set_status("Aucun vol actif.")
                return
            if sim_running(self.cfg["sim_exe"]) and not messagebox.askyesno(
                    APP, "Le simulateur tourne encore. Retirer les scènes maintenant ?\n"
                         "(Mieux vaut le faire simulateur fermé.)"):
                return
        errors = 0
        for link in links:
            try:
                self._unlink(link)
                self.log("Retiré : %s" % os.path.basename(link))
            except OSError as e:
                errors += 1
                self.log("Erreur en retirant %s : %s" % (os.path.basename(link), e))
        errors += self._restore_parked()
        self._undo = None
        self._update_undo_btn()
        self.st["flight"] = None
        if self.plan:
            self.log("Plan de vol effacé : %s" % self.plan.get("route", ""))
        self.plan = None
        self.st["plan"] = None
        self.save_st()
        self.refresh_flight()
        self.refresh_library()
        self.set_status("Vol terminé : scènes retirées et plan de vol effacé." if not errors
                        else "Vol terminé avec %d erreur(s) — voir le journal." % errors)

    # ---- surveillance du simulateur
    def _monitor(self):
        exe = self.cfg["sim_exe"]
        lib = self.cfg["library"]
        comm = self.cfg["community"]
        links = [(l, v["target"]) for l, v in self.st["links"].items()]

        def work():
            images = running_images()
            running = (exe.lower() in images) if images else sim_running(exe)
            sig = lib_signature(lib)
            bad = sum(1 for l, t in links if not os.path.exists(t) or not os.path.lexists(l))
            csig = None
            if comm and os.path.isdir(comm):
                try:
                    csig = os.stat(comm).st_mtime
                    known = {l for l, _ in links}
                    for name in os.listdir(comm):
                        path = os.path.normpath(os.path.join(comm, name))
                        if path not in known and is_link(path) and not os.path.exists(path):
                            bad += 1
                except OSError:
                    pass
            return running, sig, bad, csig, images

        def done(res, err):
            running, sig, bad, csig, images = res if res else (False, None, 0, None, set())
            self._images = images
            self.sim_label.config(text="Simulateur : lancé" if running else "Simulateur : fermé")
            self._apply_lock(running)
            if running:
                if not self.sim_was_running and not self._relay_server and not self._relay_manual_off \
                        and not self._relay_port_busy:
                    self.relay_start()  # MSFS démarre : le relais repart tout seul
                if not self.sim_was_running and self.cfg.get("launcher_auto", True):
                    self._schedule_launches()  # MSFS démarre : applications du lanceur
                self.sim_was_running = True
            elif self.sim_was_running:
                self.sim_was_running = False
                if self.cfg.get("relay_auto", True) and self._relay_server:
                    self.relay_stop(" : MSFS 2024 fermé")
                self._close_apps_with_sim()
                if self.skip_next_exit:
                    self.skip_next_exit = False
                    self.log("Simulateur fermé (vol préparé pendant qu'il tournait : scènes conservées).")
                elif self.var_auto.get() and self.st.get("flight"):
                    self.log("Simulateur fermé : fin du vol détectée.")
                    self.end_flight(auto=True)
                elif self.st.get("parked") and not self.st.get("flight"):
                    self._restore_parked()          # scènes mises de côté restées en attente : on les remet
                    self.save_st()
                    self.refresh_library()
                    self.refresh_flight()
            if not self._scanning and not self._batch_running:
                if sig is not None and self._lib_sig is not None and sig != self._lib_sig:
                    self.log("Changement détecté dans la bibliothèque : actualisation.")
                    self.rescan()
                elif bad != self._last_bad:
                    self.check_health()
                if csig is not None and self._comm_sig is not None and csig != self._comm_sig \
                        and not self._batch_running:
                    self.refresh_library()
            self._last_bad = bad
            if csig is not None:
                self._comm_sig = csig
            self._push_map()
            self._check_parking(running)
            self._update_relay_ui()
            self.launcher_refresh()
            self.after(4000, self._monitor)

        self.run_bg(work, done)

    def quit_app(self):
        if self.sim_on and not messagebox.askyesno(
                APP, "MSFS 2024 est lancé.\n\nQuitter Hangar FS 2024 ? Le relais s'arrêtera (plus de trafic IA ni de "
                     "suivi de vol) et les applications ne seront plus fermées automatiquement avec le simulateur."):
            return
        self.on_close()

    def close_web_window(self, which):
        """Ferme la fenêtre Carte ou Plan & suivi de vol (demandé par le bouton de la page)."""
        title = {"map": MAP_WINDOW_TITLE, "tuto": TUTO_TITLE["en" if LANG == "en" else "fr"]}.get(which, self._dispatch_title)
        hwnd = find_window(title, exact=True)
        return bool(hwnd and close_window(hwnd))

    def on_close(self):
        for title in (MAP_WINDOW_TITLE, self._dispatch_title, TUTO_TITLE["en" if LANG == "en" else "fr"]):  # ferme les fenêtres web
            for _ in range(3):
                hwnd = find_window(title, exact=True)
                if not hwnd or not close_window(hwnd):
                    break
                time.sleep(0.15)
        if getattr(self, "_relay_stop", None):
            self._relay_stop.set()
        if self._relay_server:
            try:
                self._relay_server.shutdown()
                self._relay_server.server_close()
            except Exception:  # noqa
                pass
        if self._map_server:
            try:
                self._map_server.shutdown()
                self._map_server.server_close()
            except Exception:  # noqa
                pass
        try:
            self.save_cfg()
            self.save_st()
        finally:
            self.destroy()


def main():
    if IS_WIN:
        try:
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(APP_ID)
        except Exception:  # noqa
            pass
        try:
            import ctypes
            ctypes.windll.shcore.SetProcessDpiAwareness(1)
        except Exception:  # noqa
            pass
    if early_elevate():
        return      # la fenêtre administrateur prend le relais
    install_i18n()
    App().mainloop()


if __name__ == "__main__":
    main()
