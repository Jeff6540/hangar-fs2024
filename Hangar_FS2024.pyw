    def _build_fshub(self, parent):
        outer = ttk.Frame(parent)
        # ligne 1 : code de la VA (celui de l'adresse fshub.io/airline/<code>)
        rva = ttk.Frame(outer)
        rva.pack(anchor="w")
        ttk.Label(rva, text="Code de ta VA").pack(side="left")
        var_va = tk.StringVar(value=self.cfg.get("fshub_va", ""))
        ent_va = ttk.Entry(rva, textvariable=var_va, width=8)
        ent_va.pack(side="left", padx=6)
        ttk.Label(rva, text="— ex. LFV : le code de ta compagnie dans son adresse fshub.io/airline/LFV. "
                            "Ses pilotes en vol s'affichent sur la carte de suivi (bouton « ★ MA VA FSHUB »).",
                  style="Muted.TLabel").pack(side="left", padx=6)

        def store_va(*_a):
            code = re.sub(r"[^A-Z0-9]", "", var_va.get().upper())[:8]
            var_va.set(code)
            if code != self.cfg.get("fshub_va", ""):
                self.cfg["fshub_va"] = code
                self.save_cfg()
                feed = getattr(self.relay, "fshub", None)
                if feed:
                    feed.ident_token = ""
        ent_va.bind("<FocusOut>", store_va)
        ent_va.bind("<Return>", store_va)
        # ligne 2 : clé FSHub facultative (reconnaît ton avion pour ne pas l'afficher en double)
        box = ttk.Frame(outer)
        box.pack(anchor="w", pady=(6, 0))
        ttk.Label(box, text="Clé FSHub (facultative)").pack(side="left", padx=(0, 6))
        var = tk.StringVar(value=self.cfg.get("fshub_token", ""))
        ent = ttk.Entry(box, textvariable=var, width=46, show="•")
        ent.pack(side="left")
        shown = {"on": False}

        def toggle():
            shown["on"] = not shown["on"]
            ent.config(show="" if shown["on"] else "•")
            b_show.config(text="🙈 Masquer" if shown["on"] else "👁 Afficher")
        b_show = ttk.Button(box, text="👁 Afficher", command=toggle)
        b_show.pack(side="left", padx=6)
        lbl = ttk.Label(box, text="", style="Muted.TLabel")

        def store(*_a):
            tok = var.get().strip()
            if tok != self.cfg.get("fshub_token", ""):
                self.cfg["fshub_token"] = tok
                self.save_cfg()
                feed = getattr(self.relay, "fshub", None)
                if feed:
                    feed.ident_token = ""
            return tok

        def test():
            tok = store()
            if not tok:
                lbl.config(text="Colle d'abord ta clé FSHub (fshub.io → ton nom → Settings → Integrations).")
                return
            lbl.config(text="Test en cours…")

            store_va()

            def work():
                me, al = fshub_identify(tok, self.cfg.get("fshub_va", ""))
                if not al.get("id"):   # pas membre de la VA réglée : profil reconnu, liste via le radar public
                    return me, al, [], "radar"
                pil, src = fshub_online_pilots(tok, al["id"])
                return me, al, pil, src

            def done(res, err):
                try:
                    if err:
                        lbl.config(text="✖ " + str(err))
                    else:
                        me, al, pil, src = res
                        if src == "radar":
                            lbl.config(text="✓ %s · tu n'es pas membre de %s sur FSHub : ses pilotes s'affichent "
                                            "quand même via le radar public" % (me.get("name") or "profil trouvé",
                                                                               al.get("abbr") or "cette VA"))
                        elif src == "airline":
                            lbl.config(text="✓ %s · %s%s · %d pilote%s en ligne" % (
                                me.get("name") or "profil trouvé", al.get("name") or "compagnie",
                                " (%s)" % al["abbr"] if al.get("abbr") else "", len(pil), "s" if len(pil) > 1 else ""))
                        else:
                            lbl.config(text="⚠ %s · FSHub refuse la liste des pilotes de %s : affichage de tes amis "
                                            "FSHub en ligne (%d)" % (me.get("name") or "profil", al.get("name") or
                                                                      "la compagnie", len(pil)))
                except tk.TclError:
                    pass
            self.run_bg(work, done)

        ttk.Button(box, text="Tester la clé", style="Accent.TButton", command=test).pack(side="left")
        lbl.pack(side="left", padx=10)
        ent.bind("<FocusOut>", store)
        ent.bind("<Return>", lambda e: test())
        if not var.get():
            lbl.config(text="Facultative : reconnaît ton avion pour ne pas l'afficher en double. fshub.io → ton nom → "
                            "Settings → Integrations. Elle reste sur ce PC.")
        return outer

    def _build_screens(self, parent):
        box = ttk.Frame(parent)
        mons = list_monitors()
        top = ttk.Frame(box)
        top.pack(fill="x")
        cv = tk.Canvas(top, width=300, height=92, bg=C["bg"], highlightthickness=0)
        cv.pack(side="left")
        right = ttk.Frame(top)
        right.pack(side="left", fill="x", padx=(14, 0))
        labels = [T("Automatique — 2e écran s'il est branché")] + [T(monitor_label(m)) for m in mons]
        values = ["auto"] + [m["dev"] for m in mons]
        cur = self.cfg.get("screen", "auto")
        if cur not in values:
            labels.append(T("Écran choisi (débranché) — principal en attendant"))
            values.append(cur)
        var = tk.StringVar(value=labels[values.index(cur)])
        r1 = ttk.Frame(right)
        r1.pack(anchor="w")
        ttk.Label(r1, text="Écran des fenêtres").pack(side="left")
        cb = ttk.Combobox(r1, textvariable=var, values=labels, state="readonly", width=40)
        cb.pack(side="left", padx=8)
        ttk.Button(r1, text="🔢  Identifier les écrans", command=self.identify_screens).pack(side="left")
        r2 = ttk.Frame(right)
        r2.pack(anchor="w", pady=(8, 0))
        ttk.Label(r2, text="Fenêtres à placer sur cet écran :").pack(side="left", padx=(0, 8))
        wins = [("screen_main", "Hangar FS 2024"), ("screen_map", "Carte des scènes"),
                ("screen_dispatch", "Plan & suivi de vol (en plein écran)")]
        for key, text in wins:
            bv = tk.BooleanVar(value=self.cfg.get(key, True))

            def chg(k=key, b=bv):
                self.cfg[k] = b.get()
                self.save_cfg()
            ttk.Checkbutton(r2, text=text, variable=bv, command=chg).pack(side="left", padx=(0, 12))
        ttk.Label(right, text="Avec un seul écran, ou si l'écran choisi est débranché, tout s'ouvre sur l'écran "
                              "principal. MSFS reste sur ton écran principal.", style="Muted.TLabel").pack(anchor="w", pady=(6, 0))

        def draw():
            cv.delete("all")
            if not mons:
                cv.create_text(150, 46, text="Écrans : lecture impossible", fill=C["muted"], font=(UI_FONT, 9))
                return
            x0 = min(m["x"] for m in mons)
            y0 = min(m["y"] for m in mons)
            x1 = max(m["x"] + m["w"] for m in mons)
            y1 = max(m["y"] + m["h"] for m in mons)
            k = min(290.0 / max(1, x1 - x0), 86.0 / max(1, y1 - y0))
            target = resolve_monitor(self.cfg.get("screen", "auto"))
            for m in mons:
                ax, ay = 4 + (m["x"] - x0) * k, 3 + (m["y"] - y0) * k
                bx, by = ax + m["w"] * k - 4, ay + m["h"] * k - 4
                on = target is not None and m["dev"] == target["dev"]
                cv.create_rectangle(ax, ay, bx, by, outline=C["accent"] if on else C["border"], width=2,
                                    fill="#1b2a44" if on else C["panel"])
                cv.create_text((ax + bx) / 2, (ay + by) / 2 - 8, text=str(m["num"]), fill="#ffffff" if on else C["muted"],
                               font=(UI_FONT, 15, "bold"))
                cv.create_text((ax + bx) / 2, (ay + by) / 2 + 12, text="MSFS" if m["primary"] else (
                    "Hangar FS 2024" if on else ""), fill="#ffffff" if on else C["muted"], font=(UI_FONT, 8))

        def pick(_e=None):
            self.cfg["screen"] = values[labels.index(var.get())]
            self.save_cfg()
            draw()

        cb.bind("<<ComboboxSelected>>", pick)
        draw()
        return box

