VALID_FIRST = set("ABCDEFGHKLMNOPRSTUVWYZ")  # pas de préfixe OACI en I, J, Q, X
STOP = set("""
MSFS MSFT PACK BETA FREE LIVE MESH LODS DEMO FULL LITE TEST MODS PATH CORE LIBS
DATA TEXT FILE MAIN BASE CITY PARK LAKE PORT ISLE WEST EAST HELI AREA ROAD TREE
LAND MODE GATE SIGN OBJS HIGH NEWS PLUS SIMS ANIM BLDG LIBR MATS TEXS GRAS ROCK
SNOW SAND HILL ZONE PADS POLY MISC GLOB COMM AIRP APRT HANG SHED WALL FENC LAMP
LGTS ROOF TAXI APRO VEHI CARS BOAT SHIP PLAN STAT EDIT TERR ELEV
VDGS MIDI USAW AVTO JETW SAFE DOCK PAPI VASI RAMP RUNW LINE POLE WIRE POWR SOLA FARM
FIRE TOWN LOGO MARK PEOP CREW GRND AIRS LIVR
""".split())
TOKEN = re.compile(r"[A-Za-z0-9]+")


def tokens4(text, upper_only=False):
    out = []
    for t in TOKEN.findall(text or ""):
        if len(t) != 4 or not t.isalpha():
            continue
        if upper_only and not t.isupper():
            continue
        u = t.upper()
        if u[0] in VALID_FIRST and u not in STOP:
            out.append(u)
    return out


def find_packages(lib, max_depth=4):
    """Un paquet MSFS = un dossier contenant manifest.json."""
    pkgs = []
    lib = os.path.normpath(os.path.abspath(lib))
    base = lib.count(os.sep)
    for root, dirs, files in os.walk(lib):
        if root != lib and "manifest.json" in files:
            pkgs.append(root)
            dirs[:] = []
            continue
        if root.count(os.sep) - base >= max_depth:
            dirs[:] = []
        dirs[:] = sorted((d for d in dirs if d != QUAR_NAME), key=str.lower)
    return pkgs


def scan_package(path):
    info = {"path": path, "name": os.path.basename(path), "title": "", "type": "",
            "creator": "", "version": "", "icao": []}
    try:
        with open(os.path.join(path, "manifest.json"), "r", encoding="utf-8-sig", errors="ignore") as f:
            m = json.load(f)
        if isinstance(m, dict):
            info["title"] = str(m.get("title", "") or "")
            info["type"] = str(m.get("content_type", "") or "").upper()
            info["creator"] = str(m.get("creator", "") or "")
            info["version"] = str(m.get("package_version", "") or "").strip()
    except (OSError, ValueError):
        pass

    if info["type"] in ("SCENERY", ""):
        found = tokens4(info["name"]) + tokens4(info["title"], upper_only=True)
        n = 0 if not found else 3001  # les fichiers BGL ne servent que si le nom et le titre ne disent rien
        for root, _dirs, files in (os.walk(path) if not found else ()):
            for fn in files:
                if fn.lower().endswith(".bgl"):
                    found += tokens4(os.path.splitext(fn)[0])
                    n += 1
            if n > 3000:
                break
        seen = []
        for x in found:
            if x not in seen:
                seen.append(x)
        vendor = re.split(r"[-_ .]+", info["name"])[0].upper()
        if len(seen) > 1 and vendor in seen:
            seen.remove(vendor)
        info["icao"] = seen
    return info


# --------------------------------------------------------------------------- SimBrief
SB_ROLES = [
    ("origin", "Départ", True),
    ("destination", "Arrivée", True),
    ("alternate", "Dégagement", False),
    ("takeoff_altn", "Dégagement décollage", False),
    ("enroute_altn", "Dégagement en route", False),
]


def _s(v):
    if v is None or isinstance(v, (dict, list)):
        return ""
    return str(v)


def _as_list(x):
    if isinstance(x, list):
        return [o for o in x if isinstance(o, dict)]
    return [x] if isinstance(x, dict) else []


def parse_simbrief(data):
    fetch = data.get("fetch") if isinstance(data, dict) else None
    status = _s(fetch.get("status")) if isinstance(fetch, dict) else ""
    if status and status.lower() != "success":
        raise RuntimeError("SimBrief : " + status)
    airports, seen = [], set()
    for key, role, primary in SB_ROLES:
        for o in _as_list(data.get(key)):
            code = _s(o.get("icao_code")).strip().upper()
            if len(code) == 4 and code not in seen:
                seen.add(code)
                airports.append({"role": role, "icao": code, "name": _s(o.get("name")),
                                 "primary": primary})
    if not airports:
        raise RuntimeError("Aucun aéroport trouvé dans le plan de vol.")
    gen = data.get("general") if isinstance(data.get("general"), dict) else {}
    ac = data.get("aircraft") if isinstance(data.get("aircraft"), dict) else {}
    prm = data.get("params") if isinstance(data.get("params"), dict) else {}
    try:
        generated = int(float(_s(prm.get("time_generated")) or 0))
    except ValueError:
        generated = 0
    return {
        "ofp_id": _s(prm.get("request_id"))[:40],
        "generated": generated,
        "airports": airports,
        "flight": (_s(gen.get("icao_airline")) + _s(gen.get("flight_number"))).strip(),
        "aircraft": _s(ac.get("icaocode")) or _s(ac.get("name")),
        "route": " → ".join(a["icao"] for a in airports if a["primary"]),
    }


def fetch_simbrief(user):
    user = (user or "").strip()
    if not user:
        raise RuntimeError("Indique ton identifiant SimBrief (nom d'utilisateur ou Pilot ID).")
    key = "userid" if user.isdigit() else "username"
    url = "https://www.simbrief.com/api/xml.fetcher.php?" + urllib.parse.urlencode({key: user, "json": "1"})
    req = urllib.request.Request(url, headers={"User-Agent": "%s/%s" % (APP, VERSION)})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            body = r.read()
    except urllib.error.HTTPError as e:
        body = e.read()
    except urllib.error.URLError as e:
        raise RuntimeError("Impossible de joindre SimBrief (%s)." % e.reason)
    try:
        data = json.loads(body.decode("utf-8", errors="replace"))
    except ValueError:
        raise RuntimeError("Réponse SimBrief illisible.")
    return parse_simbrief(data)


