    def activate_profile(self, prof, parent=None, on_done=None):
        parent = parent or self
        if self._sim_locked() or self._batch_running or not self._check_comm():
            return
        if self.st.get("flight") or self.st.get("parked"):
            messagebox.showinfo(APP, "Un vol SimBrief est préparé : termine-le d'abord (onglet Vol SimBrief, "
                                     "« Terminer le vol »), puis active le profil.", parent=parent)
            return
        to_link, to_unlink, missing = self._profile_plan(prof)
        if not to_link and not to_unlink:
            self.cfg["active_profile"] = prof["name"]
            self.save_cfg()
            self.set_status(T("Profil « %s » : rien à changer, tout est déjà en place.") % prof["name"])
            if on_done:
                on_done()
            return
        def names(lst):
            return "\n".join("• " + q["name"] for q in lst[:8]) + ("\n• …" if len(lst) > 8 else "")
        msg = T("Activer le profil « %s » ?") % prof["name"]
        if to_link:
            msg += "\n\n" + T("À activer (%d) :") % len(to_link) + "\n" + names(to_link)
        if to_unlink:
            msg += "\n\n" + T("À retirer de Community (%d) :") % len(to_unlink) + "\n" + names([q for q, _k in to_unlink])
        if missing:
            msg += "\n\n" + T("Introuvables dans la bibliothèque (ignorés) : %s") % ", ".join(missing[:5])
        msg += "\n\n" + T("Seuls des liens sont ajoutés ou retirés ; « ↶ Annuler » remet tout comme avant.")
        if not messagebox.askyesno(APP, msg, parent=parent):
            return
        if len(to_unlink) > 20 and not messagebox.askyesno(
                APP, T("⚠  Le profil retire %d add-ons de Community. Continuer ?") % len(to_unlink),
                icon="warning", default="no", parent=parent):
            return
        susp_before = list(self.st.get("pin_suspended") or [])
        susp = set(susp_before) if prof.get("ignore_pinned") else set()
        items, errors = [], 0
        for q, kind in to_unlink:
            try:
                self._unlink(self._link_path(q))
                items.append({"path": q["path"], "op": "unlink", "kind": kind})
                if q.get("pinned"):
                    susp.add(q["path"])
                self.log("Profil « %s » : retiré %s" % (prof["name"], q["name"]))
            except OSError as e:
                errors += 1
                self.log("Erreur en retirant %s : %s" % (q["name"], e))
        self.st["pin_suspended"] = sorted(susp)
        if not prof.get("ignore_pinned"):
            errors += self._sync_pinned()      # profil normal : les protégés reviennent
        self.save_st()

        def done(results):
            n, errs = 0, errors
            for q, res, err in results:
                if err:
                    errs += 1
                    self.log("Erreur pour %s : %s" % (q["name"], err))
                elif res == "lié":
                    n += 1
                    items.append({"path": q["path"], "op": "link"})
            self._undo = {"kind": "profile", "name": prof["name"], "items": items, "suspended_before": susp_before}
            self._update_undo_btn()
            self.cfg["active_profile"] = prof["name"]
            self.save_cfg()
            self.save_st()
            self.checked.clear()
            self.refresh_library()
            self.refresh_flight()
            m = T("Profil « %s » activé : %d activé(s), %d retiré(s).") % (prof["name"], n, len(to_unlink))
            if errs:
                m += " " + T("%d erreur(s) — voir le journal (onglet Vol).") % errs
            self.set_status(m)
            self.log(m)
            if on_done:
                on_done()
        if to_link:
            self._run_batch(to_link, lambda q: self._link(q, "manual"), "install", done)
        else:
            done([])

    def _undo_profile(self, u):
        by_path = {q["path"]: q for q in self.packages}
        ok = errors = 0
        for it in reversed(u["items"]):
            q = by_path.get(it["path"])
            if not q:
                errors += 1
                continue
            try:
                if it["op"] == "link":
                    link = self._link_path(q)
                    if link in self.st["links"] and is_link(link):
                        self._unlink(link)
                        ok += 1
                else:
                    self._link(q, it.get("kind") or "manual")
                    ok += 1
            except OSError as e:
                errors += 1
                self.log("Annulation impossible pour %s : %s" % (q["name"], e))
        self.st["pin_suspended"] = list(u.get("suspended_before") or [])
        errors += self._sync_pinned()
        self.cfg.pop("active_profile", None)
        self._undo = None
        self._update_undo_btn()
        self.save_cfg()
        self.save_st()
        self.checked.clear()
        self.refresh_library()
        self.refresh_flight()
        m = T("Profil « %s » annulé : Community est revenu comme avant.") % u.get("name", "")
        if errors:
            m += " " + T("%d erreur(s) — voir le journal.") % errors
        self.log(m)
        self.set_status(m)

    # ---- annuler la dernière action Activer / Retirer
    def _set_undo(self, kind, items):
        self._undo = {"kind": kind, "items": items}
        self._update_undo_btn()

    def _update_undo_btn(self):
        b = getattr(self, "btn_undo", None)
        if not b:
            return
        u = self._undo
        if u:
            n = len(u["items"])
            if u["kind"] == "profile":
                what = "profil « %s »" % u.get("name", "")
            else:
                what = ("activation de %d add-on%s" if u["kind"] == "activate" else "retrait de %d add-on%s") % (
                    n, "s" if n > 1 else "")
            b.config(text=T("↶  Annuler (%s)" % what))
        else:
            b.config(text=T("↶  Annuler"))
        try:
            b.state(["!disabled"] if (u and not self.sim_on) else ["disabled"])
        except tk.TclError:
            pass

    def undo_last(self):
        u = self._undo
        if not u:
            self.set_status("Rien à annuler.")
            return
        if self._sim_locked() or self._batch_running:
            return
        if u["kind"] == "profile":
            self._undo_profile(u)
            return
        by_path = {p["path"]: p for p in self.packages}
        ok = errors = 0
        for it in u["items"]:
            p = by_path.get(it["path"])
            if not p:
                errors += 1
                continue
            try:
                if u["kind"] == "activate":
                    link = self._link_path(p)
                    if link in self.st["links"] and is_link(link):
                        self._unlink(link)
                        ok += 1
                else:
                    if it.get("pinned"):
                        p["pinned"] = True
                        self.cfg["overrides"].setdefault(p["path"], {})["pinned"] = True
                    self._link(p, "pinned" if it.get("pinned") else "manual")
                    ok += 1
            except OSError as e:
                errors += 1
                self.log("Annulation impossible pour %s : %s" % (p["name"], e))
        self.log(("Annulé : %d add-on(s) retiré(s) de Community (activation annulée)." if u["kind"] == "activate"
                  else "Annulé : %d add-on(s) remis dans Community (retrait annulé).") % ok)
        self._undo = None
        self._update_undo_btn()
        self.save_cfg()
        self.save_st()
        self.checked.clear()
        self.refresh_library()
        self.refresh_flight()
        msg = ("Activation annulée : %d add-on(s) retiré(s)." if u["kind"] == "activate"
               else "Retrait annulé : %d add-on(s) remis dans Community.") % ok
        if errors:
            msg += " %d erreur(s) — voir le journal." % errors
        self.set_status(msg)

    def remove_checked(self, pkgs=None):
        if self._sim_locked() or self._batch_running:
            return
        explicit = pkgs is not None
        src = "explicit"
        if explicit:
            pk = pkgs
        else:
            pk, src = self._targets()
        if not pk:
            messagebox.showinfo(APP, "Surligne ou coche d'abord les add-ons à retirer.")
            return
        if not self._check_comm():
            return
        present = [p for p in pk if os.path.lexists(self._link_path(p))]
        if not present:
            self.set_status("Aucun des add-ons cochés n'est dans Community.")
            return
        names = "\n".join("• " + p["name"] for p in present[:12]) + ("\n• …" if len(present) > 12 else "")
        msg = ("Retirer %d add-on(s) du dossier Community ?\n\n%s\n\n"
               "Seuls les liens sont retirés : tes fichiers restent intacts dans la bibliothèque."
               % (len(present), names))
        n_pin = sum(1 for p in present if p["pinned"])
        if n_pin:
            msg += "\n\n%d d'entre eux ne seront plus protégés (★)." % n_pin
        if sim_running(self.cfg["sim_exe"]):
            msg += "\n\nAttention : le simulateur est lancé."
        if not messagebox.askyesno(APP, msg, icon="warning"):
            return
        if len(present) > 20:   # gros retrait : seconde confirmation, « Non » par défaut
            total = sum(1 for p in self.packages if os.path.lexists(self._link_path(p)))
            if not messagebox.askyesno(
                    APP, "⚠  ATTENTION : tu vas retirer %d add-ons de Community, sur %d présents.\n\n"
                         "Est-ce vraiment ce que tu veux ?\n\n"
                         "(Tes fichiers restent dans la bibliothèque, et « ↶ Annuler » peut tout remettre.)"
                         % (len(present), total), icon="warning", default="no"):
                return
        pinned_before = {p["path"]: bool(p["pinned"]) for p in present}

        def one(p):
            link = self._link_path(p)
            if not is_link(link):
                return "copie"
            self._unlink(link)
            if p["pinned"]:
                p["pinned"] = False
                self.cfg["overrides"].setdefault(p["path"], {})["pinned"] = False
            return "retiré"

        def done(results):
            removed = skipped = errors = 0
            for p, res, err in results:
                if err:
                    errors += 1
                    self.log("Erreur en retirant %s : %s" % (p["name"], err))
                elif res == "copie":
                    skipped += 1
                    self.log("Ignoré (vraie copie, pas un lien) : %s" % p["name"])
                else:
                    removed += 1
                    self.log("Retiré : %s" % p["name"])
            gone = [{"path": p["path"], "pinned": pinned_before.get(p["path"], False)}
                    for p, res, err in results if err is None and res != "copie"]
            if gone:
                self._set_undo("remove", gone)
            self.save_cfg()
            self.save_st()
            self.checked.clear()
            # les add-ons sortis de Community perdent leur coche, quelle que soit la façon de les avoir choisis
            for p, res, err in results:
                if err is None and res != "copie":
                    self.checked.discard(p["path"])
            if src == "sel":
                self.tv_lib.selection_remove(*[i for i in self.tv_lib.selection() if self.tv_lib.exists(i)])
            self.refresh_library()
            self.refresh_flight()
            msg = "%d add-on(s) retiré(s) de Community." % removed
            if skipped:
                msg += " %d vraie(s) copie(s) ignorée(s), à déplacer à la main." % skipped
            if errors:
                msg += " %d erreur(s) — voir le journal." % errors
            self.set_status(msg)

        self._run_batch(present, one, "remove", done)

    # ---- volet Community
    def _classify_comm(self, path, link):
        kinds = {"flight": "Lien (vol)", "manual": "Lien", "pinned": "★ Protégé"}
        if not link and os.path.basename(path) in self.st.get("default_off", {}):
            return "defoff", "Défaut MSFS désactivé"
        if link and not os.path.exists(path):
            return "broken", "Lien cassé"
        if not link:
            return "real", "Dossier réel"
        if path in self.st["links"]:
            return "ours", kinds.get(self.st["links"][path]["kind"], "Lien")
        lib = self.cfg["library"]
        tgt = link_target(path)
        if lib and tgt and inside(tgt, lib):
            return "ext", "Lien externe"
        return "off", "Hors bibliothèque"

    def refresh_community(self, force=False):
        tv = self.tv_comm
        if force:
            self._mcache = {}
        tv.delete(*tv.get_children())
        comm = self.cfg["community"]
        counts = {c: 0 for c, _ in COMM_CATS}
        if not comm or not os.path.isdir(comm):
            self._comm_counts = counts
            self._update_chips()
            self.lbl_comm_head.config(text="Community — introuvable")
            return
        try:
            names = sorted(os.listdir(comm), key=str.lower)
        except OSError:
            self.lbl_comm_head.config(text="Community — illisible")
            return
        q = self.var_csearch.get().strip().lower()
        entries = []
        for name in names:
            path = os.path.normpath(os.path.join(comm, name))
            link = is_link(path)
            if not link and not os.path.isdir(path):
                continue
            cat, etat = self._classify_comm(path, link)
            counts[cat] += 1
            entries.append(path)
            if cat == "broken":
                title, creator, ver = "", "", ""
            else:
                if path not in self._mcache:
                    self._mcache[path] = manifest_brief(path)
                title, creator, ver = self._mcache[path]
            if self.comm_filter and cat != self.comm_filter:
                continue
            if q and q not in (name + " " + title + " " + creator).lower():
                continue
            tv.insert("", "end", iid=path, values=(name, title, creator, ver, etat), tags=(cat,))
        self._comm_counts = counts
        self._update_chips()
        key = tuple(entries)
        if force or key != self._comm_size_key:
            self._comm_size_key = key
            self._comm_size = None
            self.run_bg(lambda: folder_size(entries),
                        lambda res, err, k=key: self._comm_size_done(k, res, err))
        self._update_comm_head()

    def _comm_size_done(self, key, res, err):
        if key == self._comm_size_key and not err:
            self._comm_size = res
            self._update_comm_head()

    def _update_comm_head(self):
        n = sum(self._comm_counts.values())
        size = "calcul de la taille…" if self._comm_size is None else fmt_size(self._comm_size)
        self.lbl_comm_head.config(text="Community — %s · %d add-ons" % (size, n))

    def _update_chips(self):
        for cat, (w, lbl) in self._chips.items():
            on = self.comm_filter == cat
            w.config(text="%s : %d" % (lbl, self._comm_counts.get(cat, 0)),
                     highlightbackground=C["accent_hi"] if on else C["border"],
                     highlightthickness=2 if on else 1)

    def _toggle_comm_filter(self, cat):
        self.comm_filter = None if self.comm_filter == cat else cat
        self.refresh_community()

    # ---- menus clic droit
    def _menu(self):
        return tk.Menu(self, tearoff=0, bg=C["panel"], fg=C["fg"], activebackground=C["sel"],
                       activeforeground="#ffffff", disabledforeground=C["off"], bd=1, relief="solid",
                       font=(UI_FONT, 10))

    @staticmethod
    def _st(ok):
        return "normal" if ok else "disabled"

    def _real_target(self, path):
        if path and is_link(path):
            t = link_target(path)
            return os.path.normpath(t) if t else ""
        return path or ""

