    def _pick_processes(self, parent, var, hint):
        imgs = sorted(running_images())
        if not imgs:
            messagebox.showinfo(APP, "Impossible de lire la liste des programmes ouverts.", parent=parent)
            return
        words = [w for w in re.findall(r"[a-z]{4,}", (hint or "").lower())
                 if w not in ("program", "files", "updater", "launcher", "exe", "users", "appdata", "local")]
        sugg = [i for i in imgs if any(w in i for w in words)]
        others = [i for i in imgs if i not in sugg]
        current = {x.lower() for x in split_procs(var.get())}
        win = tk.Toplevel(parent)
        win.title("Programmes ouverts")
        win.configure(bg=C["bg"])
        win.transient(parent)
        fr = ttk.Frame(win, padding=14)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text="Choisis le ou les programmes de l'application (Ctrl+clic pour plusieurs).\n"
                           "★ = noms qui ressemblent à l'application.", style="Muted.TLabel",
                  justify="left").pack(anchor="w", pady=(0, 8))
        lb = tk.Listbox(fr, selectmode="extended", width=48, height=18, bg=C["panel"], fg=C["fg"],
                        selectbackground=C["sel"], selectforeground="#ffffff", relief="flat", highlightthickness=1,
                        highlightbackground=C["border"], font=(UI_FONT, 10), activestyle="none")
        lb.pack(fill="both", expand=True)
        names = sugg + others
        for i, n in enumerate(names):
            lb.insert("end", ("★  " if n in sugg else "    ") + n)
            if n in current:
                lb.selection_set(i)
        if sugg and not current:
            lb.see(0)

        def ok():
            chosen = [names[i] for i in lb.curselection()]
            if chosen:
                var.set("; ".join(chosen))
            win.destroy()

        row = ttk.Frame(fr)
        row.pack(fill="x", pady=(10, 0))
        ttk.Button(row, text="Annuler", command=win.destroy).pack(side="right")
        ttk.Button(row, text="Valider", style="Accent.TButton", command=ok).pack(side="right", padx=6)
        lb.bind("<Double-1>", lambda e: ok())
        self._place_win(win, parent)
        win.grab_set()
        parent.wait_window(win)

    # -- lancement / arrêt
    def _cancel_pending(self, key):
        item = self._pending.pop(key, None)
        if item:
            try:
                self.after_cancel(item[1])
            except (tk.TclError, ValueError):
                pass

    def _schedule_launches(self, trigger="sim", where=""):
        n = 0
        for app in self._apps():
            if not app.get("enabled", True) or app["id"] in self._pending \
                    or app.get("trigger", "sim") != trigger:
                continue
            delay = int(app.get("delay", 0))
            aid = self.after(delay * 1000, lambda a=app: self._launch_app(a))
            self._pending[app["id"]] = (time.time() + delay, aid)
            n += 1
        if n:
            self.log("Démarrage auto : %d application(s) programmée(s) %s." % (
                n, "après le démarrage de MSFS 2024" if trigger == "sim" else "— avion au parking%s" % where))
            self._launcher_tick()

    def _launch_app(self, app):
        key = app["id"]
        self._pending.pop(key, None)
        self._lstatus.pop(key, None)
        procs = [x.lower() for x in split_procs(app.get("proc"))]
        imgs = running_images() if procs else set()
        if any(x in imgs for x in procs):
            self.log("Démarrage auto : %s est déjà ouverte, pas de second lancement." % app["name"])
            self.launcher_refresh()
            return
        path = app.get("path", "")
        if not os.path.exists(path):
            self._lstatus[key] = "✖ programme introuvable"
            self.log("Démarrage auto : %s introuvable (%s)." % (app["name"], path))
            self.launcher_refresh()
            return
        cwd = app.get("cwd") or os.path.dirname(path)
        ext = os.path.splitext(path)[1].lower()
        if app.get("admin") and IS_WIN and not is_admin():
            self._lstatus[key] = "🛡 confirmation Windows…"
            self.launcher_refresh()
            target = path

            def work():
                return shell_runas_code(target, app.get("args", ""), cwd if os.path.isdir(cwd) else None)

            def done(code, err):
                if not err and code and code > 32:
                    self._lstatus.pop(key, None)
                    self.log("Démarrage auto : %s lancée en administrateur." % app["name"])
                    self._place_app_later(app)
                else:
                    why = runas_error(code or 0) if not err else str(err)
                    self._lstatus[key] = "✖ " + why
                    self.log("Démarrage auto : %s n'a pas été lancée — %s." % (app["name"], why))
                self.launcher_refresh()

            self.run_bg(work, done)
            return
        try:
            if not IS_WIN:
                raise OSError("lancement possible sous Windows uniquement")
            if ext == ".lnk":
                os.startfile(path)  # noqa
                p = None
            else:
                cmd = '"%s" %s' % (path, app.get("args", "")) if app.get("args") else '"%s"' % path
                p = subprocess.Popen(cmd, cwd=cwd if os.path.isdir(cwd) else None, shell=ext in (".bat", ".cmd"))
            if p is not None:
                self._procs[key] = p
            self.log("Démarrage auto : %s lancée." % app["name"])
            self._place_app_later(app)
        except OSError as e:
            self._lstatus[key] = "✖ erreur au lancement"
            self.log("Démarrage auto : impossible de lancer %s (%s)." % (app["name"], e))
        self.launcher_refresh()

    def _stop_app(self, app, force=True):
        """Ferme l'application : demande polie, puis fermeture forcée si elle résiste (ou tout de suite si force)."""
        key = app["id"]
        self._cancel_pending(key)
        procs = [x.replace('"', "") for x in split_procs(app.get("proc"))]
        p = self._procs.pop(key, None)
        name = app["name"]

        def still_running():
            imgs = running_images()
            return any(x.lower() in imgs for x in procs)

        elevated = bool(app.get("admin")) and IS_WIN and not is_admin()

        def work():
            if not IS_WIN:
                return "rien à fermer"
            if elevated and procs:
                # application lancée en administrateur : la fermer demande aussi les droits ;
                # taskkill est lancé directement (aucune commande cachée)
                return elevated_taskkill(procs, force)
            targets = []
            if procs:
                targets.append(["taskkill"] + sum((["/IM", x] for x in procs), []) + ["/T"])
            elif p is not None and p.poll() is None:
                targets.append(["taskkill", "/PID", str(p.pid), "/T"])
            if not targets:
                return "rien à fermer"
            for t in targets:
                subprocess.run(t + (["/F"] if force else []), capture_output=True, creationflags=NO_WINDOW, timeout=15)
            if not force:
                for _ in range(12):  # jusqu'à 6 s pour se fermer proprement
                    time.sleep(0.5)
                    if procs and not still_running():
                        return "fermée"
                    if not procs and (p is None or p.poll() is not None):
                        return "fermée"
                for t in targets:
                    subprocess.run(t + ["/F"], capture_output=True, creationflags=NO_WINDOW, timeout=15)
                return "fermée de force (ne répondait pas)"
            return "arrêtée"

        def done(res, err):
            self.log("Démarrage auto : %s %s." % (name, res if not err else "— erreur : %s" % err))
            self.launcher_refresh()

        self.run_bg(work, done)

    def _offer_desktop_shortcut(self):
        """Version portable : propose une fois un raccourci « Hangar FS 2024 » sur le Bureau (avec l'icône),
        et le remet à jour si le dossier de l'appli a été déplacé."""
        if not (IS_WIN and PORTABLE):
            return
        lnk = os.path.join(desktop_dir(), "Hangar FS 2024.lnk")
        exe, args, wd = launch_command()
        args = args.replace(" --minimized", "")
        if os.path.isfile(lnk):
            try:
                if not same_program(read_shortcut(lnk)[0], exe):
                    write_shortcut(lnk, exe, args, wd, ensure_icon_file(), "Hangar FS 2024")
            except (OSError, AttributeError, ValueError):
                pass
            return
        if self.cfg.get("desktop_lnk_asked"):
            return
        self.cfg["desktop_lnk_asked"] = True
        self.save_cfg()
        if messagebox.askyesno(APP, "Créer un raccourci « Hangar FS 2024 » sur le Bureau ?\n\nTu pourras ensuite "
                                    "ouvrir l'appli directement depuis le Bureau.", parent=self):
            try:
                write_shortcut(lnk, exe, args, wd, ensure_icon_file(), "Hangar FS 2024")
                self.set_status("Raccourci créé sur le Bureau.")
            except (OSError, AttributeError, ValueError) as e:
                self.set_status(T("Raccourci impossible : %s") % e)

    def _create_desktop_shortcut(self):
        """Bouton de Réglages : (re)crée le raccourci « Hangar FS 2024 » du Bureau, avec l'icône."""
        lnk = os.path.join(desktop_dir(), "Hangar FS 2024.lnk")
        exe, args, wd = launch_command()
        args = args.replace(" --minimized", "")
        try:
            write_shortcut(lnk, exe, args, wd, ensure_icon_file(), "Hangar FS 2024")
        except (OSError, AttributeError, ValueError) as e:
            messagebox.showerror(APP, T("Raccourci impossible : %s") % e, parent=self)
            return
        self.cfg["desktop_lnk_asked"] = True
        self.save_cfg()
        self.set_status("Raccourci créé sur le Bureau.")
        messagebox.showinfo(APP, "Le raccourci « Hangar FS 2024 » est sur le Bureau.", parent=self)

    def _check_admin_startup(self):
        """Démarrage en administrateur : une seule méthode (tâche OU raccourci), tâche pointant vers le .exe
        actuel, et vérification qu'une relance demandée a bien donné les droits."""
        if not IS_WIN:
            return
        self._admin_warned = False
        has_task = task_exists()
        exe, _a, _w = launch_command()
        if has_task and task_has_logon_trigger():
            # ancienne tâche qui démarrait l'appli toute seule à l'ouverture de session (signalée par certains
            # antivirus) : on la remplace par la tâche « à la demande » + le raccourci normal
            ok = False
            if is_admin() or messagebox.askyesno(
                    APP, "Mise à jour du mode administrateur : l'ancienne tâche planifiée qui démarrait Hangar FS 2024 "
                         "à l'ouverture de session (parfois signalée par les antivirus) est remplacée par une tâche "
                         "« à la demande » et un raccourci de démarrage normal.\n\nFaire la mise à jour maintenant ? "
                         "(une seule confirmation Windows)", parent=self):
                ok = create_admin_task()
            if ok:
                set_start_with_windows(True)
                self.log("Mode administrateur mis à jour : tâche à la demande + raccourci de démarrage.")
            return
        if has_task and self.cfg.get("startup_admin") and not os.path.isfile(startup_shortcut()) \
                and same_program(task_command(), exe):
            set_start_with_windows(True)
        if has_task and not same_program(task_command(), exe):
            # jamais de mise à jour silencieuse de la tâche planifiée : on demande toujours (une fois par emplacement)
            if self.cfg.get("task_fix_asked") != exe:
                self.cfg["task_fix_asked"] = exe
                self.save_cfg()
                if messagebox.askyesno(APP, "Le démarrage en administrateur lance encore un ancien emplacement de "
                                            "Hangar FS 2024.\n\nLe mettre à jour pour ce programme ? (une seule "
                                            "confirmation Windows)", parent=self):
                    ok = create_admin_task()
                    self.log("Démarrage en administrateur %s." % ("mis à jour" if ok else "non mis à jour"))
        if RELAUNCH_EXPECT_ADMIN and not is_admin():
            self._admin_warned = True
            messagebox.showwarning(APP, "La relance en administrateur n'a pas donné les droits administrateur.\n\n"
                                        "Causes possibles :\n• l'antivirus (Microsoft Defender) a bloqué la relance ;\n"
                                        "• ton compte Windows n'est pas administrateur ;\n"
                                        "• la tâche planifiée est ancienne : décoche puis recoche « En mode "
                                        "administrateur » dans Réglages.", parent=self)

    def _uac_hint(self, force=False):
        """Applis 🛡 fermées avec MSFS alors que Hangar FS 2024 tourne en mode normal : Windows demandera une
        confirmation (UAC) à chaque fermeture. On le dit et on propose de relancer en administrateur."""
        if not IS_WIN or is_admin() or (self.cfg.get("uac_hint_off") and not force) or \
                (getattr(self, "_admin_warned", False) and not force):
            return
        apps = [a for a in self._apps() if a.get("enabled", True) and a.get("admin") and a.get("close_with_sim", True)]
        if not apps:
            return
        win = tk.Toplevel(self)
        win.title("Applications en administrateur")
        win.configure(bg=C["bg"])
        win.transient(self)
        win.resizable(False, False)
        fr = ttk.Frame(win, padding=18)
        fr.pack(fill="both", expand=True)
        ttk.Label(fr, text="Éviter les fenêtres Windows (UAC) à la fermeture", style="Head.TLabel").pack(anchor="w")
        ttk.Label(fr, text=T("Ces applications tournent en administrateur et sont fermées avec MSFS : %s.") %
                  ", ".join(a["name"] for a in apps), wraplength=600, justify="left").pack(anchor="w", pady=(10, 0))
        ttk.Label(fr, text="Hangar FS 2024 tourne en mode normal : Windows interdit à un programme normal de fermer un "
                           "programme administrateur sans demander l'autorisation. Une confirmation (UAC) "
                           "s'affiche donc à la fermeture (une seule pour toutes ces applis).\n\nPour ne plus en "
                           "avoir : relance Hangar FS 2024 en administrateur. Pour que ce soit automatique, coche "
                           "« Démarrer avec Windows » et « En mode administrateur » dans Réglages : l'appli démarre "
                           "alors en administrateur sans aucune confirmation.",
                  wraplength=600, justify="left").pack(anchor="w", pady=(8, 0))
        if self.cfg.get("startup_admin"):
            ttk.Label(fr, text="La case « En mode administrateur » est déjà cochée : Hangar FS 2024 a sans doute été "
                               "ouvert pendant que la tâche planifiée était ancienne ou bloquée. Clique sur "
                               "« Relancer en administrateur ».", style="Muted.TLabel",
                      wraplength=600, justify="left").pack(anchor="w", pady=(8, 0))
        var_off = tk.BooleanVar(value=bool(self.cfg.get("uac_hint_off")))
        ttk.Checkbutton(fr, text="Ne plus afficher ce message", variable=var_off).pack(anchor="w", pady=(12, 0))

        def close(then=None):
            self.cfg["uac_hint_off"] = bool(var_off.get())
            self.save_cfg()
            win.destroy()
            if then:
                then()
        bt = ttk.Frame(fr)
        bt.pack(fill="x", pady=(14, 0))
        ttk.Button(bt, text="Plus tard", command=close).pack(side="right")
        ttk.Button(bt, text="🛡  Relancer en administrateur", style="Accent.TButton",
                   command=lambda: close(self.restart_as_admin)).pack(side="right", padx=6)
        self._place_win(win)

    def _stop_apps(self, apps, force=True):
        """Ferme plusieurs applications. Celles lancées en administrateur (Hangar FS 2024 en mode normal)
        sont fermées ensemble : une seule confirmation Windows au lieu d'une par application."""
        elev = [a for a in apps if a.get("admin") and IS_WIN and not is_admin() and split_procs(a.get("proc"))]
        for a in apps:
            if a not in elev:
                self._stop_app(a, force)
        if len(elev) < 2:
            for a in elev:
                self._stop_app(a, force)
            return
        procs = []
        for a in elev:
            self._cancel_pending(a["id"])
            self._procs.pop(a["id"], None)
            procs += [x.replace('"', "") for x in split_procs(a.get("proc"))]
        names = ", ".join(a["name"] for a in elev)
        def work():
            res = elevated_taskkill(procs, force)
            return {"fermée": "fermées", "non fermée (confirmation Windows refusée)":
                    "non fermées (confirmation Windows refusée)"}.get(res, res)

        def done(res, err):
            self.log("Démarrage auto : %s %s (une seule confirmation Windows)." % (
                names, res if not err else "— erreur : %s" % err))
            self.launcher_refresh()
        self.run_bg(work, done)

    def launcher_start_selected(self):
        apps = self._selected_apps()
        if not apps:
            messagebox.showinfo(APP, "Sélectionne une ou plusieurs applications.")
            return
        for a in apps:
            self._cancel_pending(a["id"])
            self._launch_app(a)

    def launcher_stop_selected(self):
        apps = self._selected_apps()
        if not apps:
            messagebox.showinfo(APP, "Sélectionne l'application à arrêter.")
            return
        if not messagebox.askyesno(APP, "Arrêter tout de suite %s ?\n\nUtile si une application est bloquée : elle est "
                                        "fermée de force, ses données non enregistrées peuvent être perdues."
                                   % ", ".join("« %s »" % a["name"] for a in apps), icon="warning"):
            return
        self._stop_apps(apps, force=True)

    def launcher_stop_all(self):
        apps = [a for a in self._apps() if a["id"] in self._pending or self._app_state(a)[1] == "run"]
        if not apps:
            self.set_status("Aucune application du démarrage auto n'est en cours.")
            return
        if not messagebox.askyesno(APP, "Arrêter toutes les applications du démarrage auto (%d) et annuler les "
                                        "lancements programmés ?" % len(apps), icon="warning"):
            return
        self._stop_apps(apps, force=True)

    def _check_parking(self, running):
        """Repère l'avion du pilote immobile au sol près d'un aéroport et déclenche les applications 🅿."""
        apps = [a for a in self._apps() if a.get("enabled", True) and a.get("trigger") == "parking"]
        if not running:
            self._parking_since = None
            self._parking_fired = False
            self._user_lost_since = None
            self._parking_warned = False
            return
        if not apps or not self.cfg.get("launcher_auto", True):
            return
        if not (self.relay and self.relay.connected):
            if not self._relay_server and not self._parking_warned:
                self._parking_warned = True
                self.log("Démarrage auto : le relais est arrêté, l'avion au parking ne peut pas être détecté. "
                         "Démarre-le avec le bouton ⏻ en bas à droite.")
            return
        user = self.relay.snapshot().get("user")
        now = time.time()
        if not user:
            self._parking_since = None
            if self._user_lost_since is None:
                self._user_lost_since = now
            elif self._parking_fired and now - self._user_lost_since >= PARKING_REARM_S:
                self._parking_fired = False  # retour au menu : prêt pour le prochain vol
                self.log("Démarrage auto : avion retiré (retour au menu) — détection du parking réarmée.")
            return
        self._user_lost_since = None
        if self._parking_fired:
            return
        if not user.get("ground") or abs(user.get("gs", 99)) > PARKING_MAX_GS:
            self._parking_since = None
            return
        pos = (user["lat"], user["lon"])
        moved = self._parking_pos is None or abs(pos[0] - self._parking_pos[0]) > 0.002 \
            or abs(pos[1] - self._parking_pos[1]) > 0.002          # ~200 m : nouvelle position
        if self._parking_since is None or moved:
            self._parking_since = now
            self._parking_pos = pos
            return
        if now - self._parking_since < PARKING_STABLE_S:
            return
        where = ""
        if self.airports and not self.cfg.get("parking_need_airport", True):
            code = nearest_airport(self.airports, user["lat"], user["lon"], PARKING_AIRPORT_KM)
            where = " à %s" % code if code else ""
        elif self.airports:
            code = nearest_airport(self.airports, user["lat"], user["lon"], PARKING_AIRPORT_KM)
            if not code:
                return  # au sol mais loin de tout aéroport (menu, hangar…) : on attend
            where = " à %s" % code
        elif self.airports is None and os.path.isfile(AIRPORTS_FILE):
            self._load_airports()
        self._parking_fired = True
        self._schedule_launches("parking", where)

    def _close_apps_with_sim(self):
        todo = []
        for app in self._apps():
            self._cancel_pending(app["id"])
            if app.get("close_with_sim", True) and self._app_state(app)[1] == "run":
                todo.append(app)
        self._stop_apps(todo, force=False)
        n = len(todo)
        if n:
            self.log("Démarrage auto : fermeture de %d application(s) avec MSFS 2024." % n)

    # ---- relais intégré et Avionics Dispatch
    def _start_relay(self):
        global RELAY_LOG
        RELAY_LOG = lambda m: self.q.put(lambda m=m: self.log("Relais : " + m))  # noqa: E731
        self.relay = RelayState()
        self.relay.fshub = FshubFeed(lambda: self.cfg.get("fshub_token", ""), lambda: self.cfg.get("fshub_va", ""))
        self.relay.plan_info = lambda: self.plan   # plan récupéré dans l'onglet Vol SimBrief (lu par la carte de suivi)
        self._relay_server = None
        self._relay_stop = None
        self._relay_port_busy = False
        self._relay_manual_off = False
        self._relay_dll_missing = False
        self._relay_tries = 0
        self._relay_try()

    def _relay_try(self):
        """Au démarrage, le port peut encore être tenu un instant par une fenêtre qui se ferme (relance)."""
        self._relay_tries += 1
        if self.relay_start(quiet=True, silent_busy=self._relay_tries < 3):
            return
        if self._relay_tries < 3:
            self._relay_port_busy = False
            self.after(1500, self._relay_try)

    def relay_start(self, quiet=False, silent_busy=False):
        if self._relay_server:
            return True
        self.relay.set_connected(False)
        try:
            srv = http.server.ThreadingHTTPServer((RELAY_HOST, RELAY_PORT), make_relay_handler(self.relay))
        except OSError:
            if not self._relay_port_busy and not silent_busy:
                self.log("Relais : le port 8765 est déjà pris, sans doute par l'ancien relais. "
                         "Clique sur « ⏻ Fermer l'ancien relais » en bas à droite.")
            self._relay_port_busy = True
            self._update_relay_ui()
            return False
        self._relay_port_busy = False
        srv.daemon_threads = True
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        self._relay_server = srv
        self._relay_stop = threading.Event()
        self._relay_dll_missing = False
        if IS_WIN:
            dll = find_simconnect_dll((self.cfg.get("simconnect_dir", ""),))
            if dll:
                threading.Thread(target=relay_simconnect_loop,
                                 args=(self.relay, dll, self._relay_stop, lambda: self.sim_on), daemon=True).start()
            else:
                self._relay_dll_missing = True
                self.log("Relais : SimConnect.dll introuvable. Le trafic IA est désactivé ; SimBrief et la météo "
                         "fonctionnent. Lance une fois installer.bat du relais pour l'ajouter.")
        if not quiet:
            self.log("Relais : démarré.")
        self._update_relay_ui()
        return True

    def relay_stop(self, reason=""):
        if not self._relay_server:
            return
        if self._relay_stop:
            self._relay_stop.set()
        srv, self._relay_server = self._relay_server, None

        def _close():
            try:
                srv.shutdown()
                srv.server_close()
            except Exception:  # noqa
                pass

        threading.Thread(target=_close, daemon=True).start()
        self.relay.set_connected(False)
        self.log("Relais : arrêté%s." % reason)
        self._update_relay_ui()

    def relay_toggle(self):
        if self._relay_server:
            self._relay_manual_off = True
            self.relay_stop(" (à ta demande)")
        elif self._relay_port_busy:
            self.kill_old_relay()
        else:
            self._relay_manual_off = False
            self.relay_start()

    def kill_old_relay(self):
        pid = pid_on_port(RELAY_PORT)
        if not pid or pid == os.getpid():
            if self.relay_start():
                return
            messagebox.showinfo(APP, "Impossible de trouver le programme qui occupe le port 8765.\n\n"
                                     "Ferme la fenêtre noire « Relais trafic IA » ou Relais_Trafic_IA.exe à la main.")
            return
        name = process_name(pid)
        if not messagebox.askyesno(APP, "Le port 8765 est occupé par « %s » (n° %d), sans doute l'ancien relais.\n\n"
                                        "Le fermer et démarrer le relais de Hangar FS 2024 ?" % (name, pid)):
            return
        try:
            subprocess.run(["taskkill", "/PID", str(pid), "/F"], capture_output=True, creationflags=NO_WINDOW,
                           timeout=10)
        except (OSError, subprocess.SubprocessError) as e:
            self.log("Relais : impossible de fermer l'ancien relais (%s)." % e)
            return
        self.log("Relais : ancien relais fermé (%s)." % name)
        self._relay_manual_off = False
        self.after(1200, self.relay_start)

    def _relay_text(self):
        r = getattr(self, "relay", None)
        if not r:
            return ""
        if not self._relay_server:
            return "Relais : port 8765 pris par l'ancien relais" if self._relay_port_busy else "Relais : arrêté"
        if not IS_WIN:
            return "Relais : actif (trafic IA sous Windows uniquement)"
        if self._relay_dll_missing:
            return "Relais : actif · trafic IA indisponible (SimConnect.dll)"
        if r.connected:
            n = r.count()
            return "Relais : MSFS connecté · %d avion%s IA" % (n, "s" if n > 1 else "")
        return "Relais : actif · en attente de MSFS"

    def _update_relay_ui(self):
        if not hasattr(self, "relay_btn"):
            return
        self.relay_label.config(text=self._relay_text())
        if self._relay_server:
            self.relay_btn.config(text="⏻  Arrêter le relais")
        elif self._relay_port_busy:
            self.relay_btn.config(text="⏻  Fermer l'ancien relais")
        else:
            self.relay_btn.config(text="⏻  Démarrer le relais")

    def _dispatch_html(self):
        html = dispatch_builtin_html()   # page Avionics Dispatch V2.40 intégrée
        m = re.search(r"<title>(.*?)</title>", html, re.S | re.I)
        self._dispatch_title = (m.group(1).strip() if m else "Avionics Dispatch")
        user = self.cfg.get("simbrief_user", "")
        # la page occupe toute la largeur de la fenêtre (le fichier d'origine limite le contenu à 1600 px)
        inject = "<style>.max-w-\\[1600px\\]{max-width:100%!important}</style>" + DISPATCH_LINKS_JS + DISPATCH_CLOSE_JS
        if not re.search(r'<link[^>]+rel=["\'](?:shortcut )?icon', html, re.I):
            inject += '<link rel="icon" type="image/png" href="/icon_dispatch.png">'
        if user:  # pré-remplit l'identifiant SimBrief de Hangar FS 2024 s'il n'y en a pas déjà un
            inject += ("<script>try{if(!localStorage.getItem('avd_simbrief_user'))"
                       "localStorage.setItem('avd_simbrief_user',%s)}catch(e){}</script>" % json.dumps(user))
        inject = T_page(inject)
        html = re.sub(r"(<head[^>]*>)", lambda mm: mm.group(1) + inject, html, count=1, flags=re.I)
        # le thème passe en dernier pour l'emporter sur les styles de la page
        i = html.lower().rfind("</head>")
        extra = T_page(DISPATCH_THEME + DISPATCH_LAYERS_JS + DISPATCH_FLIGHT_JS + DISPATCH_TRACK_JS + DISPATCH_PERF_JS + DISPATCH_FSHUB_JS + DISPATCH_AEROWAY_JS)
        if self.cfg.get("colorblind"):
            extra += DISPATCH_CB_JS
        html = html[:i] + extra + html[i:] if i >= 0 else html + extra
        return html

    def _maximize_dispatch_later(self, tries):
        """Edge peut ignorer la demande de plein écran : on agrandit la fenêtre dès qu'elle apparaît."""
        hwnd = find_window(self._dispatch_title, exact=True)
        if hwnd:
            mon = self.screen_for("dispatch")
            if mon and window_monitor_dev(hwnd) != mon["dev"]:
                move_window_to(hwnd, mon, maximize=True)
            maximize_window(hwnd)
        elif tries > 0:
            self.after(600, lambda: self._maximize_dispatch_later(tries - 1))

    def _refresh_startup_target(self):
        """Passage du .pyw au .exe (ou fichier déplacé) : le démarrage avec Windows lance le bon programme."""
        exe, args, _wd = launch_command()
        cur = "%s|%s" % (exe, args.strip())
        prev = self.cfg.get("launch_target")
        if prev == cur:
            return
        has_lnk = os.path.isfile(startup_shortcut())   # la tâche administrateur est gérée par _check_admin_startup
        if prev and has_lnk and self.cfg.get("launch_target_declined") != cur:
            # jamais de modification silencieuse du démarrage de Windows : on demande d'abord
            if not messagebox.askyesno(APP, "Hangar FS 2024 démarre depuis un nouvel emplacement :\n%s\n\n"
                                            "Mettre à jour le démarrage avec Windows pour lancer ce programme ?\n\n"
                                            "Non : rien n'est modifié (tu pourras le faire plus tard dans Réglages, "
                                            "en décochant puis recochant « Démarrer avec Windows »)." % exe):
                self.cfg["launch_target_declined"] = cur
                self.save_cfg()
                self.log("Démarrage avec Windows laissé tel quel (nouvel emplacement non retenu).")
                return
        self.cfg["launch_target"] = cur
        self.cfg.pop("launch_target_declined", None)
        self.save_cfg()
        if not prev:
            return
        if has_lnk:
            set_start_with_windows(True)
            self.log("Démarrage avec Windows mis à jour : %s" % os.path.basename(exe))

    def _migrate_startup(self):
        """Ancien nom « Addons Links » : remplace son raccourci de démarrage et sa tâche planifiée par les nouveaux."""
        if not IS_WIN:
            return
        self._refresh_startup_target()
        old_lnk = os.path.join(os.path.dirname(startup_shortcut()), OLD_STARTUP_LNK)
        if os.path.isfile(old_lnk):
            try:
                os.remove(old_lnk)
            except OSError:
                pass
            if not self.cfg.get("startup_admin"):
                set_start_with_windows(True)
                self.log("Démarrage avec Windows mis à jour pour le nouveau nom « %s »." % APP)
        try:
            r = subprocess.run(["schtasks", "/Query", "/TN", OLD_TASK_NAME], capture_output=True,
                               creationflags=NO_WINDOW, timeout=15)
            old_task = r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            old_task = False
        if not old_task:
            return
        os.makedirs(BASE_DIR, exist_ok=True)
        xml = os.path.join(BASE_DIR, "tache_hangar_fs2024.xml")
        with open(xml, "w", encoding="utf-16") as f:
            f.write(task_xml())
        if is_admin():
            schtasks_admin('/Delete /TN "%s" /F' % OLD_TASK_NAME)
            ok = schtasks_admin('/Create /TN "%s" /XML "%s" /F' % (TASK_NAME, xml))
        else:
            if not messagebox.askyesno(APP, "L'appli s'appelle maintenant « %s ».\n\nSon démarrage automatique en "
                                            "administrateur porte encore l'ancien nom « Addons Links » et lance "
                                            "l'ancien fichier.\n\nLe mettre à jour maintenant ? (une confirmation "
                                            "Windows)" % APP):
                return
            schtasks_admin('/Delete /TN "%s" /F' % OLD_TASK_NAME)
            ok = schtasks_admin('/Create /TN "%s" /XML "%s" /F' % (TASK_NAME, xml))
        self.cfg["startup_admin"] = True
        self.save_cfg()
        self.log("Démarrage en administrateur mis à jour pour « %s »%s." % (APP, "" if ok else " (à vérifier)"))

    # ---- écrans
    def screen_for(self, which):
        """Écran où ouvrir la fenêtre which ("main", "map", "dispatch"), ou None pour laisser Windows décider."""
        if not self.cfg.get("screen_" + which, True):
            return None
        return resolve_monitor(self.cfg.get("screen", "auto"))

    def _place_main(self):
        mon = self.screen_for("main")
        if not mon:
            return
        w, h = min(1320, mon["ww"] - 20), min(860, mon["wh"] - 40)
        x = mon["wx"] + (mon["ww"] - w) // 2
        y = mon["wy"] + max(0, (mon["wh"] - h) // 2 - 15)
        self.geometry("%dx%d+%d+%d" % (w, h, x, y))

    def _place_web_later(self, title, which, tries):
        hwnd = find_window(title, exact=True)
        if hwnd:
            mon = self.screen_for(which)
            if mon and window_monitor_dev(hwnd) != mon["dev"]:
                move_window_to(hwnd, mon)
        elif tries > 0:
            self.after(600, lambda: self._place_web_later(title, which, tries - 1))

    def _place_app_later(self, app, tries=45, moved=None):
        """Place les fenêtres d'une application lancée sur l'écran choisi (écran de démarrage puis fenêtre principale)."""
        choice = app.get("screen", "")
        if not choice or not IS_WIN:
            return
        moved = set() if moved is None else moved
        mon = resolve_monitor(choice)
        if not mon:
            return
        imgs = [x.lower() for x in split_procs(app.get("proc"))]
        if app.get("path", "").lower().endswith(".exe"):
            imgs.append(os.path.basename(app["path"]).lower())
        for hwnd in windows_of_images(imgs):
            if hwnd in moved:
                continue
            if window_monitor_dev(hwnd) == mon["dev"] or move_window_to(hwnd, mon):
                moved.add(hwnd)
                if len(moved) == 1:
                    self.log("Démarrage auto : %s affichée sur l'écran %d." % (app["name"], mon["num"]))
            elif not getattr(self, "_warned_move_" + app["id"], False):
                setattr(self, "_warned_move_" + app["id"], True)
                self.log("Démarrage auto : impossible de déplacer %s sur l'écran %d%s." % (
                    app["name"], mon["num"], " (elle tourne en administrateur : relance Hangar FS 2024 en administrateur "
                    "pour pouvoir la déplacer)" if not is_admin() else ""))
        if tries > 0:
            self.after(1000, lambda: self._place_app_later(app, tries - 1, moved))

    def identify_screens(self):
        mons = list_monitors()
        if not mons:
            messagebox.showinfo(APP, "Impossible de lire la liste des écrans.")
            return
        for m in mons:
            t = tk.Toplevel(self)
            t.overrideredirect(True)
