def schtasks_admin(args_text):
    """Exécute schtasks avec les droits administrateur (une confirmation UAC si l'appli n'est pas déjà admin)."""
    if is_admin():
        try:
            r = subprocess.run("schtasks.exe " + args_text, capture_output=True, creationflags=NO_WINDOW,
                               timeout=20)
            return r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
    return shell_runas("schtasks.exe", args_text, None, 0)


def task_query_xml():
    """XML de la tâche planifiée « Hangar FS 2024 » ("" si pas de tâche)."""
    if not IS_WIN:
        return ""
    try:
        r = subprocess.run(["schtasks", "/Query", "/TN", TASK_NAME, "/XML"], capture_output=True,
                           creationflags=NO_WINDOW, timeout=15)
        if r.returncode != 0:
            return ""
        for enc in ("utf-16", "utf-8", CON_ENC):
            try:
                text = r.stdout.decode(enc)
                if "<Task" in text:
                    return text
            except (UnicodeDecodeError, LookupError):
                continue
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def task_has_logon_trigger():
    return "<LogonTrigger" in task_query_xml()


def task_command():
    """Programme lancé par la tâche planifiée « Hangar FS 2024 » ("" si pas de tâche)."""
    if not IS_WIN:
        return ""
    try:
        r = subprocess.run(["schtasks", "/Query", "/TN", TASK_NAME, "/XML"], capture_output=True,
                           creationflags=NO_WINDOW, timeout=15)
        if r.returncode != 0:
            return ""
        raw = r.stdout
        for enc in ("utf-16", "utf-8", CON_ENC):
            try:
                text = raw.decode(enc)
                if "<Command>" in text:
                    break
            except (UnicodeDecodeError, LookupError):
                continue
        else:
            return ""
        m = re.search(r"<Command>(.*?)</Command>", text, re.S)
        import html as _html
        return _html.unescape(m.group(1)).strip().strip('"') if m else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def same_program(a, b):
    try:
        return os.path.normcase(os.path.abspath(a)) == os.path.normcase(os.path.abspath(b))
    except (TypeError, ValueError):
        return False


def early_elevate():
    """Ouverte d'un double-clic alors que « En mode administrateur » est coché : on se relance tout de suite
    par la tâche planifiée (droits administrateur, sans confirmation Windows) et cette fenêtre s'arrête."""
    if not IS_WIN or RELAUNCHED or is_admin() or "--no-elevate" in sys.argv:
        return False
    cfg = load_json(CONFIG_FILE, {})
    if not cfg.get("startup_admin"):
        return False
    cmd = task_command()
    exe, _args, _wd = launch_command()
    if not cmd or not same_program(cmd, exe):
        return False      # tâche absente ou ancienne : l'appli la remettra à jour une fois ouverte
    try:
        write_relaunch_flag(True, show=not START_MINIMIZED)
        r = subprocess.run(["schtasks", "/Run", "/TN", TASK_NAME], capture_output=True, creationflags=NO_WINDOW,
                           timeout=15)
        if r.returncode != 0:
            raise OSError("schtasks")
        # la nouvelle fenêtre efface le drapeau dès qu'elle démarre ; sinon (bloquée…), on continue ici
        for _ in range(40):
            if not os.path.exists(_flag):
                return True
            time.sleep(0.25)
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        os.remove(_flag)
    except OSError:
        pass
    return False


def elevated_taskkill(procs, force):
    """Ferme des programmes lancés en administrateur, depuis Hangar FS 2024 en mode normal : taskkill.exe est
    lancé directement avec les droits (une confirmation Windows), sans passer par cmd. Fermeture polie d'abord ;
    si un programme résiste, une fermeture forcée est demandée (seulement dans ce cas)."""
    ims = " ".join('/IM "%s"' % x for x in procs)

    def running():
        imgs = running_images()
        return any(x.lower() in imgs for x in procs)
    if not shell_runas("taskkill.exe", "%s /T%s" % (ims, " /F" if force else ""), None, 0):
        return "non fermée (confirmation Windows refusée)"
    for _ in range(16):
        time.sleep(0.5)
        if not running():
            return "fermée"
    if force:
        return "fermeture demandée"
    if not shell_runas("taskkill.exe", "%s /T /F" % ims, None, 0):
        return "non fermée (confirmation Windows refusée)"
    for _ in range(10):
        time.sleep(0.5)
        if not running():
            return "fermée de force (ne répondait pas)"
    return "fermeture demandée"


def create_admin_task():
    os.makedirs(BASE_DIR, exist_ok=True)
    path = os.path.join(BASE_DIR, "tache_hangar_fs2024.xml")
    with open(path, "w", encoding="utf-16") as f:
        f.write(task_xml())
    if not schtasks_admin('/Create /TN "%s" /XML "%s" /F' % (TASK_NAME, path)):
        return False
    for _ in range(20):
        if task_exists():
            return True
        time.sleep(0.5)
    return False


def delete_admin_task():
    if not task_exists():
        return True
    if not schtasks_admin('/Delete /TN "%s" /F' % TASK_NAME):
        return False
    for _ in range(20):
        if not task_exists():
            return True
        time.sleep(0.5)
    return False


