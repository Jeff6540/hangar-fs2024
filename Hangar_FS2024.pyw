_PH = re.compile(r"%(?:\.\d+)?[sdf]")
EN, _EN_RX = {}, []
for _fr, _en in EN_PAIRS:
    if _PH.search(_fr):
        _lit = _PH.sub("", _fr)
        if sum(c.isalpha() for c in _lit) < 4:
            continue
        _rx = "".join(("(-?\\d+)" if p.endswith("d") else "(-?[\\d.,]+)" if p.endswith("f") else "(.*?)")
                      if _PH.fullmatch(p) else re.escape(p) for p in re.split(r"(%(?:\.\d+)?[sdf])", _fr))
        _EN_RX.append((re.compile("^" + _rx + "$", re.S), _en))
    else:
        EN[_fr] = _en
_EN_RX.sort(key=lambda r: -len(r[0].pattern))


def T(s):
    """Texte traduit dans la langue choisie (le français est renvoyé tel quel)."""
    if LANG != "en" or not isinstance(s, str) or not s.strip():
        return s
    r = EN.get(s)
    if r is not None:
        return r
    core = s.strip()
    if core != s and core in EN:
        return s.replace(core, EN[core], 1)
    for rx, en in _EN_RX:
        m = rx.match(s)
        if m:
            vals = iter(T(g) for g in m.groups())
            return re.sub(r"%(?:\.\d+)?[sdf_]", lambda _m: "" if _m.group().endswith("_") and next(vals, "") is not None
                          else next(vals, ""), en)
    paras = s.split("\n\n")
    for k in range(len(paras) - 1, 0, -1):  # message suivi de paragraphes ajoutés : on traduit par morceaux
        head = "\n\n".join(paras[:k])
        th = T(head)
        if th != head:
            return th + "\n\n" + T("\n\n".join(paras[k:]))
    if "\n" in s:
        return "\n".join(T(part) for part in s.split("\n"))
    return s


def T_page(html):
    """Pages web servies (carte, suivi du vol, FSHub) : remplacement des textes français connus."""
    if LANG != "en":
        return html
    for fr, en in WEB_PAIRS:
        html = html.replace(fr, en)
    return html


def install_i18n():
    """En anglais : traduit les textes des fenêtres Tk au moment où ils sont affichés."""
    if LANG != "en":
        return

    def tr_opts(d):
        if not isinstance(d, dict):
            return d
        d = dict(d)
        for k in ("text", "label", "title"):
            if isinstance(d.get(k), str):
                d[k] = T(d[k])
        return d

    orig_options = tk.Misc._options

    def _options(self, cnf, kw=None):
        return orig_options(self, tr_opts(cnf), tr_opts(kw))
    tk.Misc._options = _options

    orig_fmt = ttk._format_optdict

    def _format_optdict(optdict, script=False, ignore=None):
        if isinstance(optdict, dict):
            optdict = tr_opts(optdict)
            vals = optdict.get("values")
            if isinstance(vals, (list, tuple)):
                optdict["values"] = tuple(T(v) if isinstance(v, str) else v for v in vals)
        return orig_fmt(optdict, script, ignore)
    ttk._format_optdict = _format_optdict

    orig_set = ttk.Treeview.set

    def tv_set(self, item, column=None, value=None):
        if isinstance(value, str):
            value = EN.get(value, T(value))
        return orig_set(self, item, column, value)
    ttk.Treeview.set = tv_set

    orig_title = tk.Wm.wm_title

    def wm_title(self, string=None):
        return orig_title(self, T(string) if isinstance(string, str) else string)
    tk.Wm.wm_title = tk.Wm.title = wm_title

    def wrap_box(fn):
        def inner(title=None, message=None, **kw):
            return fn(T(title), T(message), **kw)
        return inner
    for name in ("showinfo", "showwarning", "showerror", "askyesno", "askokcancel", "askyesnocancel",
                 "askquestion", "askretrycancel"):
        if hasattr(messagebox, name):
            setattr(messagebox, name, wrap_box(getattr(messagebox, name)))

    def wrap_dialog(fn):
        def inner(*a, **kw):
            if "title" in kw:
                kw["title"] = T(kw["title"])
            if "filetypes" in kw:
                kw["filetypes"] = [(T(d), p) for d, p in kw["filetypes"]]
            return fn(*a, **kw)
        return inner
    for name in ("askopenfilename", "askdirectory", "asksaveasfilename"):
        setattr(filedialog, name, wrap_dialog(getattr(filedialog, name)))

    orig_ask = simpledialog.askstring

    def askstring(title, prompt, **kw):
        return orig_ask(T(title), T(prompt), **kw)
    simpledialog.askstring = askstring

