    '#alPlanToast button.go{background:#2563eb;color:#fff;border:0;padding:2px 8px;margin-left:4px}' +
    '#alPlanToast button.x{background:none;border:0;color:#97a3b6;margin-left:8px;padding:0 2px}';
  document.head.appendChild(css);

  function tick() {
    var m = map(), modal = document.getElementById('trafficMapModal');
    if (!m || !modal || modal.classList.contains('hidden')) return;
    if (!line) draw();
    if (!autoSched) { autoSched = true; setTimeout(autoPlan, 1500); }   /* laisse la page finir son propre import éventuel */
  }
  function start() { poll(); setInterval(poll, 5000); setInterval(tick, 1000); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>"""


# Performances SimBrief (décollage / atterrissage) et vent sur les pistes (METAR en direct)
DISPATCH_PERF_JS = r"""<script>
/* Hangar FS 2024 : performances SimBrief (décollage / atterrissage) et vent sur les pistes d'après la METAR en direct,
   dans l'encadré du plan (ou un petit encadré à part sans plan SimBrief). Compact : seulement la phase utile. */
(function () {
  var RELAY = 'http://localhost:8765', KEY_OPEN = 'al_perf_open', KEY_XW = 'al_xwind_max', SB_URL = 'https://dispatch.simbrief.com/briefing/latest';
  var metars = {}, box = null, solo = null, lastHtml = '';
  function esc(t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function ls(k, v) { try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) { return null; } }
  function num(v) { var n = parseFloat(v); return Number.isFinite(n) ? n : null; }
  function ft(n) { return Math.round(n).toLocaleString('fr-FR').replace(/ | /g, ' ') + ' ft'; }
  function nmDist(a, b, c, d) {
    var r = Math.PI / 180, x = Math.sin((c - a) * r / 2), y = Math.sin((d - b) * r / 2);
    var h = x * x + Math.cos(a * r) * Math.cos(c * r) * y * y; return 3440.065 * 2 * Math.asin(Math.min(1, Math.sqrt(h)));
  }
  function isOpen() { return ls(KEY_OPEN) === '1'; }
  function xwMax() { var n = parseInt(ls(KEY_XW), 10); return n > 0 && n < 60 ? n : 15; }

  /* ---------- METAR ---------- */
  function getMetar(icao) {
    if (!icao) return null;
    var m = metars[icao], now = Date.now();
    if (!m || (now - m.t > 60000 && !m.busy)) {
      m = metars[icao] = m || { t: 0, raw: '' };
      m.busy = true; m.t = now;
      fetch(RELAY + '/metar?icao=' + encodeURIComponent(icao), { cache: 'no-store' }).then(function (r) { return r.json(); })
        .then(function (d) { m.raw = (d && d.metar) || ''; m.busy = false; m.done = true; m.t = Date.now(); render(); })
        .catch(function () { m.busy = false; m.done = true; render(); });
    }
    return m.raw ? parseMetar(m.raw) : null;
  }
  function parseMetar(raw) {
    var o = { raw: raw }, w = raw.match(/\b(VRB|\d{3})(\d{2,3})(?:G(\d{2,3}))?(KT|MPS)\b/);
    if (w) {
      var k = w[4] === 'MPS' ? 1.944 : 1;
      o.vrb = w[1] === 'VRB'; o.dir = o.vrb ? null : parseInt(w[1], 10);
      o.spd = Math.round(parseInt(w[2], 10) * k); o.gust = w[3] ? Math.round(parseInt(w[3], 10) * k) : 0;
    }
    var t = raw.match(/\s(M?\d{2})\/(M?\d{2})?\s/);
    if (t) o.temp = parseInt(t[1].replace('M', '-'), 10);
    var q = raw.match(/\bQ(\d{4})\b/), a = raw.match(/\bA(\d{4})\b/);
    if (q) o.qnh = parseInt(q[1], 10); else if (a) o.qnh = Math.round(parseInt(a[1], 10) / 100 * 33.8639);
    var tm = raw.match(/\b\d{2}(\d{2})(\d{2})Z\b/); if (tm) o.time = tm[1] + ':' + tm[2];
    o.wet = raw.split(/\s+/).some(function (g) { return /^[-+]?(TS|SH|FZ)?(RA|DZ|SN|SG|PL|GR|GS|UP)+$/.test(g) || /^[-+]?(TS|SH|FZ)(RA|DZ|SN|SG|PL|GR|GS)/.test(g); });
    return o;
  }
  function comps(rwyTrue, mt) {   /* vent / piste (caps vrais) */
    if (!mt || mt.spd == null || mt.vrb || rwyTrue == null) return null;
    var a = (mt.dir - rwyTrue) * Math.PI / 180;
    return { head: Math.round(mt.spd * Math.cos(a)), cross: Math.round(Math.abs(mt.spd * Math.sin(a))),
             gcross: mt.gust ? Math.round(Math.abs(mt.gust * Math.sin(a))) : 0, gust: mt.gust ? mt.gust - mt.spd : 0 };
  }
  function densityAlt(elev, mt) {
    if (elev == null || !mt || mt.temp == null) return null;
    var pa = elev + (mt.qnh ? (1013.25 - mt.qnh) * 30 : 0), isa = 15 - 1.98 * pa / 1000;
    return Math.round((pa + 118.8 * (mt.temp - isa)) / 10) * 10;
  }

  /* ---------- pistes d'un aéroport (OurAirports) ---------- */
  function runwaysOf(icao) {
    var list = [];
    try { list = (typeof getAirportRunways === 'function') ? getAirportRunways(icao) : []; } catch (e) { list = []; }
    var seen = {};
    return list.filter(function (r) { return /^\d{2}[LCR]?$/.test(r.name); }).map(function (r) {
      var h = Number.isFinite(r.hdg) ? r.hdg : parseInt(r.name, 10) * 10;
      return { name: r.name, hdg: h, len: r.length_ft };
    }).filter(function (r) { if (seen[r.name]) return false; seen[r.name] = 1; return true; });
  }
  function aptOf(icao) { try { return (typeof airportsDB !== 'undefined' && airportsDB[icao]) || null; } catch (e) { return null; } }
  function nearestApt(lat, lon) {
    var best = null, bd = 30;
    try {
      for (var k in airportsDB) {
        var a = airportsDB[k];
        if (!a || a.type === 'heliport' || a.type === 'seaplane_base' || a.type === 'balloonport') continue;
        if (Math.abs(a.lat - lat) > 0.6) continue;
        var d = nmDist(lat, lon, a.lat, a.lon);
        if (d < bd && runwaysOf(k).length) { bd = d; best = k; }
