def fmt_size(n):
    for unit, div in (("To", 1e12), ("Go", 1e9), ("Mo", 1e6)):
        if n >= div:
            return ("%.2f %s" % (n / div, unit)).replace(".", ",")
    return ("%.0f Ko" % (n / 1e3)).replace(".", ",")


def folder_size(paths):
    total = 0
    for top in paths:
        if not os.path.exists(top):
            continue
        for root, _dirs, files in os.walk(top):
            for fn in files:
                try:
                    total += os.stat(os.path.join(root, fn)).st_size
                except OSError:
                    pass
    return total


LAYOUT_EXCLUDE = {"layout.json", "manifest.json", "layout.json.bak", "manifest.json.bak",
                  "msfslayoutgenerator.exe"}


def layout_files(pkg):
    """Fichiers qui doivent figurer dans layout.json : (chemin relatif, taille, date FILETIME)."""
    out = []
    for root, dirs, files in os.walk(pkg):
        dirs.sort()
        for fn in sorted(files):
            full = os.path.join(root, fn)
            rel = os.path.relpath(full, pkg).replace(os.sep, "/")
            if rel.lower() in LAYOUT_EXCLUDE or rel.startswith("_CVT_"):
                continue
            try:
                st = os.stat(full)
            except OSError:
                continue
            out.append((rel, st.st_size, int(st.st_mtime * 10000000) + 116444736000000000))
    return out


def regenerate_layout(pkg):
    files = layout_files(pkg)
    total = sum(sz for _p, sz, _d in files)
    layout = os.path.join(pkg, "layout.json")
    manifest = os.path.join(pkg, "manifest.json")
    if os.path.isfile(layout):
        shutil.copy2(layout, layout + ".bak")
    with open(layout, "w", encoding="utf-8", newline="\n") as f:
        json.dump({"content": [{"path": p, "size": sz, "date": d} for p, sz, d in files]}, f, indent=2,
                  ensure_ascii=False)
    try:
        with open(manifest, "r", encoding="utf-8-sig") as f:
            m = json.load(f)
    except (OSError, ValueError):
        m = None
    if isinstance(m, dict):
        shutil.copy2(manifest, manifest + ".bak")
        m["total_package_size"] = str(total).zfill(20)
        with open(manifest, "w", encoding="utf-8", newline="\n") as f:
            json.dump(m, f, indent=2, ensure_ascii=False)
    return len(files), total


def packages_paths():
    """Dossiers de paquets indiqués par UserCfg.opt (InstalledPackagesPath)."""
    local = os.environ.get("LOCALAPPDATA", "")
    roaming = os.environ.get("APPDATA", "")
    out = []
    for opt in (os.path.join(local, "Packages", "Microsoft.Limitless_8wekyb3d8bbwe", "LocalCache", "UserCfg.opt"),
                os.path.join(roaming, "Microsoft Flight Simulator 2024", "UserCfg.opt")):
        try:
            with open(opt, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("InstalledPackagesPath"):
                        parts = line.split(None, 1)
                        if len(parts) == 2:
                            out.append(parts[1].strip().strip('"'))
        except OSError:
