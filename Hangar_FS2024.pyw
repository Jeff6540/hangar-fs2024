  }
  function takeoffInfo(pd) {
    var t = pd && pd.tlr && pd.tlr.takeoff; if (!t || !t.conditions) return null;
    var cd = t.conditions, r = tlrRunway(t.runway, cd.planned_runway || (pd.origin || {}).plan_rwy); if (!r) return null;
    var icao = (cd.airport_icao || (pd.origin || {}).icao_code || '').toUpperCase(), mt = getMetar(icao);
    var flex = num(r.flex_temperature), th = String(r.thrust_setting || '');
