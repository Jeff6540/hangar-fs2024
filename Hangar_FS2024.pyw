def find_window(prefix, exact=False):
    """Fenêtre Windows visible dont le titre commence par prefix, ou vaut exactement prefix si exact (ou None)."""
    if not IS_WIN:
        return None
    try:
        import ctypes
        from ctypes import wintypes
        user32 = ctypes.windll.user32
        found = []

        @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
        def cb(hwnd, _lp):
            if user32.IsWindowVisible(hwnd):
                n = user32.GetWindowTextLengthW(hwnd)
                if n:
                    buf = ctypes.create_unicode_buffer(n + 1)
                    user32.GetWindowTextW(hwnd, buf, n + 1)
                    if (buf.value == prefix) if exact else buf.value.startswith(prefix):
                        found.append(hwnd)
                        return False
            return True

        user32.EnumWindows(cb, 0)
        return found[0] if found else None
    except Exception:  # noqa
        return None


# --------------------------------------------------------------------------- écrans
def list_monitors():
    """Écrans branchés : principal d'abord, puis de gauche à droite. Coordonnées Windows (zone de travail incluse)."""
    if not IS_WIN:
        return []
    try:
        from ctypes import wintypes
        user32 = ctypes.windll.user32

        class MONITORINFOEXW(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT), ("rcWork", wintypes.RECT),
                        ("dwFlags", wintypes.DWORD), ("szDevice", wintypes.WCHAR * 32)]

        out = []
        proto = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HMONITOR, wintypes.HDC, ctypes.POINTER(wintypes.RECT),
                                   wintypes.LPARAM)

        def cb(hmon, _hdc, _rc, _lp):
            mi = MONITORINFOEXW()
            mi.cbSize = ctypes.sizeof(mi)
            if user32.GetMonitorInfoW(hmon, ctypes.byref(mi)):
                r, w = mi.rcMonitor, mi.rcWork
                out.append({"dev": mi.szDevice, "x": r.left, "y": r.top, "w": r.right - r.left, "h": r.bottom - r.top,
                            "wx": w.left, "wy": w.top, "ww": w.right - w.left, "wh": w.bottom - w.top,
                            "primary": bool(mi.dwFlags & 1)})
            return True

        fn = proto(cb)
        user32.EnumDisplayMonitors(None, None, fn, 0)
        out.sort(key=lambda m: (not m["primary"], m["x"], m["y"]))
        for i, m in enumerate(out):
            m["num"] = i + 1
        return out
    except Exception:  # noqa
        return []


def monitor_label(m):
    return "Écran %d%s · %d × %d" % (m["num"], " — principal" if m["primary"] else "", m["w"], m["h"])


def resolve_monitor(choice):
    """Écran correspondant au réglage : "auto" = premier écran secondaire, sinon le principal.
    Un écran choisi mais débranché retombe sur le principal. None si un seul écran ou rien à faire."""
    mons = list_monitors()
    if not mons or not choice:
        return None
    if choice == "auto":
        return next((m for m in mons if not m["primary"]), mons[0])
    return next((m for m in mons if m["dev"] == choice), mons[0])


def window_monitor_dev(hwnd):
    try:
        from ctypes import wintypes
        user32 = ctypes.windll.user32

        class MONITORINFOEXW(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("rcMonitor", wintypes.RECT), ("rcWork", wintypes.RECT),
                        ("dwFlags", wintypes.DWORD), ("szDevice", wintypes.WCHAR * 32)]
        user32.MonitorFromWindow.restype = wintypes.HMONITOR
        hmon = user32.MonitorFromWindow(wintypes.HWND(hwnd), 2)  # MONITOR_DEFAULTTONEAREST
        mi = MONITORINFOEXW()
        mi.cbSize = ctypes.sizeof(mi)
        if hmon and user32.GetMonitorInfoW(hmon, ctypes.byref(mi)):
            return mi.szDevice
    except Exception:  # noqa
        pass
    return None


def move_window_to(hwnd, mon, maximize=False):
    """Centre la fenêtre sur l'écran (sans dépasser sa zone de travail), puis l'agrandit si demandé."""
    try:
        from ctypes import wintypes
        user32 = ctypes.windll.user32
        h = wintypes.HWND(hwnd)
        if user32.IsZoomed(h) or user32.IsIconic(h):
            user32.ShowWindow(h, 9)  # SW_RESTORE
        rc = wintypes.RECT()
        user32.GetWindowRect(h, ctypes.byref(rc))
        w = max(200, min(rc.right - rc.left, mon["ww"]))
        ht = max(150, min(rc.bottom - rc.top, mon["wh"]))
        x = mon["wx"] + (mon["ww"] - w) // 2
        y = mon["wy"] + (mon["wh"] - ht) // 2
        ok = user32.SetWindowPos(h, None, x, y, w, ht, 0x0004 | 0x0010)  # SWP_NOZORDER | SWP_NOACTIVATE
        if ok and maximize:
            user32.ShowWindow(h, 3)  # SW_MAXIMIZE
        return bool(ok) and window_monitor_dev(hwnd) == mon["dev"]
    except Exception:  # noqa
        return False


def windows_of_images(images):
    """Fenêtres principales visibles des programmes dont le nom (ex. « weathercreator.exe ») est dans images."""
    if not IS_WIN or not images:
        return []
    try:
        from ctypes import wintypes
        user32, k32 = ctypes.windll.user32, ctypes.windll.kernel32
        k32.OpenProcess.restype = wintypes.HANDLE
        wanted = {i.lower() for i in images}
        names, found = {}, []

        def image_of(pid):
            if pid in names:
                return names[pid]
            name = ""
            hp = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
            if hp:
                buf = ctypes.create_unicode_buffer(1024)
                size = wintypes.DWORD(1024)
                if k32.QueryFullProcessImageNameW(hp, 0, buf, ctypes.byref(size)):
                    name = os.path.basename(buf.value).lower()
                k32.CloseHandle(hp)
            names[pid] = name
            return name

        @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
        def cb(hwnd, _lp):
            if not user32.IsWindowVisible(hwnd) or user32.GetWindow(hwnd, 4):  # GW_OWNER : fenêtre secondaire
                return True
            if user32.GetWindowLongW(hwnd, -20) & 0x80:  # WS_EX_TOOLWINDOW
                return True
            rc = wintypes.RECT()
            user32.GetWindowRect(hwnd, ctypes.byref(rc))
            if rc.right - rc.left < 200 or rc.bottom - rc.top < 120:
                return True
            pid = wintypes.DWORD()
            user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
            if image_of(pid.value) in wanted:
                found.append(hwnd)
            return True

        user32.EnumWindows(cb, 0)
        return found
    except Exception:  # noqa
        return []


def close_window(hwnd):
    try:
        import ctypes
        ctypes.windll.user32.PostMessageW(hwnd, 0x0010, 0, 0)  # WM_CLOSE
        return True
    except Exception:  # noqa
        return False


def maximize_window(hwnd):
    try:
        import ctypes
        user32 = ctypes.windll.user32
        user32.ShowWindow(hwnd, 3)  # SW_MAXIMIZE
        user32.SetForegroundWindow(hwnd)
        return True
    except Exception:  # noqa
        return False


def focus_window(hwnd):
    try:
        import ctypes
        user32 = ctypes.windll.user32
        if user32.IsIconic(hwnd):
            user32.ShowWindow(hwnd, 9)  # SW_RESTORE
        else:
            user32.ShowWindow(hwnd, 5)  # SW_SHOW
        user32.SetForegroundWindow(hwnd)
        return True
    except Exception:  # noqa
        return False


def open_app_window(url, maximized=False, monitor=None):
    """Ouvre l'URL dans une fenêtre d'application (Edge ou Chrome sans barre d'adresse)."""
    if IS_WIN:
        bases = [os.environ.get("ProgramFiles(x86)", ""), os.environ.get("ProgramFiles", ""),
                 os.environ.get("LOCALAPPDATA", "")]
        exes = [os.path.join(b, "Microsoft", "Edge", "Application", "msedge.exe") for b in bases if b]
        exes += [os.path.join(b, "Google", "Chrome", "Application", "chrome.exe") for b in bases if b]
        for exe in exes:
            if os.path.isfile(exe):
                try:
                    size = ["--start-maximized"] if maximized else ["--window-size=1400,900"]
                    if monitor:  # ouvre directement sur l'écran choisi
                        size.append("--window-position=%d,%d" % (monitor["wx"] + 40, monitor["wy"] + 40))
                    subprocess.Popen([exe, "--app=" + url] + size + [
                                      "--user-data-dir=" + os.path.join(BASE_DIR, "fenetre-carte"),
                                      "--no-first-run", "--no-default-browser-check"],
                                     creationflags=NO_WINDOW)
                    return True
                except OSError:
                    continue
    webbrowser.open(url)
    return False


