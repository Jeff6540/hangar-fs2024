    var c = comps(num(r.true_course), mt), vref = num(dist.speeds_vref), add = 5;
    if (c) add = Math.max(5, Math.min(20, Math.round(Math.max(0, c.head) / 2 + c.gust)));
    var lda = num(r.length_lda) || num(r.length), fac = num(dist.factored_distance);
    return { icao: icao, rwy: r.identifier, lda: lda, wet: wet, rain: mt && mt.wet, flaps: cd.flap_setting || dist.flap_setting,
      brakes: dist.brake_setting, vref: vref, vapp: vref ? vref + add : null, add: add, act: num(dist.actual_distance), fac: fac,
      margin: lda && fac ? lda - fac : null, mt: mt, c: c, ils: String(r.ils_frequency || '').trim(), crs: num(r.magnetic_course), elev: num(r.elevation) != null ? num(r.elevation) : num((pd.destination || {}).elevation) };
  }
  function gsKey(icao, rwy) { return 'al_gs_' + icao + '_' + String(rwy).replace(/^0+(?=\d)/, ''); }

