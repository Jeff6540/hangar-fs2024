    def _make_checkbox(self, state):
        """off : vide · on/part : sélection (bleu) · act/actpart : dans Community (vert)
        · act_on : dans Community ET sélectionné (bleu bordé de vert)."""
        cb = bool(self.cfg.get("colorblind"))   # daltoniens : « dans Community » en orange, sélection en bleu
        green, blue = ("#E69F00" if cb else "#16a34a"), C["accent"]
        border = {"off": C["muted"], "act": green, "actpart": green,
                  "act_on": "#ffc04d" if cb else "#4ade80"}.get(state, blue)
        fill = {"off": C["field"], "act": green, "actpart": green}.get(state, blue)
        img = tk.PhotoImage(width=18, height=16)
        img.put(border, to=(2, 1, 16, 15))
        if state == "act_on":
            img.put(border, to=(3, 2, 15, 14))
            img.put(fill, to=(4, 3, 14, 13))
        else:
            img.put(fill, to=(3, 2, 15, 14))
        ink = "#1b1f26" if cb and state in ("act", "actpart") else "#ffffff"
        if state in ("on", "act", "act_on"):
            for x, y in ((5, 8), (6, 9), (7, 10), (8, 9), (9, 8), (10, 7), (11, 6), (12, 5)):
                img.put(ink, to=(x, y, x + 1, y + 2))
        elif state in ("part", "actpart"):
            img.put(ink, to=(5, 7, 13, 9))
        return img

